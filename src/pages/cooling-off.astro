---
import ToolLayout from "../layouts/ToolLayout.astro";
import DayCountFigure from "../components/DayCountFigure.astro";
import { REFS } from "../lib/site.js";

const sources = [REFS.tokushoHo, REFS.caaCoolingOff, REFS.kokusen];

const faqs = [
  {
    q: "クーリングオフの「8日間」はいつから数えますか？",
    a: "申込書面または契約書面（法定の記載事項を満たしたもの）を受け取った日を1日目として数えます。たとえば7月1日に書面を受け取った訪問販売なら、期限は7月8日です。初日を含めて数える点に注意してください。",
  },
  {
    q: "期限の最終日に通知を出しても間に合いますか？",
    a: "はがき等の書面で通知する場合は、期間内に発信すれば有効（発信主義）とされています。最終日の消印が期間内であれば効力が生じます。証拠を残すため、はがきの両面をコピーし、特定記録郵便や簡易書留で送るのが一般的なやり方です。2022年6月からは電子メール等の電磁的記録による通知も可能になりました。",
  },
  {
    q: "書面を受け取っていない・記載に不備がある場合は？",
    a: "法定の記載事項を満たした書面が交付されていない場合、クーリングオフ期間は進行しないと解されており、8日（20日）を過ぎていても行使できる可能性があります。あきらめる前に消費生活センター（電話番号188）に相談してください。",
  },
  {
    q: "ネット通販で買ったものはクーリングオフできますか？",
    a: "通信販売にはクーリングオフ制度はありません。代わりに、事業者が定める返品特約に従います。返品特約の表示がない場合は、商品到着から8日以内であれば送料自己負担で返品（契約解除）できるとされています。",
  },
  {
    q: "自分からお店に行って買ったものはクーリングオフできますか？",
    a: "できません。クーリングオフは、訪問販売や電話勧誘のように不意打ち的な勧誘から消費者を守る制度です。自分の意思で店舗に出向いて購入した場合は対象外で、返品できるかどうかはお店の返品規定によります。",
  },
  {
    q: "クーリングオフすると違約金や送料はかかりますか？",
    a: "かかりません。クーリングオフは無条件解約で、違約金や損害賠償を請求されることはなく、支払済みの代金は全額返金されます。商品の引き取り費用も事業者の負担です。工事などが行われた場合は、無償で元に戻すよう請求できます。",
  },
  {
    q: "8日目が土曜日や日曜日、祝日のときは期限が延びますか？",
    a: "一般には延びないと考えられています。クーリングオフの通知は郵便やメールで発信すれば足り、相手の営業日に左右されないためです。8日目が休日に当たる場合でも、その日までに投函するか、それより前の平日に出しておくのが安全です。",
  },
  {
    q: "電話や口頭で「やめます」と伝えるだけでも有効ですか？",
    a: "法律上は書面または電磁的記録（メールなど）で通知することとされています。口頭だけでは、あとで「聞いていない」と言われたときに証明できません。電話で伝えた場合でも、必ず同じ日のうちにはがきかメールで通知を出し、控えを残してください。",
  },
];

const keyPoints = [
  "期限は書面を<strong>受け取った日を1日目</strong>として8日間（マルチ商法などは20日間）",
  "期間内に<strong>発信（消印）</strong>すれば有効。事業者に届くのが期限後でもよい",
  "期限を過ぎていても行使できる場合がある。迷ったら消費者ホットライン<strong>188</strong>へ",
];

const related = [
  { href: "/eigyobi/", label: "営業日計算 — 手続きの期日確認に" },
  { href: "/column/cooling-off-kigen/", label: "コラム: クーリングオフの期限の数え方 — 8日目が日曜日でも延びない？" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」日数の数え方の基本" },
];
---

<ToolLayout
  title="クーリングオフ期限計算 — 8日間はいつまで？受領日から自動計算"
  description="クーリングオフの期限日を、契約書面の受領日と取引の種類（訪問販売・電話勧誘・マルチ商法など）から自動計算。初日を含める数え方や、はがきの出し方・消印有効の扱いも解説します。"
  h1="クーリングオフ期限の計算"
  lead="申込書面・契約書面を受け取った日と取引の種類を選ぶと、クーリングオフができる期限日を計算します。"
  keyPoints={keyPoints}
  faqs={faqs}
  related={related}
  published="2026-07-05"
  updated="2026-09-06"
  sources={sources}
>
  <div class="calc" slot="calc">
    <div class="row">
      <div>
        <label for="receipt-date">書面を受け取った日</label>
        <input type="date" id="receipt-date" />
      </div>
      <div>
        <label for="deal-type">取引の種類</label>
        <select id="deal-type">
          <option value="8">訪問販売（8日間）</option>
          <option value="8">電話勧誘販売（8日間）</option>
          <option value="8">特定継続的役務提供・エステや塾など（8日間）</option>
          <option value="8">訪問購入・出張買取など（8日間）</option>
          <option value="20">連鎖販売取引・マルチ商法（20日間）</option>
          <option value="20">業務提供誘引販売取引・内職商法など（20日間）</option>
        </select>
      </div>
      <button type="button" class="btn" id="calc-btn">計算する</button>
    </div>
    <div id="result" aria-live="polite"></div>
  </div>

  <Fragment slot="explain">
    <div class="note-box">
      本ページは一般的な制度の紹介であり、法的助言ではありません。個別のケースでクーリングオフできるかどうかの判断は、<strong>消費者ホットライン「188（いやや）」</strong>で最寄りの消費生活センターに相談してください。
    </div>
    <h2>使い方</h2>
    <ol class="calc-steps">
      <li><strong>書面を受け取った日</strong>を入力します。契約した日ではなく、申込書面・契約書面を<strong>手渡された日</strong>です。契約日と受領日が違う場合は受領日を入れてください。</li>
      <li><strong>取引の種類</strong>を選びます。迷う場合は下の一覧表を参考にしてください。</li>
      <li>「計算する」を押すと、期限日（その日の消印まで有効な最終日）が表示されます。期限を過ぎていても、書面に不備がある場合などは行使できることがあります（結果欄にもその旨を表示します）。</li>
    </ol>
    <h2>クーリングオフの数え方 — 初日を含めます</h2>
    <p>
      クーリングオフの期間は、特定商取引法（訪問販売については第9条）に基づき、法定の記載事項を満たした申込書面または契約書面を<strong>受け取った日を1日目</strong>として数えます。日数の計算では多くの場面で「初日不算入」が原則ですが、クーリングオフは<strong>初日算入</strong>である点が間違えやすいポイントです。
    </p>
    <p>
      たとえば訪問販売（8日間）で7月1日に書面を受け取った場合、期限日は7月8日です。「受領日＋8日」と計算すると1日遅く見積もってしまうので注意してください。
    </p>
    <DayCountFigure
      startLabel="書面の受領日"
      days={8}
      mode="both"
      highlight={8}
      caption="クーリングオフは上段の数え方です。受領日を1日目とするため、8日目は「受領日＋7日」になります。下段のように翌日から数えると、1日遅く見積もってしまいます。"
    />
    <h2>計算例 — 受領日の曜日で見る期限日</h2>
    <p>
      実際の日付で確認してみましょう。いずれも訪問販売などの<strong>8日間</strong>の場合です。
    </p>
    <table class="milestones">
      <tr><th>書面の受領日</th><th>期限日（8日目）</th><th>ポイント</th></tr>
      <tr><td>2026年7月6日（月）</td><td class="date-cell">7月13日（月）</td><td>翌週の同じ曜日が期限。平日なので郵便局の窓口で出せる</td></tr>
      <tr><td>2026年7月10日（金）</td><td class="date-cell">7月17日（金）</td><td>途中に土日を挟むが、日数は暦日で数えるので延びない</td></tr>
      <tr><td>2026年7月31日（金）</td><td class="date-cell">8月7日（金）</td><td>月をまたぐ。「7月38日」のような暗算ミスに注意</td></tr>
      <tr><td>2026年7月6日（月）・20日間の場合</td><td class="date-cell">7月25日（土）</td><td>連鎖販売取引など。受領日＋19日。土曜日が期限なので前日までに出すのが安全</td></tr>
    </table>
    <p class="small">
      期間は暦日（カレンダーの日数）で数え、土日や祝日を飛ばしません。8日間なら受領日と同じ曜日の翌週が期限日、と覚えておくと確認しやすくなります。
    </p>
    <h2>期限日までに何をすればよいか</h2>
    <p>
      期限日までに「契約を解除する」旨をはがき等の書面またはメール等の電磁的記録で<strong>発信</strong>すれば、事業者に届くのが期限後でも有効です（発信主義）。期限日の消印、または送信日時が期間内であることが証拠になるので、はがきの両面コピーや送信済みメールを残しておきます。はがきに書く項目、宛先、クレジット会社への通知、解除後の返金や引き取りの扱いは、<a href="/column/cooling-off-kigen/">コラム「クーリングオフの期限の数え方」</a>にまとめています。
    </p>
    <h2>取引の種類と期間の一覧</h2>
    <p>
      入力欄の「取引の種類」を選ぶときの目安です。期間は書面の受領日を1日目とした日数です。
    </p>
    <table class="milestones">
      <tr><th>取引の種類</th><th>期間</th><th>主な例</th></tr>
      <tr><td>訪問販売</td><td class="date-cell">8日間</td><td>自宅への訪問、キャッチセールス、アポイントメントセールス</td></tr>
      <tr><td>電話勧誘販売</td><td class="date-cell">8日間</td><td>電話で勧誘され、郵送などで申し込んだ契約</td></tr>
      <tr><td>特定継続的役務提供</td><td class="date-cell">8日間</td><td>エステ、美容医療、語学教室、学習塾、家庭教師、パソコン教室、結婚相手紹介サービス</td></tr>
      <tr><td>訪問購入</td><td class="date-cell">8日間</td><td>自宅に来た業者による貴金属などの買取（押し買い）</td></tr>
      <tr><td>連鎖販売取引</td><td class="date-cell">20日間</td><td>いわゆるマルチ商法</td></tr>
      <tr><td>業務提供誘引販売取引</td><td class="date-cell">20日間</td><td>「仕事を紹介する」と勧誘して機材などを買わせる内職・モニター商法</td></tr>
    </table>
    <p class="small">
      通信販売（ネット通販）や自分で店舗に出向いた買い物には、そもそもクーリングオフ制度がありません。上の一覧に当てはまらない取引は本ツールでは計算できないため、対象外となる取引の一覧と、期限を過ぎていても行使できる場合（書面の不備・事業者の妨害など）は<a href="/column/cooling-off-kigen/">コラム</a>を参照してください。
    </p>
    <h2>こんなときはどうする？ — 場面別の判断</h2>
    <ul>
      <li><strong>8日目が日曜日や祝日に当たる</strong> — 一般には期限は延びないと考えられています。郵便ポストの最終収集時刻を過ぎると翌日の消印になることもあるため、期限日ぎりぎりではなく、できれば前の平日に郵便局の窓口から出してください。</li>
      <li><strong>契約書面をもらった日がはっきりしない</strong> — 契約書の控えに交付日が書かれていることが多いので確認します。分からなければ、契約日を受領日とみなして<strong>早いほうの日付</strong>で期限を計算し、それまでに通知を出すのが安全です。</li>
      <li><strong>商品はすでに届いて、開封してしまった</strong> — 開封しても原則としてクーリングオフできます。ただし健康食品・化粧品など政令で定められた消耗品を「使用」した場合、使った分は対象外になります。未使用分は対象です。</li>
      <li><strong>訪問購入で、買取業者に品物を渡すよう迫られている</strong> — 訪問購入ではクーリングオフ期間中、消費者は品物の引き渡しを<strong>拒むことができます</strong>。渡してしまうと転売されて取り戻せなくなるおそれがあるため、期間中は手元に置いておきましょう。</li>
      <li><strong>期限内に出したのに「受け取っていない」と言われた</strong> — 発信主義なので、期間内に発信した証拠（特定記録の控え、はがきのコピー、送信済みメール）があれば効力は生じています。証拠をそろえて消費生活センターに相談してください。</li>
    </ul>
    <h2>なぜ「初日を含める」のか</h2>
    <p>
      民法の原則（初日不算入）とクーリングオフの数え方が違うのは、特定商取引法の条文が「受領した日から起算して8日を経過した場合」には解除できない、という形で定めているためです。「受領した日から起算」と書かれているので、受け取ったその日が1日目になります。一方、「翌日から起算」や単に「◯日以内」とだけ書かれた期間は、民法の原則どおり翌日を1日目として数えるのが通常です。同じ「8日」でも、条文の書き方ひとつで期限が1日変わるわけです。
    </p>
    <p>
      日数の数え方の一般論は<a href="/column/shonichi/">コラム「初日を含める・含めない」</a>で、クーリングオフ特有の落とし穴は<a href="/column/cooling-off-kigen/">コラム「クーリングオフの期限の数え方」</a>で詳しく解説しています。
    </p>
  </Fragment>
</ToolLayout>

<script>
  import { parseYmd, toYmd, formatJa, coolingOffDeadline } from "../lib/dateCore.js";
  import { himekuriHTML, shareButtonHTML, bindShareButtons, getParam, setParams } from "../lib/ui.js";

  const $ = (id) => document.getElementById(id);
  const result = $("result");

  function run() {
    const v = $("receipt-date").value;
    if (!v) return;
    const receipt = parseYmd(v);
    const sel = $("deal-type");
    const days = Number(sel.value);
    const label = sel.options[sel.selectedIndex].text;
    const deadline = coolingOffDeadline(receipt, days);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const passed = deadline < today;
    result.innerHTML = `
      <p class="result-caption">${label.replace(/（.*/, "")}のクーリングオフ期限は</p>
      ${himekuriHTML(deadline)}
      <p class="result-caption"><strong>${formatJa(deadline)} まで</strong>（受領日を1日目として${days}日間）</p>
      ${passed ? `<p class="result-note">期限日を過ぎていますが、書面不交付・記載不備などの場合は行使できることがあります。消費者ホットライン188へ相談を。</p>` : `<p class="result-note">この日の消印まで有効です（書面で発信する場合）。</p>`}
      ${shareButtonHTML()}`;
    bindShareButtons(result);
    setParams({ d: toYmd(receipt), t: String(sel.selectedIndex) });
  }

  $("calc-btn").addEventListener("click", run);
  const p = getParam("d");
  if (p) {
    $("receipt-date").value = p;
    const t = Number(getParam("t"));
    if (Number.isInteger(t) && t >= 0 && t < $("deal-type").options.length) $("deal-type").selectedIndex = t;
    run();
  }
</script>
