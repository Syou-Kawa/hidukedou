---
import ToolLayout from "../layouts/ToolLayout.astro";
import { HOLIDAY_RANGE, holidayYears } from "../lib/dateCore.js";
import holidayData from "../lib/holidays.js";
import { REFS } from "../lib/site.js";

const sources = [REFS.shukujitsuHo, REFS.caoShukujitsu, REFS.naoKoyomi];

const years = holidayYears();
const fromYear = HOLIDAY_RANGE.from.slice(0, 4);
const toYear = HOLIDAY_RANGE.to.slice(0, 4);

// 祝日名 → { imi: 祝日法に定める趣旨, yurai: 日付の由来・補足 }
// 一覧の祝日名クリックでここに遷移する（idは "hd-祝日名"）
const HOLIDAY_GUIDE = [
  {
    name: "元日",
    imi: "年のはじめを祝う。",
    yurai: "1月1日固定。一年の最初の日として、古くから年神様を迎えてお祝いする日です。",
  },
  {
    name: "成人の日",
    imi: "おとなになったことを自覚し、みずから生き抜こうとする青年を祝いはげます。",
    yurai: "1月の第2月曜日。もとは小正月の1月15日でしたが、2000年のハッピーマンデー制度で第2月曜日に移りました。",
  },
  {
    name: "建国記念の日",
    imi: "建国をしのび、国を愛する心を養う。",
    yurai: "2月11日。初代天皇とされる神武天皇が即位したと伝えられる日（旧・紀元節）に由来します。",
  },
  {
    name: "天皇誕生日",
    imi: "天皇の誕生日を祝う。",
    yurai: "2月23日。今上天皇のお誕生日です。代替わりに合わせて日付が変わる祝日で、平成は12月23日、昭和は4月29日でした。",
  },
  {
    name: "春分の日",
    imi: "自然をたたえ、生物をいつくしむ。",
    yurai: "太陽が春分点を通る日で、天文計算により毎年決まります（3月20日ごろ）。昼と夜の長さがほぼ等しくなる日で、春のお彼岸の中日でもあります。",
  },
  {
    name: "昭和の日",
    imi: "激動の日々を経て、復興を遂げた昭和の時代を顧み、国の将来に思いをいたす。",
    yurai: "4月29日。昭和天皇の誕生日です。昭和のあいだは天皇誕生日、平成では「みどりの日」となり、2007年から「昭和の日」になりました。",
  },
  {
    name: "憲法記念日",
    imi: "日本国憲法の施行を記念し、国の成長を期する。",
    yurai: "5月3日。日本国憲法が施行された1947年5月3日にちなみます。",
  },
  {
    name: "みどりの日",
    imi: "自然に親しむとともにその恩恵に感謝し、豊かな心をはぐくむ。",
    yurai: "5月4日。もとは4月29日でしたが、そこが「昭和の日」になった2007年に5月4日へ移りました。",
  },
  {
    name: "こどもの日",
    imi: "こどもの人格を重んじ、こどもの幸福をはかるとともに、母に感謝する。",
    yurai: "5月5日。端午の節句の日です。趣旨に「母に感謝する」が入っているのはあまり知られていないポイントです。",
  },
  {
    name: "海の日",
    imi: "海の恩恵に感謝するとともに、海洋国日本の繁栄を願う。",
    yurai: "7月の第3月曜日。明治天皇の東北巡幸からの帰着日にちなむ「海の記念日」（7月20日）が由来で、2003年から第3月曜日になりました。",
  },
  {
    name: "山の日",
    imi: "山に親しむ機会を得て、山の恩恵に感謝する。",
    yurai: "8月11日。2016年に加わった最も新しい祝日です。お盆前の時期に置かれました。",
  },
  {
    name: "敬老の日",
    imi: "多年にわたり社会につくしてきた老人を敬愛し、長寿を祝う。",
    yurai: "9月の第3月曜日。もとは9月15日の「としよりの日」に始まり、2003年から第3月曜日になりました。",
  },
  {
    name: "秋分の日",
    imi: "祖先をうやまい、なくなった人々をしのぶ。",
    yurai: "太陽が秋分点を通る日で、天文計算により毎年決まります（9月23日ごろ）。秋のお彼岸の中日です。",
  },
  {
    name: "スポーツの日",
    imi: "スポーツにしたしみ、健康な心身をつちかう。",
    yurai: "10月の第2月曜日。1964年東京オリンピックの開会式（10月10日）にちなむ「体育の日」が前身で、2020年に「スポーツの日」へ改称されました。",
  },
  {
    name: "文化の日",
    imi: "自由と平和を愛し、文化をすすめる。",
    yurai: "11月3日。日本国憲法が公布された1946年11月3日にちなみます。明治天皇の誕生日（旧・明治節）でもありました。",
  },
  {
    name: "勤労感謝の日",
    imi: "勤労をたっとび、生産を祝い、国民たがいに感謝しあう。",
    yurai: "11月23日。収穫を感謝する宮中行事「新嘗祭（にいなめさい）」の日に由来します。",
  },
  {
    name: "振替休日",
    imi: "祝日が日曜日と重なったとき、その後の祝日でない最も近い日が休日になります。",
    yurai: "祝日法第3条2項の定め。多くは翌月曜日ですが、GWのように祝日が連続すると水曜日まで飛ぶこともあります。",
  },
  {
    name: "国民の休日",
    imi: "前日と翌日がどちらも祝日である平日は、休日になります。",
    yurai: "祝日法第3条3項の定め。敬老の日（第3月曜）と秋分の日が1日おきに並ぶ年に現れ、シルバーウィークの大型連休を生みます。",
  },
];

// データに実際に登場する祝日だけ解説を載せる（年次更新で祝日が変わっても不整合にならないように）
const namesInData = new Set(holidayData.holidays.map((h) => h.name));
const guide = HOLIDAY_GUIDE.filter((g) => namesInData.has(g.name));

const faqs = [
  {
    q: "次の祝日はいつですか？",
    a: "このページを開くと、今日を基準にした「次の祝日」とそこまでの残り日数を自動で表示します。年を切り替えれば、その年の祝日を一覧で確認できます。",
  },
  {
    q: "「連休」はどう判定していますか？",
    a: "祝日の前後に続く土曜・日曜・祝日・振替休日をつなげて数え、3日以上続く場合に「◯連休」と表示しています。飛び石連休（間に平日がある場合）は別々の連休として数えます。会社や学校のカレンダー次第では、有給などでさらに長い連休になることもあります。",
  },
  {
    q: "何年分の祝日に対応していますか？",
    a: `${fromYear}年〜${toYear}年に対応しています。祝日は「国民の祝日に関する法律」で定められ、春分の日・秋分の日は前年2月の官報公示で正式に確定します。そのため本ツールは確定済みの範囲のみを掲載し、毎年内閣府の公表データをもとに更新しています。`,
  },
  {
    q: "振替休日や国民の休日も含まれますか？",
    a: "含まれます。祝日が日曜と重なったときの「振替休日」、祝日にはさまれた平日が休みになる「国民の休日」も、実際に休みになる日として一覧に表示します。それぞれのしくみはコラムで解説しています。",
  },
];

const keyPoints = [
  "ページを開くとすぐに<strong>次の祝日と残り日数</strong>がわかる",
  "年を切り替えると、その年の<strong>祝日を一覧</strong>で確認できる",
  "3日以上つながる休みには<strong>「◯連休」</strong>の目印がつく",
];

const related = [
  { href: "/eigyobi/", label: "営業日計算 — 土日祝を除いた「◯営業日後」はこちら" },
  { href: "/column/shukujitsu/", label: "コラム: 祝日はどうやって決まる？振替休日と国民の休日のしくみ" },
  { href: "/rokuyo/", label: "六曜カレンダー — 今日の六曜と次の大安がわかる" },
];
---

<ToolLayout
  title="祝日カレンダー — 次の祝日はいつ？連休が一目でわかる祝日一覧"
  description={`今日を基準に「次の祝日」までの残り日数を表示。${fromYear}年〜${toYear}年の国民の祝日を年ごとに一覧化し、3連休以上の連休にも目印をつけます。振替休日・国民の休日にも対応。`}
  h1="祝日カレンダー"
  lead="今日から見た「次の祝日」と、その年の祝日一覧をまとめて表示します。連休も一目で把握できます。"
  keyPoints={keyPoints}
  faqs={faqs}
  related={related}
  published="2026-07-09"
  updated="2026-09-06"
  sources={sources}
>
  <div class="calc" slot="calc">
    <div id="next-holiday" aria-live="polite"></div>
    <div class="row">
      <div>
        <label for="year-select">年を選ぶ</label>
        <select id="year-select">
          {years.map((y) => <option value={y}>{y}年</option>)}
        </select>
      </div>
    </div>
    <div id="list" aria-live="polite"></div>
  </div>

  <Fragment slot="explain">
    <h2>使い方</h2>
    <ol class="calc-steps">
      <li>ページを開くと、今日から見た「次の祝日」と残り日数が表示されます。</li>
      <li>「年を選ぶ」で年を切り替えると、その年の祝日・振替休日・国民の休日が一覧になります。</li>
      <li>祝日名をクリックすると、下の解説（意味・由来）に移動します。</li>
    </ol>

    <h2>祝日には3つのタイプがあります</h2>
    <p>
      国民の祝日は「国民の祝日に関する法律」（祝日法）で決まっています。元日（1月1日）のように<strong>日付が固定</strong>のもの、成人の日（1月の第2月曜日）のように<strong>曜日で決まる</strong>もの（ハッピーマンデー）、春分の日・秋分の日のように<strong>天文計算で毎年変わる</strong>ものの3タイプです。年ごとに動くものがあるため、正確な日付は毎年確認するのが確実です。
    </p>

    <h2>振替休日・国民の休日も一覧に含みます</h2>
    <p>
      祝日が日曜日と重なると、その後の祝日でない最も近い日が休みになり（<strong>振替休日</strong>）、前日と翌日が祝日である平日も休みになります（<strong>国民の休日</strong>）。本ツールの一覧はこれらも「実際に休みになる日」として表示し、連休の日数にも含めます。振替休日が翌月曜日とは限らない理由や、国民の休日が数年に一度しか現れない理由は<a href="/column/shukujitsu/">コラム「祝日はどうやって決まる？」</a>で解説しています。
    </p>

    <h2>春分の日・秋分の日は前年に確定します</h2>
    <p>
      春分の日・秋分の日は天文計算で決まり、国立天文台が<strong>前年2月に官報で公示</strong>して正式に確定します。本ツールが確定済みの年だけを掲載し、未確定の年を推定で載せないのはこのためです。しくみの詳細は<a href="/column/shukujitsu/">コラム</a>をご覧ください。
    </p>

    <h2>連休の目印について</h2>
    <p>
      土曜・日曜・祝日・振替休日・国民の休日が3日以上続く場合、その祝日に「◯連休」と表示します。同じ祝日でも年によって連休になったり飛び石になったりするのは、日付固定の祝日の曜日が毎年ずれるためです（詳しくは<a href="/column/shukujitsu/">コラム</a>）。祝日が集中する時期の大型連休を見つけやすくなるので、旅行や帰省の計画、営業日の見通し（<a href="/eigyobi/">営業日計算</a>）にお使いください。
    </p>

    <h2>計算例 — 「次の祝日まで」と「◯連休」の数え方</h2>
    <p>
      本ツールの「あと◯日」と「◯連休」は、次のルールで数えています。掲載データにある2026年の例で確かめてみます。
    </p>
    <ul>
      <li><strong>あと◯日</strong>: 今日を0日として、祝日当日までの日数です。「今日を含めず、祝日当日を含める」数え方なので、翌日が祝日なら「あと1日」、祝日当日は「今日」と表示します。</li>
      <li><strong>◯連休</strong>: その祝日から前後に、土曜・日曜・祝日・振替休日・国民の休日が途切れずに続く範囲を数えた日数です。間に平日が1日でも入ると、そこで区切って別々に数えます（飛び石連休は1つの連休として合算しません）。</li>
    </ul>
    <table class="milestones">
      <tr><th>基準日</th><th>祝日</th><th>あと◯日</th><th>連休の範囲</th><th>表示</th></tr>
      <tr class="is-main"><td>2026年9月6日（日）</td><td>9月21日（月）敬老の日</td><td class="date-cell">あと15日</td><td>9月19日（土）〜23日（水・秋分の日）。22日は国民の休日</td><td>5連休</td></tr>
      <tr><td>2026年9月6日（日）</td><td>10月12日（月）スポーツの日</td><td class="date-cell">あと36日</td><td>10月10日（土）〜12日（月）</td><td>3連休</td></tr>
      <tr><td>2026年9月6日（日）</td><td>11月3日（火）文化の日</td><td class="date-cell">あと58日</td><td>11月3日のみ（前日の月曜が平日）</td><td>目印なし</td></tr>
      <tr><td>2026年9月6日（日）</td><td>11月23日（月）勤労感謝の日</td><td class="date-cell">あと78日</td><td>11月21日（土）〜23日（月）</td><td>3連休</td></tr>
    </table>
    <p>
      文化の日のように祝日と土日の間に平日が1日はさまる年は、有給を1日使えば4連休にできる「飛び石」です。本ツールは平日をまたいだ合算はしないので、飛び石は自分で見つける必要があります。年を切り替えて祝日の曜日を眺めると、飛び石になっている祝日がすぐ見つかります。
    </p>
    <h2 id="imi">それぞれの祝日の意味・由来</h2>
    <p>
      国民の祝日には、祝日法で一つひとつ<strong>趣旨（その日を祝日とする理由）</strong>が定められています。一覧の祝日名をクリックすると、ここの解説に移動します。
    </p>
    {
      guide.map((g) => (
        <section class="holiday-guide" id={`hd-${g.name}`}>
          <h3>{g.name}</h3>
          <p>
            <strong>{g.imi}</strong>
            {g.yurai}
          </p>
        </section>
      ))
    }
    <h2>祝日データの出典と更新方針</h2>
    <p>
      祝日データは内閣府が公表している「国民の祝日」の一覧（下記の出典）をもとに作成し、振替休日・国民の休日も同じ資料に沿って収録しています。掲載範囲は<strong>{fromYear}年〜{toYear}年</strong>で、春分の日・秋分の日が官報で公示された時点で1年分ずつ追加します。祝日法の改正や特例（オリンピック開催年に海の日などが移動した例があります）も公布後に反映し、未確定の年を推定で掲載することはしていません。
    </p>
  </Fragment>
</ToolLayout>

<script>
  import {
    holidaysInYear,
    nextHoliday,
    holidayRunLength,
    holidayYears,
    diffDays,
    formatJa,
    toYmd,
  } from "../lib/dateCore.js";
  import { getParam, setParams } from "../lib/ui.js";

  const $ = (id) => document.getElementById(id);
  const nextEl = $("next-holiday");
  const listEl = $("list");
  const select = $("year-select");

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const todayYmd = toYmd(today);

  function renderNext() {
    const next = nextHoliday(today);
    if (!next) {
      nextEl.innerHTML = `<p class="result-caption">掲載範囲内に、これから来る祝日はありません。</p>`;
      return;
    }
    const days = diffDays(today, next.date, false);
    const when = days === 0 ? "今日" : `あと${days}日`;
    nextEl.innerHTML = `<p class="result-caption">次の祝日</p>
      <div class="result-big">${when}</div>
      <p class="result-caption">${formatJa(next.date)}・${next.name}</p>`;
  }

  function renderYear(year) {
    const items = holidaysInYear(year);
    if (items.length === 0) {
      listEl.innerHTML = `<p class="result-caption">${year}年の祝日データはありません。</p>`;
      return;
    }
    const rows = items
      .map((it) => {
        const ymd = toYmd(it.date);
        const isNext = ymd >= todayYmd;
        const run = holidayRunLength(it.date);
        const renbi = run >= 3 ? `<span class="sub">${run}連休</span>` : "";
        let status;
        if (ymd < todayYmd) status = `<span class="sub">済</span>`;
        else if (ymd === todayYmd) status = "今日";
        else status = `あと${diffDays(today, it.date, false)}日`;
        // 今日以降で最初の祝日の行を強調
        const main = ymd === firstUpcomingYmd ? ' class="is-main"' : "";
        return `<tr${main}>
          <td class="date-cell is-red">${formatJa(it.date)}</td>
          <td><a href="#hd-${it.name}" title="${it.name}の意味・由来を見る">${it.name}</a>${renbi}</td>
          <td class="date-cell">${status}</td>
        </tr>`;
      })
      .join("");
    listEl.innerHTML = `<table class="milestones">
      <thead><tr><th>日付</th><th>祝日</th><th>残り</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  }

  // 今日以降で最初の祝日（強調表示用）。全期間から探す。
  const upcoming = nextHoliday(today);
  const firstUpcomingYmd = upcoming ? toYmd(upcoming.date) : "";

  function show(year) {
    select.value = String(year);
    renderYear(year);
    setParams({ y: String(year) });
  }

  select.addEventListener("change", () => show(Number(select.value)));

  renderNext();

  const years = holidayYears();
  const paramYear = Number(getParam("y"));
  const currentYear = today.getFullYear();
  let initial;
  if (years.includes(paramYear)) initial = paramYear;
  else if (years.includes(currentYear)) initial = currentYear;
  else initial = years[0];
  show(initial);
</script>
