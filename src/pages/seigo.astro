---
import ToolLayout from "../layouts/ToolLayout.astro";
import DayCountFigure from "../components/DayCountFigure.astro";

const sources = [];

const faqs = [
  {
    q: "生後日数は生まれた日を0日と1日、どちらで数えますか？",
    a: "母子健康手帳では生まれた日を「生後0日」と数えます。本ツールの「今日で生後◯日」もこの数え方です。一方、お七夜や百日祝いなどの伝統行事は、生まれた日を「1日目」と数えるのが慣例です。本ツールでは行事の日付は慣例どおり1日目起算で計算し、その旨を明記しています。",
  },
  {
    q: "月齢（生後◯か月）の数え方は？",
    a: "毎月の「生まれた日と同じ日」を迎えるごとに1か月と数える方法（同日基準）が一般的で、本ツールもこの方式です。たとえば1月15日生まれの赤ちゃんは、7月15日で生後6か月になります。月末生まれで同じ日がない月は、その月の末日で繰り上がりとします。",
  },
  {
    q: "お宮参りは必ず31日目・32日目に行くものですか？",
    a: "男の子は生後31日目・女の子は32日目が古くからの目安とされますが、あくまで目安です。現在は赤ちゃんと母親の体調、天候、家族の都合を優先して、生後1か月頃〜100日頃までの間で選ぶ家庭が多くなっています。地域によって時期の慣習が異なる場合もあります。",
  },
  {
    q: "百日祝い（お食い初め）はいつ行いますか？",
    a: "生後100日目（生まれた日を1日目として数える）に行うのが基本ですが、110日目や120日目に行う地域もあります。ぴったりの日でなくても、前後の都合のよい日に行って問題ないとされています。",
  },
  {
    q: "新生児とはいつまでの赤ちゃんを指しますか？",
    a: "母子保健法では生後28日未満（生後4週間まで）を新生児と定めています。母子手帳と同じ0日起算なので、生まれた日から数えて28日目の前日までです。新生児訪問（赤ちゃん訪問）はこの時期を目安に行われます。",
  },
  {
    q: "初節句はいつになりますか？",
    a: "女の子は生まれて初めて迎える3月3日（桃の節句）、男の子は5月5日（端午の節句）です。生後まもなく節句を迎える場合は、無理をせず翌年に繰り越してお祝いする家庭も多くあります。",
  },
  {
    q: "お食い初めの日をずらすなら、前と後ろのどちらがよいですか？",
    a: "決まりはありませんが、「食べ物に困らないように」という願いの行事なので、少し先延ばしにして「食い延ばし」を願う地域もあり、後ろにずらすことに抵抗はないとされています。首がすわって離乳食を始める前の、生後3〜4か月頃の都合のよい休日に行う家庭が多いです。",
  },
];

const keyPoints = [
  "「生後◯日」は<strong>生まれた日を0日</strong>と数える（母子手帳と同じ）",
  "お七夜・お宮参り・百日祝いなどの行事は<strong>生まれた日を1日目</strong>と数えるため、1日ずれる",
  "行事の日付はあくまで目安。赤ちゃんと家族の体調を最優先に",
];

const related = [
  { href: "/nyugaku/", label: "入学・卒業年の計算 — 生年月日から小学校〜大学の入学年がわかる" },
  { href: "/kinenbi/", label: "記念日カウンター — 100日目・1000日目などの節目を計算" },
  { href: "/column/okuizome/", label: "コラム: お宮参り・お食い初めはいつ？生後日数の数え方" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」日数の数え方の基本" },
];
---

<ToolLayout
  title="生後日数計算 — 今日で生後何日？月齢とお祝い行事の日付を自動計算"
  description="赤ちゃんの誕生日から、今日で生後何日・何週・何か月かを自動計算。お七夜・お宮参り・百日祝い（お食い初め）・ハーフバースデーの日付も一覧表示します。"
  h1="生後日数・お祝い日の計算"
  lead="誕生日を入力すると、今日で生後何日・何週・何か月かと、お七夜から1歳までのお祝い行事の日付を計算します。"
  keyPoints={keyPoints}
  faqs={faqs}
  related={related}
  published="2026-07-05"
  updated="2026-09-06"
  sources={sources}
>
  <div class="calc" slot="calc">
    <div class="row">
      <div>
        <label for="birth-date">赤ちゃんの誕生日</label>
        <input type="date" id="birth-date" />
      </div>
      <button type="button" class="btn" id="calc-btn">計算する</button>
    </div>
    <div id="result" aria-live="polite"></div>
  </div>

  <Fragment slot="explain">
    <h2>使い方</h2>
    <ol class="calc-steps">
      <li><strong>赤ちゃんの誕生日</strong>を入力します。出産予定日を入れると、予定日を基準にしたお祝い行事の一覧が表示されるので、里帰りや写真館の予約の目安にも使えます。</li>
      <li>「計算する」を押すと、今日で生後何日・何週・何か月かが表示されます。この数字は母子健康手帳と同じ「生まれた日＝0日」の数え方です。</li>
      <li>その下に、お七夜・お宮参り・百日祝い・ハーフバースデー・1歳の誕生日の日付が並びます。行事の日付は「生まれた日＝1日目」の伝統的な数え方で計算しています。</li>
      <li>共有ボタンで URL をコピーし、両家の祖父母と日程を相談するときに送ることができます。</li>
    </ol>
    <h2>生後日数の数え方 — 「0日」と「1日目」の混在に注意</h2>
    <p>
      赤ちゃんの日数の数え方には、実は2つの流儀が混在しています。
    </p>
    <ul>
      <li><strong>医療・母子健康手帳</strong>: 生まれた日を「生後0日」と数えます。「今日で生後◯日」はこちらです。</li>
      <li><strong>伝統行事</strong>: 生まれた日を「1日目」と数えます。お七夜（7日目）、お宮参り（男児31日目・女児32日目）、百日祝い（100日目）はこちらの数え方です。</li>
    </ul>
    <p>
      このため「生後100日」と「百日祝いの100日目」は1日ずれます。本ツールでは、生後日数は0日起算、行事の日付は慣例どおり1日目起算で計算しています。
    </p>
    <DayCountFigure
      startLabel="生まれた日"
      days={7}
      mode="both"
      highlight={7}
      caption="上段が伝統行事の数え方（生まれた日＝1日目、お七夜は誕生日＋6日）、下段が母子手帳の数え方（生まれた日＝0日）。同じ「7日」でも指す日が1日違います。"
    />
    <h2>計算例 — お食い初め（百日祝い）の日はいつ？</h2>
    <p>
      百日祝いは「生まれた日を1日目として100日目」なので、日付の計算では<strong>誕生日＋99日</strong>です。母子手帳の「生後100日」（誕生日＋100日）とは1日ずれます。地域によっては110日目・120日目に行うこともあるので、あわせて示します。
    </p>
    <table class="milestones">
      <tr><th>誕生日</th><th>100日目（誕生日＋99日）</th><th>母子手帳の生後100日</th><th>110日目／120日目</th></tr>
      <tr><td>2026年7月5日（日）</td><td class="date-cell">10月12日（月・スポーツの日）</td><td>10月13日（火）</td><td>10月22日（木）／11月1日（日）</td></tr>
      <tr><td>2026年1月31日（土）</td><td class="date-cell">5月10日（日）</td><td>5月11日（月）</td><td>5月20日（水）／5月30日（土）</td></tr>
      <tr><td>2026年10月15日（木）</td><td class="date-cell">2027年1月22日（金）</td><td>2027年1月23日（土）</td><td>2月1日（月）／2月11日（木・建国記念の日）</td></tr>
    </table>
    <p>
      1つ目の例は100日目が祝日に当たるので、当日にお祝いしやすい例です。2つ目は100日目がちょうど日曜日で、母の日（5月の第2日曜日）と重なります。3つ目は100日目が金曜日なので、翌日の土曜日か翌々日の日曜日にずらす家庭が多いでしょう。このように、まず本ツールで100日目を出し、その前後の休日を候補にするのが実際の決め方です。
    </p>
    <p>
      お宮参りも同じ数え方です。7月5日生まれの男の子なら31日目は8月4日（火）、女の子なら32日目は8月5日（水）ですが、真夏の炎天下を避けて9月以降の涼しい日に行く家庭も多く見られます。行事の由来と数え方の詳細は<a href="/column/okuizome/">コラム「お宮参り・お食い初めはいつ？」</a>で解説しています。
    </p>
    <h2>「日齢」との違い</h2>
    <p>
      医療の現場や母子健康手帳では、生まれた日を0日とする「<strong>日齢</strong>（にちれい）」という言い方をします。出生当日が日齢0、翌日が日齢1です。新生児の黄疸の検査や退院の目安、新生児マススクリーニング（先天性代謝異常等検査）の採血時期などは、この日齢で案内されます。「日齢4〜6日で採血」と言われたら、誕生日の4〜6日後の日付です。
    </p>
    <p>
      一方、伝統行事の「◯日目」は、誕生日を1日目と数える序数の言い方です。同じ「7日」でも、日齢7は誕生日＋7日、お七夜の7日目は誕生日＋6日と、指す日が1日違います。病院や自治体からの案内は日齢、行事や慣習は「◯日目」と使い分けられていると覚えておくと混乱しません。本ツールの結果表示でも、上段の「生後◯日」は日齢、下の行事一覧は「◯日目」の数え方です。
    </p>
    <h2>週数と月齢の使い分け</h2>
    <p>
      「生後◯週」と「生後◯か月」は使われる場面が異なります。
    </p>
    <ul>
      <li><strong>週数</strong> — 新生児期〜低月齢のうちは週単位で成長が語られます。母子保健法上の「新生児」は生後28日未満（4週間）です。</li>
      <li><strong>月齢</strong> — 健診（1か月健診、3〜4か月健診など）や予防接種のスケジュールは月齢が基準です。定期予防接種の多くは<strong>生後2か月</strong>から始まるので、誕生日の2か月後の日付を早めに確認しておくと準備がスムーズです。</li>
    </ul>
    <p>
      本ツールは日数・週数・月齢をまとめて表示するので、健診の問診票や予防接種の予約時の確認にも使えます。
    </p>
    <h2>1歳までのお祝い行事カレンダー</h2>
    <table class="milestones">
      <tr><th>行事</th><th>時期の目安</th><th>内容</th></tr>
      <tr><td>お七夜・命名式</td><td class="date-cell">7日目</td><td>名前を披露し、命名書を飾る</td></tr>
      <tr><td>お宮参り</td><td class="date-cell">31日目／32日目</td><td>男児31日目・女児32日目が古来の目安。神社に誕生を報告</td></tr>
      <tr><td>百日祝い（お食い初め）</td><td class="date-cell">100日目</td><td>「一生食べ物に困らないように」と祝い膳を用意</td></tr>
      <tr><td>ハーフバースデー</td><td class="date-cell">生後6か月</td><td>近年広まった記念日。写真撮影などで祝う</td></tr>
      <tr><td>初節句</td><td class="date-cell">初めての3/3・5/5</td><td>女児は桃の節句、男児は端午の節句</td></tr>
      <tr><td>初誕生（一升餅）</td><td class="date-cell">満1歳</td><td>一升餅を背負わせる・選び取りなどの伝統行事</td></tr>
    </table>
    <p class="small">日数はいずれも生まれた日を1日目とする伝統的な数え方です。</p>
    <h3>それぞれの行事の内容と準備</h3>
    <ul>
      <li><strong>お七夜・命名式</strong> — 生後7日目の夜に名前を披露する行事です。命名書は市販のものや、自治体・写真館が配布するテンプレートを使う家庭も増えています。退院と重なることが多いので、家族だけで簡単に済ませるのが一般的です。出生届の提出期限は出生日を含めて14日以内なので、この時期までに名前を決めておく必要があります。</li>
      <li><strong>お宮参り</strong> — 氏神様に誕生を報告する行事です。祝い着（産着）は写真館や貸衣装店でレンタルできます。神社に祈祷を頼む場合は、初穂料の目安と予約の要否を事前に確認しておきます。</li>
      <li><strong>百日祝い（お食い初め）</strong> — 祝い膳（鯛の尾頭付き、赤飯、汁物、煮物、香の物、歯固め石）を用意し、年長者が食べさせる真似をします。最近は料亭やホテルのお食い初めプラン、宅配のセットを利用する家庭も多くなっています。</li>
      <li><strong>ハーフバースデー</strong> — 生後6か月の記念日で、日本では近年広まりました。寝返りや離乳食の開始時期と重なるため、写真撮影や離乳食のお祝いプレートで祝うことが一般的です。</li>
      <li><strong>初節句</strong> — 雛人形や五月人形は、祖父母が贈る習慣のある地域もあります。生後間もない場合は翌年に繰り越すことも多く、両家で早めに相談しておくと安心です。</li>
      <li><strong>初誕生（一升餅）</strong> — 満1歳の誕生日に一升（約1.8kg）の餅を背負わせ、一生食べ物に困らないよう願います。地域によって「踏ませる」「抱かせる」など作法が異なり、将来を占う「選び取り」を行う家庭もあります。</li>
    </ul>
    <h2>行事の時期はあくまで目安</h2>
    <p>
      お宮参りや百日祝いの日数は伝統的な目安であり、その日でなければならないものではありません。赤ちゃんと家族の体調を最優先に、都合のよい日を選んでください。時期や作法は地域差も大きいので、両家の慣習も確認しておくと安心です。
    </p>
    <h2>日をずらすときの考え方</h2>
    <p>
      「目安の日」から動かすときは、前と後ろのどちらにずらしてもかまいません。一般的には次のような点で判断されています。
    </p>
    <ul>
      <li><strong>季節</strong> — 真夏や真冬の外出は避け、お宮参りは涼しい・暖かい時期まで待つ家庭が多くなっています。</li>
      <li><strong>母親の体調</strong> — 産後1か月は回復期です。お宮参りを1か月健診の後にする、写真だけ先に撮っておくといった調整もよく行われます。</li>
      <li><strong>参加者の都合</strong> — 祖父母を招く場合は、目安の日に近い休日を選びます。前後2〜3週間の幅でずらしても問題ないとされています。</li>
      <li><strong>他の行事との重なり</strong> — 百日祝いと初節句が近い場合はまとめて祝う家庭もあります。逆にお盆や年末年始は写真館や料亭が混み合うので、早めの予約が必要です。</li>
      <li><strong>六曜</strong> — 大安にこだわる必要はありませんが、祖父母が気にする場合は候補日の六曜を確認しておくと相談がスムーズです。<a href="/rokuyo/">六曜カレンダー</a>で調べられます。</li>
    </ul>
    <h2>こんなときはどうする？</h2>
    <ul>
      <li><strong>早産・低出生体重で生まれた</strong> — 行事の日付は実際の誕生日から数えるのが基本ですが、発育や退院時期に合わせて遅らせて問題ありません。健診や予防接種の時期は医師の指示に従ってください。</li>
      <li><strong>月末生まれで「生後◯か月」の日がない</strong> — たとえば1月31日生まれの場合、2月に31日はありません。本ツールでは、その月の末日（2月28日または29日）をもって1か月とみなして計算しています。</li>
      <li><strong>100日目が平日で、両家の予定が合わない</strong> — 前後の土日どちらでもかまいません。「食い延ばし」を願って後ろにずらす考え方もあるので、無理に前倒しする必要はありません。</li>
      <li><strong>双子で誕生日が日をまたいだ</strong> — 深夜の出産で兄姉と弟妹の誕生日が1日違うことがあります。行事はまとめて行うのが一般的で、どちらかの日付に合わせれば十分です。</li>
    </ul>
  </Fragment>
</ToolLayout>

<script>
  import { parseYmd, toYmd, babyAge, babyEvents } from "../lib/dateCore.js";
  import { milestoneTableHTML, shareButtonHTML, bindShareButtons, getParam, setParams } from "../lib/ui.js";

  const $ = (id) => document.getElementById(id);
  const result = $("result");

  function run() {
    const v = $("birth-date").value;
    if (!v) return;
    const birth = parseYmd(v);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    if (birth > today) {
      result.innerHTML = `<p class="result-note">誕生日が未来の日付です。出産予定日までのお祝い日一覧として表示します。</p>` + eventsHTML(birth);
      bindShareButtons(result);
      setParams({ d: toYmd(birth) });
      return;
    }
    const a = babyAge(birth, today);
    result.innerHTML = `
      <div class="result-big">今日で生後 ${a.days}日</div>
      <p class="result-caption">生後${a.weeks}週${a.weekDays}日 ／ 生後${a.months}か月${a.monthRemainderDays}日（母子手帳と同じ0日起算）</p>
      ${eventsHTML(birth)}
      ${shareButtonHTML()}`;
    bindShareButtons(result);
    setParams({ d: toYmd(birth) });
  }

  function eventsHTML(birth) {
    return milestoneTableHTML(babyEvents(birth), { firstColLabel: "お祝い行事" }) +
      `<p class="result-note">行事の日付は、生まれた日を1日目とする慣例の数え方です。時期は目安であり、地域差があります。</p>`;
  }

  $("calc-btn").addEventListener("click", run);
  const p = getParam("d");
  if (p) {
    $("birth-date").value = p;
    run();
  }
</script>
