---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import DayCountFigure from "../../components/DayCountFigure.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "起算日は契約日ではなく<strong>法定書面を受け取った日</strong>。その日を<strong>1日目</strong>として数える（初日算入）",
  "8日目が土日祝でも<strong>期限は延びない</strong>。ただし期間内に通知を<strong>発信</strong>すればよい（発信主義）",
  "マルチ商法（連鎖販売取引）などは<strong>20日間</strong>。通信販売にはクーリングオフ制度自体がない",
  "書面に不備があれば期間は進行しない。8日を過ぎていても<strong>消費者ホットライン188</strong>に相談を",
];

const faqs = [
  {
    q: "契約した日と書面を受け取った日が違うときは、どちらから数えますか？",
    a: "法定書面を受け取った日から数えます。電話勧誘販売のように契約から数日後に書面が郵送されてくる取引では、契約日ではなく書面が手元に届いた日が1日目です。届いた日がわかる封筒や配達記録は捨てずに残しておくと安心です。",
  },
  {
    q: "8日目が日曜日でした。月曜日に出しても間に合いますか？",
    a: "一般には延びないと考えられています。クーリングオフの期間は末日が休日でも延長されないと解されているため、日曜日が8日目ならその日までに発信する必要があります。はがきは日曜日でもポストに投函すれば消印が付きますし、メールやウェブフォームなら送信日時が記録に残ります。",
  },
  {
    q: "通知はメールでもよいのですか？",
    a: "2022年6月以降は、メールや事業者が用意したウェブフォームなど電磁的記録による通知も認められています。ただし送った証拠が残るように、送信メールの保存やフォーム送信画面のスクリーンショットを取っておいてください。確実さを重視するなら、はがきの特定記録郵便と併用する方法もあります。",
  },
  {
    q: "ネット通販で買ったものはクーリングオフできますか？",
    a: "できません。通信販売は自分の意思で申し込む取引とされ、特定商取引法のクーリングオフの対象外です。返品できるかどうかは、そのショップの返品特約の記載によります。返品特約の表示がない場合は、商品到着から8日以内であれば送料自己負担で返品できるという法定返品権のしくみがあります。",
  },
];

const sources = [
  REFS.tokushoHo,
  REFS.caaCoolingOff,
  REFS.kokusen,
  REFS.minpo,
];

const related = [
  { href: "/cooling-off/", label: "クーリングオフ期限の計算 — 受領日と取引の種類を選ぶだけで期限日を表示" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」— 日数の数え方の基本" },
  { href: "/column/eigyobi-inai/", label: "コラム: 「3営業日以内」はいつまで？営業日の数え方" },
  { href: "/eigyobi/", label: "営業日計算 — 土日祝を除いた期限を確認" },
];
---

<ColumnLayout
  title="クーリングオフの期限の数え方 — 8日目が日曜日でも延びない？"
  description="クーリングオフは書面受領日を1日目として8日間（取引によって20日間）。期限日が土日祝でも延長されない代わりに「期間内に発信すればよい」というルールを、数え方の具体例つきで解説します。"
  lead="「契約から8日以内」とよく言われるクーリングオフ。この8日間は、いつから数えて、いつまでなのでしょうか。期限日が休日だった場合の扱いも含めて、数え方を正確に押さえておきましょう。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>起算日は「書面を受け取った日」、そして初日算入</h2>
  <p>
    クーリングオフの期間は、契約した日ではなく、<strong>契約内容を記載した法定書面（または電磁的記録）を受け取った日</strong>から始まります。そしてこの期間は、法律の原則（初日不算入）の例外で、<strong>受領日そのものを1日目として数えます</strong>。特定商取引法の条文は「書面を受領した日から起算して8日を経過するまで」という書き方になっており、「受領した日から起算」という一言が初日算入を意味しています。
  </p>
  <DayCountFigure
    startLabel="書面受領日"
    days={8}
    mode="include"
    highlight={8}
    caption="書面を受け取った日が1日目。8日目（受領日＋7日）が期限日で、この日までに通知を発信すればよい。"
  />
  <p>
    たとえば7月1日（水）に訪問販売で契約し、その場で書面を受け取った場合、1日目が7月1日、8日目は7月8日（水）。<strong>7月8日までに通知を発信すれば</strong>クーリングオフできます。「受領日＋8日」と勘違いすると1日遅れてしまうので注意してください（正しくは受領日＋7日が期限日です）。
  </p>
  <p>
    なぜ契約日ではなく書面の受領日なのでしょうか。クーリングオフは「冷静に考え直す期間」を保証する制度なので、考え直すための材料である契約内容の書面が手元にあることが前提だからです。訪問販売では契約と同時に書面を渡されることが多いので契約日＝受領日になりますが、電話勧誘販売では契約後に書面が郵送されてくるため、<strong>契約日より数日遅れて期間が始まる</strong>ことになります。封筒の消印や配達記録は、起算日を証明する材料になるので保管しておきましょう。
  </p>
  <p class="small">
    なお、書面の記載に不備がある場合や、そもそも書面を受け取っていない場合は、期間は進行しません。8日を過ぎていてもあきらめる前に消費生活センター（電話番号188）に相談を。
  </p>

  <h2>期限日が休日でも延びない — 代わりに「発信主義」</h2>
  <p>
    一般の法律上の期間は、期限日が土日祝にあたると翌開庁日まで延びることがあります（民法142条）。しかしクーリングオフの期間は<strong>休日でも延長されません</strong>。8日目が日曜日なら、その日曜日が期限です。民法142条は「その日に取引をしない慣習がある場合」に限って末日を延ばす規定であり、はがきの投函やメールの送信は休日でもできるので、延ばす理由がないと考えられているためです。
  </p>
  <p>
    その代わり、クーリングオフの通知は<strong>期間内に「発信」すれば有効</strong>です（発信主義）。相手に届くのは期限を過ぎてからでも構いません。はがきなら期限日の消印が付けばよいので、8日目が日曜日でも、郵便ポストに投函すれば間に合います。2022年6月からは、<strong>メールや事業者のウェブフォームなど電磁的記録による通知</strong>も認められています。
  </p>

  <h2>期限日の計算例 — 曜日別に見る</h2>
  <table class="milestones">
    <tr><th>書面受領日（1日目）</th><th>8日目（期限日）</th><th>注意点</th></tr>
    <tr><td>7月1日（水）</td><td class="date-cell">7月8日（水）</td><td>平日どうし。特に迷わない</td></tr>
    <tr><td>7月4日（土）</td><td class="date-cell">7月11日（土）</td><td>受領日と同じ曜日が期限日。土曜日でも延びない</td></tr>
    <tr><td>8月7日（金）</td><td class="date-cell">8月14日（金）</td><td>お盆期間でも延びない。事業者が休みでも発信はできる</td></tr>
    <tr><td>12月26日（土）</td><td class="date-cell">1月2日（土）</td><td>年末年始をまたぐ。郵便局の窓口は休みでもポスト投函は可能</td></tr>
    <tr><td>4月25日（土）・連鎖販売取引（20日間）</td><td class="date-cell">5月14日（木）</td><td>受領日＋19日。ゴールデンウィークをまたいでも延びない</td></tr>
  </table>
  <p>
    表からわかるように、8日間の期限日は<strong>受領日と同じ曜日</strong>になります。水曜日に受け取ったなら翌週の水曜日、土曜日なら翌週の土曜日が期限です。この「同じ曜日」という覚え方は、カレンダーを見なくても期限日を把握できるので便利です。20日間の取引では、受領日＋19日なので受領日の曜日から2日戻った曜日（土曜日受領なら木曜日）になります。
  </p>

  <h2>取引ごとの期間一覧</h2>
  <table class="milestones">
    <tr><th>取引の種類</th><th>期間</th></tr>
    <tr><td>訪問販売（キャッチセールス・アポイントメントセールス含む）</td><td class="date-cell">8日間</td></tr>
    <tr><td>電話勧誘販売</td><td class="date-cell">8日間</td></tr>
    <tr><td>特定継続的役務提供（エステ・美容医療・語学教室・家庭教師・学習塾・パソコン教室・結婚相手紹介サービス）</td><td class="date-cell">8日間</td></tr>
    <tr><td>訪問購入（貴金属の押し買いなど）</td><td class="date-cell">8日間</td></tr>
    <tr><td>連鎖販売取引（マルチ商法）</td><td class="date-cell">20日間</td></tr>
    <tr><td>業務提供誘引販売取引（内職・モニター商法）</td><td class="date-cell">20日間</td></tr>
  </table>
  <p>
    連鎖販売取引と業務提供誘引販売取引が20日間と長いのは、「自分も販売員になって収入を得る」というビジネスの側面を持ち、契約内容が複雑で判断に時間がかかるためです。
  </p>
  <p>
    <strong>通信販売（ネット通販含む）にはクーリングオフ制度はありません</strong>。返品できるかどうかは各ショップの返品特約によります。また、自分から店舗に出向いて買った場合も原則対象外です。ただし、路上で呼び止められて店舗に連れて行かれた場合（キャッチセールス）や、「当選しました」と呼び出されて契約した場合（アポイントメントセールス）は、店舗での契約でも訪問販売として扱われます。
  </p>

  <h2>通知するときの実務ポイント</h2>
  <ol class="calc-steps">
    <li>契約書面に書かれている<strong>事業者名・住所・契約日・商品名・金額</strong>を確認し、クーリングオフの案内欄（赤枠で記載されていることが多い）を読む。</li>
    <li>はがきに「契約を解除します」という趣旨と、契約日・商品名・金額・自分の氏名住所を書く。理由を書く必要はない。</li>
    <li>はがきの<strong>両面のコピー</strong>を取り、特定記録郵便や簡易書留で送る。発信日の証明が残る方法を選ぶ。</li>
    <li>クレジット契約を組んでいる場合は、販売会社だけでなく<strong>クレジット会社にも</strong>同時に通知する。</li>
    <li>コピー・受領証・封筒などの証拠を、返金が完了するまで保管する。</li>
  </ol>
  <p>
    書き方に迷ったら、消費生活センター（188）に電話すればひな形を教えてもらえます。メールで通知する場合は、送信メールを削除せずに残し、可能ならフォームの送信完了画面も保存しておきます。「期限日ぎりぎりに送ったが、事業者側で受信の記録がない」と言われるトラブルを避けるため、期限に余裕がある段階で送ってしまうのが一番の安全策です。
  </p>

  <h2>期限を過ぎてしまったときは</h2>
  <p>
    8日目を1日過ぎてしまったからといって、必ずしも手遅れとは限りません。まず確認したいのは<strong>書面の不備</strong>です。法定書面には、商品名・金額・支払方法・事業者の連絡先・クーリングオフの説明などの記載事項が定められていて、これらが欠けている書面は「法定書面を受け取った」ことになりません。書面に不備があれば期間はまだ始まっていないと解されており、8日を過ぎていてもクーリングオフできる可能性があります。事業者が「クーリングオフはできない」と嘘を言って妨害した場合や、威圧して困惑させた場合も同様に、期間は進行しません。
  </p>
  <p>
    期間を過ぎていても、契約内容によっては<strong>中途解約</strong>や、不実の説明があった場合の<strong>取消し</strong>など別の手段があります。契約書面を手元に用意して188に電話すれば、最寄りの消費生活センターにつながります。
  </p>
</ColumnLayout>
