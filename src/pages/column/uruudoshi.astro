---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "うるう年は4年に1度。ただし<strong>100で割り切れる年は平年、400で割り切れる年はうるう年</strong>",
  "2月29日生まれも<strong>毎年1歳ずつ</strong>年を取る（平年は2月28日の終了時に加齢。年齢計算ニ関スル法律・民法143条）",
  "運転免許の更新など、行政手続きでは平年の誕生日を<strong>2月28日とみなす</strong>扱いがある",
  "2月29日を挟むと「1周年」は<strong>367日目</strong>になり、日数の節目とずれる",
];

const faqs = [
  {
    q: "2月29日生まれの人は、平年には何月何日に年を取りますか？",
    a: "法律上は2月28日が終わる瞬間（3月1日になる直前）に1歳加わります。年齢は誕生日の前日の終了時に加算されるのが原則で、平年には2月29日に対応する日がないため、民法の規定により2月の末日である28日の終了時に満了するからです。うるう年には通常どおり2月28日の終了時に加齢するので、結局どの年も同じタイミングです。",
  },
  {
    q: "2000年はうるう年でしたが、2100年はどうなりますか？",
    a: "2100年は平年です。4で割り切れる年は原則うるう年ですが、100で割り切れる年は例外として平年になります。2000年は400でも割り切れるため「例外の例外」としてうるう年でした。次にこの規則が働くのは2100年で、この年の2月は28日までしかありません。",
  },
  {
    q: "2月29日生まれの人の運転免許の更新はいつですか？",
    a: "道路交通法では、2月29日生まれの人の誕生日を平年は2月28日とみなす規定があります。免許証の有効期間は誕生日の1か月後の日までなので、平年であれば3月28日ごろまでが更新期限になります。実際の期限は免許証の有効期間欄に記載されているので、そちらを確認してください。",
  },
  {
    q: "記念日から「1周年」と「365日目」はなぜずれるのですか？",
    a: "1周年は暦の上で同じ月日に戻る日で、開始日を1日目と数えると通常366日目に当たります。間に2月29日を挟む場合は367日目です。一方「365日目」は開始日から364日後の日で、周年の前日か前々日になります。日数の節目と暦の節目は別物なので、両方を祝いたい場合は別々に計算する必要があります。",
  },
];

const sources = [REFS.nenreiHo, REFS.minpo, REFS.naoKoyomi];

const related = [
  { href: "/kinenbi/", label: "記念日カウンター — 100日目・1000日目・◯周年をうるう年込みで正確に計算" },
  { href: "/seigo/", label: "生後日数計算 — 赤ちゃんの日数・週数・月齢を自動計算" },
  { href: "/column/hayaumare/", label: "コラム: 4月1日生まれはなぜ早生まれ？「誕生日前日に年を取る」しくみ" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」— 日数の数え方の基本" },
];
---

<ColumnLayout
  title="うるう年のしくみ — 2月29日生まれの誕生日と年齢はどうなる？"
  description="うるう年はなぜ4年に1度？100年に1度の例外とは？2月29日生まれの人の年齢が法律上どう数えられるか、運転免許の更新などの実務、記念日や周年の計算がどうずれるかまで、うるう年の疑問をまとめて解説します。"
  lead="4年に1度やってくる2月29日。「うるう年生まれの人は4年に1歳しか年を取らない？」という定番の疑問から、免許更新などの実務、記念日計算での1日のずれまで、うるう年にまつわる日付の話をまとめました。"
  published="2026-07-05"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>なぜうるう年があるのか</h2>
  <p>
    地球が太陽のまわりを1周する時間は、ちょうど365日ではなく<strong>約365.2422日</strong>です。毎年約0.24日（約6時間）ずつ暦が季節より先に進んでしまうため、4年に1度、1日を足して調整します。これがうるう年です。
  </p>
  <p>
    ただし0.2422×4は約0.97日で、1日にわずかに足りません。4年に1度だけ足し続けると、今度は逆に約128年で1日ずつ暦が季節より遅れていきます。そこで現在の暦（グレゴリオ暦）には例外のルールがあります。
  </p>
  <ul>
    <li><strong>4で割り切れる年</strong>はうるう年（2024年、2028年…）</li>
    <li>ただし<strong>100で割り切れる年</strong>は平年（1900年、2100年）</li>
    <li>さらに<strong>400で割り切れる年</strong>はうるう年（2000年はこの例外の例外で、うるう年でした）</li>
  </ul>
  <p>
    この3段構えで400年間のうるう年は97回となり、1年の平均は365.2425日、暦と季節のずれは約3,200年に1日程度まで抑えられています。日本がこの暦を採用したのは1873年（明治6年）で、それまでの旧暦（太陰太陽暦）では、日ではなく「閏月」という丸ひと月を約3年に一度挿入して季節とのずれを調整していました。
  </p>
  <table class="milestones">
    <tr><th>年</th><th>判定</th><th>理由</th></tr>
    <tr><td>2024年</td><td class="date-cell">うるう年</td><td>4で割り切れる</td></tr>
    <tr><td>2026年</td><td class="date-cell">平年</td><td>4で割り切れない</td></tr>
    <tr><td>2028年</td><td class="date-cell">うるう年</td><td>4で割り切れる</td></tr>
    <tr><td>2000年</td><td class="date-cell">うるう年</td><td>100で割り切れるが、400でも割り切れる</td></tr>
    <tr><td>2100年</td><td class="date-cell">平年</td><td>100で割り切れ、400では割り切れない</td></tr>
  </table>

  <h2>2月29日生まれの年齢 — 4年に1歳ではありません</h2>
  <p>
    日本の法律では、年齢は出生日から起算し、誕生日当日ではなく<strong>誕生日の前日が終わった瞬間</strong>に1歳加わると定められています（年齢計算ニ関スル法律、民法143条）。2月29日生まれの人については、民法143条2項に「応当する日がないときはその月の末日に満了する」という規定があるため、平年でも<strong>2月28日の終了時</strong>に年を取ります。毎年きちんと1歳ずつ加齢するので、「4年に1歳」は法律上はあり得ない、というわけです。
  </p>
  <p>
    少し細かい話ですが、うるう年の2月29日生まれは「前日の終了時」の原則どおり2月28日の終了時に加齢します。つまり2月29日生まれの人は、うるう年でも平年でも<strong>2月28日の終わりに年を取る</strong>ことになり、加齢のタイミングは毎年変わりません。一方、3月1日生まれの人はうるう年には2月29日の終了時、平年には2月28日の終了時に加齢するので、平年に限れば2月29日生まれと3月1日生まれは同じ瞬間に年を取ります。
  </p>
  <table class="milestones">
    <tr><th>誕生日</th><th>平年に年を取る瞬間</th><th>うるう年に年を取る瞬間</th></tr>
    <tr><td>2月28日</td><td class="date-cell">2月27日の終了時</td><td>2月27日の終了時</td></tr>
    <tr><td>2月29日</td><td class="date-cell">2月28日の終了時</td><td>2月28日の終了時</td></tr>
    <tr><td>3月1日</td><td class="date-cell">2月28日の終了時</td><td>2月29日の終了時</td></tr>
  </table>
  <p>
    この「前日の終わりに年を取る」ルールは、4月1日生まれが「早生まれ」になる理由でもあります。4月1日生まれは3月31日の終了時に年を取るため、学年の区切り（4月1日をまたぐ時点）では前の学年に入ります。詳しくは<a href="/column/hayaumare/">早生まれのコラム</a>で解説しています。
  </p>

  <h2>2月29日生まれの実務 — 免許更新・各種手続き</h2>
  <p>
    年齢の計算は上のとおり法律で決まっていますが、「誕生日」そのものを基準にする手続きでは、平年に2月29日が存在しないことが問題になります。代表的なのが運転免許証です。道路交通法には、<strong>2月29日生まれの人の誕生日は平年は2月28日とみなす</strong>という規定があり、免許証の有効期間（誕生日の1か月後まで）はこれをもとに計算されます。更新のお知らせはがきや免許証の有効期間欄には具体的な日付が書かれているので、実際にはそれに従えば問題ありません。
  </p>
  <p>
    このほか、年金や各種の年齢要件は「◯歳に達した日」を基準にすることが多く、これは法律上の加齢の瞬間、つまり誕生日の前日を指します。2月29日生まれなら平年・うるう年とも2月28日です。誕生日にサービスを受けられる会員特典のようなものは、事業者ごとに2月28日扱い、3月1日扱い、うるう年のみ、と対応が分かれます。お祝いする日も2月28日派と3月1日派に分かれるようですが、こちらは完全に自由です。
  </p>
  <div class="note-box">
    <p class="small">
      「本当の誕生日」が4年に1度しか来ないため、2月29日生まれの人が2月29日を迎える回数は、たとえば2024年2月29日生まれなら次が2028年（1,461日後）、その次が2032年です。80歳になるまでに20回もありません（2100年は平年なので、さらに1回減ります）。
    </p>
  </div>

  <h2>記念日・周年の計算でのずれ</h2>
  <p>
    うるう年は日数計算にも影響します。「1周年」と「365日目」は普段でも1日ずれますが（開始日を1日目と数えると1周年は366日目）、<strong>間にうるう年の2月29日を挟むと、1周年が367日目になる</strong>ため、ずれはさらに1日広がります。
  </p>
  <table class="milestones">
    <tr><th>数え方</th><th>基準</th><th>うるう年の影響</th></tr>
    <tr><td>◯日目・◯日後</td><td>実際の日数</td><td>2月29日も1日として数える</td></tr>
    <tr><td>◯周年・◯歳</td><td>暦の同じ月日</td><td>2月29日を挟むと日数換算で1日増える</td></tr>
  </table>
  <p>
    具体例で見てみましょう。2023年6月1日を起点にすると、1周年の2024年6月1日は間に2024年2月29日を挟むので367日目、365日目は2024年5月30日です。2周年の2025年6月1日は732日目で、「2年＝730日」とは2日ずれています。10周年ともなると、うるう年を2〜3回挟むため「10年＝3,650日」より2〜3日多くなります。「付き合って1000日」のような日数の節目と、「3周年」のような暦の節目は、この理由で少しずつずれていくのです。
  </p>
  <p>
    日数のずれは、期限の計算にも顔を出します。「契約日から1年間」のように年単位で定めた期間は、日数ではなく暦に従って翌年の対応する日を基準に満了するため（民法143条）、間の日数が365日でも366日でも末日は変わりません。逆に「契約日から365日」と日数で定めた期間は、2月29日を挟むと暦の1年より1日早く終わります。どちらの書き方になっているかで末日が変わる点は、うるう年の年に特に注意が必要です。
  </p>
  <p>
    当サイトの<a href="/kinenbi/">記念日カウンター</a>は、日数の節目も周年も実際の暦で計算するので、うるう年のことを意識せずに正確な日付がわかります。
  </p>
</ColumnLayout>
