---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "「3営業日前」＝基準日の当日を数えずに、<strong>営業日（土日祝を除いた日）を3つさかのぼった日</strong>",
  "月曜日の3営業日前は<strong>前の週の水曜日</strong>。暦の上では5日前になる",
  "「3営業日前<strong>まで</strong>」は、その日の営業時間内（指定があればその時刻）まで。祝日を挟むとさらに前にずれる",
  "予約のキャンセル・振込・書類提出では、相手が<strong>どのカレンダーで営業日を数えているか</strong>が答えを決める",
];

const faqs = [
  {
    q: "「3営業日前」とは、具体的にいつのことですか？",
    a: "基準になる日（予約日・締切日・入金日など）の当日を数えずに、土日祝を除いた営業日を1日ずつさかのぼって3つ目の日です。たとえば基準日が月曜日なら、金曜日（1営業日前）・木曜日（2営業日前）・水曜日（3営業日前）と数えて、前の週の水曜日が3営業日前です。",
  },
  {
    q: "土曜日の予約の3営業日前はいつですか？",
    a: "土曜日・日曜日は営業日ではないので飛ばして数えます。土曜日の予約なら、金曜日（1）・木曜日（2）・水曜日（3）で、同じ週の水曜日が3営業日前です。日曜日の予約でも、土曜日を飛ばして金・木・水と数えるので、やはり水曜日になります。ただし土曜日も営業している店舗やホテルでは、土曜日を1営業日として数える場合があります。",
  },
  {
    q: "「3営業日前まで」に当日は含まれますか？",
    a: "3営業日前にあたる日の営業時間内であれば、その日に手続きしても「3営業日前まで」に間に合うのが一般的な解釈です。ただし「3営業日前の17時まで」のように時刻が指定されていればそれに従い、指定がない場合も相手の営業終了時刻（銀行なら窓口の締め時刻）が実質的な期限になります。余裕を見るなら、その前日までに済ませておくのが安全です。",
  },
  {
    q: "祝日を挟むとどうなりますか？",
    a: "祝日は営業日ではないので、土日と同じように飛ばして数えます。たとえば月曜日が祝日なら、火曜日の3営業日前は、月曜（祝日）を飛ばして前週の金・木・水と数え、前週の水曜日になります。暦の上では6日前です。連休を挟むと1週間以上前になることもあるので、当サイトの営業日計算ツールで確認するのが確実です。",
  },
  {
    q: "「3営業日前」と「3営業日以内」はどう違いますか？",
    a: "向きが逆です。「3営業日前」は基準日からさかのぼる締切（それ以前に済ませる）で、「3営業日以内」は起点から先に進む期限（それまでに済ませる）です。どちらも起点の当日を数えないのが一般的で、数え方は同じですが、カレンダー上で過去に向かうか未来に向かうかが違います。",
  },
  {
    q: "「4営業日後」「5営業日後」も同じ考え方ですか？",
    a: "同じです。基準日の翌営業日を1日目として、土日祝を飛ばしながら数えます。金曜日の4営業日後は、月（1）・火（2）・水（3）・木（4）で翌週の木曜日です。数が増えるほど土日や祝日を挟みやすくなり、暦の日数との差が開きます。",
  },
];

const sources = [REFS.minpo, REFS.ginkoHo, REFS.gyoseiKyujitsuHo];

const related = [
  { href: "/eigyobi/", label: "営業日計算 — 方向を「営業日前」にして、締切からの逆算を自動計算" },
  { href: "/column/eigyobi-inai/", label: "コラム: 「3営業日以内」はいつまで？営業日の数え方と見落としやすい休業日" },
  { href: "/column/nenmatsu-nenshi/", label: "コラム: 年末年始の営業日はいつまで？2026-27年の銀行・役所カレンダー" },
  { href: "/shukujitsu/", label: "祝日カレンダー — 間に挟まる祝日を先に確認" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」— 日数の数え方の基本" },
];
---

<ColumnLayout
  title="「3営業日前」とはいつ？数え方と曜日別早見表、締切からの逆算"
  description="「3営業日前まで」は基準日を数えずに営業日を3つさかのぼった日。月曜日なら前週の水曜日です。曜日別の早見表、祝日や年末年始を挟む計算例、予約キャンセル・振込・書類提出での注意点を解説します。"
  lead="「キャンセルは3営業日前まで」「3営業日前までにご入金ください」— 締切として書かれることの多い「◯営業日前」。どこから数えて、どの日を指すのか、曜日別に整理します。"
  published="2026-10-31"
  updated="2026-10-31"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>「3営業日前」とは — 基準日を数えずに営業日を3つさかのぼる</h2>
  <p>
    「3営業日前」は、予約日や締切日などの<strong>基準日の当日を数えず</strong>、そこから土日・祝日を飛ばしながら営業日を1つずつさかのぼって、3つ目にあたる日のことです。営業日とは、一般には土曜・日曜・国民の祝日を除いた平日を指します（相手先によっては年末年始や独自の休業日も除きます）。
  </p>
  <p>
    たとえば基準日が月曜日なら、前の金曜日が1営業日前、木曜日が2営業日前、水曜日が3営業日前です。暦の上では5日前ですが、間の土日は数えないので「3営業日」になります。「3日前」と読み違えると、金曜日に手続きをして締切を過ぎていた、ということが起こります。
  </p>
  <table class="milestones">
    <tr><th>基準日</th><th>1営業日前</th><th>2営業日前</th><th>3営業日前</th><th>暦日では</th></tr>
    <tr class="is-main"><td>月曜日</td><td>金曜日</td><td>木曜日</td><td class="date-cell"><strong>前週の水曜日</strong></td><td>5日前</td></tr>
    <tr><td>火曜日</td><td>月曜日</td><td>金曜日</td><td class="date-cell">前週の木曜日</td><td>5日前</td></tr>
    <tr><td>水曜日</td><td>火曜日</td><td>月曜日</td><td class="date-cell">前週の金曜日</td><td>5日前</td></tr>
    <tr><td>木曜日</td><td>水曜日</td><td>火曜日</td><td class="date-cell">同じ週の月曜日</td><td>3日前</td></tr>
    <tr><td>金曜日</td><td>木曜日</td><td>水曜日</td><td class="date-cell">同じ週の火曜日</td><td>3日前</td></tr>
    <tr><td>土曜日</td><td>金曜日</td><td>木曜日</td><td class="date-cell">同じ週の水曜日</td><td>3日前</td></tr>
    <tr><td>日曜日</td><td>金曜日</td><td>木曜日</td><td class="date-cell">同じ週の水曜日</td><td>4日前</td></tr>
  </table>
  <p>
    祝日がない週の早見表です。週の前半が基準日だと土日をまたぐため、暦日では5日前まで戻ります。土曜日・日曜日が基準日の場合（週末のイベントや宿泊など）は、その土日自体も営業日ではないので飛ばし、直前の金曜日から数え始めます。
  </p>

  <h2>「3営業日前まで」の「まで」はいつの時点か</h2>
  <p>
    「3営業日前<strong>まで</strong>にご連絡ください」と書かれている場合、3営業日前にあたる日の営業時間内に連絡すれば間に合う、と読むのが一般的です。ただし次の2点で実質的な期限が前倒しになります。
  </p>
  <ul>
    <li><strong>時刻の指定</strong> — 「3営業日前の17時まで」「前営業日の15時まで」のように時刻が書かれていれば、その時刻が期限です。書かれていなくても、相手の営業終了時刻を過ぎた連絡は翌営業日扱いになることがあります。</li>
    <li><strong>振込の受付締め</strong> — 「3営業日前までにご入金」の場合、銀行の受付締め時刻（15時前後）を過ぎた振込は翌営業日扱いになることがあり、着金が期限を過ぎます。3営業日前の午前中までに手続きするのが安全です。</li>
  </ul>
  <p>
    迷ったときは「◯月◯日の何時まで、という理解でよいですか」と日付と時刻で確認するのが確実です。「3営業日前」という表現自体に、当日を数えるかどうかの曖昧さが残るためです（後述）。
  </p>

  <h2>祝日・連休を挟む計算例 — 2026年の実際の日付で</h2>
  <p>
    祝日は土日と同じく営業日ではないので飛ばします。間に祝日が入るほど、3営業日前は暦の上で遠くなります。
  </p>
  <table class="milestones">
    <tr><th>基準日</th><th>間に挟まる休み</th><th>数え方</th><th>3営業日前</th><th>暦日では</th></tr>
    <tr><td>2026年7月22日（水）</td><td>7月20日 海の日＋土日</td><td>21日（火）→ 17日（金）→ 16日（木）</td><td class="date-cell">7月16日（木）</td><td>6日前</td></tr>
    <tr><td>2026年9月24日（木）</td><td>9月19日〜23日の5連休（敬老の日・国民の休日・秋分の日）</td><td>18日（金）→ 17日（木）→ 16日（水）</td><td class="date-cell">9月16日（水）</td><td>8日前</td></tr>
    <tr><td>2026年5月7日（木）</td><td>5月2日〜6日の連休＋4月29日 昭和の日</td><td>5月1日（金）→ 4月30日（木）→ 4月28日（火）</td><td class="date-cell">4月28日（火）</td><td>9日前</td></tr>
    <tr><td>2026年11月24日（火）</td><td>11月23日 勤労感謝の日＋土日</td><td>20日（金）→ 19日（木）→ 18日（水）</td><td class="date-cell">11月18日（水）</td><td>6日前</td></tr>
    <tr><td>2027年1月4日（月）</td><td>1月1日 元日＋土日（土日祝のみ除く数え方）</td><td>12月31日（木）→ 30日（水）→ 29日（火）</td><td class="date-cell">12月29日（火）</td><td>6日前</td></tr>
  </table>
  <p>
    5月の例では、3営業日前が暦の上では9日前です。ゴールデンウィーク明けの予約や納期を基準にした「3営業日前まで」は、連休に入る前の4月中に済ませる必要があります。シルバーウィークの例も同じで、連休明けの木曜日が基準なら、連休の前の週の水曜日が期限です。
  </p>
  <p>
    最後の年末年始の例は、土日祝だけを除いた計算です。相手が銀行なら12月31日が休業日なので、30日（1）・29日（2）・28日（3）で<strong>12月28日（月）</strong>、役所なら12月29日〜1月3日が休日なので、28日（1）・25日（2）・24日（3）で<strong>12月24日（木）</strong>と、相手によって期限が1週間近く変わります。年末年始の営業日の違いは<a href="/column/nenmatsu-nenshi/">年末年始の営業日はいつまで？</a>で日付ごとにまとめています。
  </p>

  <h2>「3営業日前」「3日前」「3営業日以内」の違い</h2>
  <table class="milestones">
    <tr><th>表現</th><th>数える向き</th><th>土日祝</th><th>月曜日が基準日のとき</th></tr>
    <tr><td>3営業日前</td><td>基準日からさかのぼる</td><td>飛ばす</td><td class="date-cell">前週の水曜日</td></tr>
    <tr><td>3日前</td><td>基準日からさかのぼる</td><td>数える</td><td class="date-cell">前週の金曜日</td></tr>
    <tr><td>3営業日以内・3営業日後</td><td>起点から先へ進む</td><td>飛ばす</td><td class="date-cell">同じ週の木曜日</td></tr>
    <tr><td>前営業日・1営業日前</td><td>基準日からさかのぼる</td><td>飛ばす</td><td class="date-cell">前週の金曜日</td></tr>
  </table>
  <p>
    「3日前」は暦日で数えるので、月曜日の3日前は金曜日です。同じ月曜日でも「3営業日前」なら水曜日と、2日の差があります。キャンセル規定で「3日前」と「3営業日前」のどちらが書かれているかは、必ず確認してください。「3営業日以内」のような先に進む表現の数え方は<a href="/column/eigyobi-inai/">「3営業日以内」はいつまで？</a>で解説しています。
  </p>

  <h2>場面別 — 「◯営業日前」が出てくるところ</h2>
  <ul>
    <li><strong>予約のキャンセル・変更</strong>（ホテル・レストラン・美容院・貸会議室など） — 「3営業日前までは無料、以降はキャンセル料◯%」のように、料金の境目として使われます。営業日の基準はその店の営業日で、土曜営業の店なら土曜日も営業日に数える場合があります。宿泊日が土曜日なら、店の定休日次第で3営業日前が水曜日にも火曜日にもなり得ます。</li>
    <li><strong>振込・入金</strong> — 「ご利用日の3営業日前までにご入金ください」は、着金がその日までに済んでいることを求めています。銀行の営業日（土日祝と12月31日〜1月3日が休業）で数えたうえで、受付締め時刻の前に振り込みます。</li>
    <li><strong>書類の提出・申込</strong> — 「開催日の3営業日前までにお申し込みください」は、提出先の営業日が基準です。役所なら土日祝と12月29日〜1月3日が休日なので、年末は特に前倒しになります。</li>
    <li><strong>株式の権利付最終日</strong> — 配当や株主優待の権利を得るには、権利確定日の<strong>2営業日前</strong>（権利付最終日）までに株式を買っておく必要があります。証券取引所の営業日（土日祝と12月31日〜1月3日が休業）で数えます。</li>
    <li><strong>引っ越し・配送の変更</strong> — 「作業日の2営業日前まで変更可」など。業者の営業日（土日も営業している場合が多い）で数えるので、その会社の営業日カレンダーを確認します。</li>
  </ul>

  <h2>当日を数えるかどうかの曖昧さ</h2>
  <p>
    「3営業日前」は、基準日を数えず前営業日を1営業日前とするのが一般的ですが、法律で統一された数え方ではありません。民法の期間計算では初日を数えない原則（第140条）がありますが、これは期間を「先に進めて」数える場面の規定で、さかのぼる締切には直接の規定がなく、慣行に委ねられています。そのため、まれに基準日の前日を「0営業日前」ではなく「1営業日目」と数える運用もあり、その場合は1日ずれます。
  </p>
  <p>
    もう一つの曖昧さは、基準日が営業日でない場合です。土曜日のイベントの「3営業日前」は、直前の金曜日を1営業日前と数えるのが自然ですが、「基準日の直前の営業日（金曜日）を基準日とみなしてそこから3営業日」と解釈すると火曜日になります。キャンセル料の境目のように影響が大きいときは、「◯日までに連絡すれば無料ですか」と日付で確認しておくのが確実です。
  </p>

  <h2>自分で数える手順と、ツールで確認する方法</h2>
  <ol class="calc-steps">
    <li>基準日（予約日・締切日・入金日）を確認し、その日は数えない。</li>
    <li>相手の休業日を確認する。土日祝だけか、年末年始・お盆・定休日も休みか。</li>
    <li>基準日から1日ずつさかのぼり、休業日を飛ばして営業日だけを1・2・3と数える。</li>
    <li>3つ目の営業日が「3営業日前」。時刻の指定や受付締めがあれば、その時刻までに手続きする。</li>
    <li>影響が大きい場合は、出た日付の1営業日前までに済ませて余裕を持つ。</li>
  </ol>
  <p>
    <a href="/eigyobi/">営業日計算ツール</a>では、起算日に基準日を入れ、営業日数に「3」、方向を「営業日前」にすると、土日と国民の祝日（振替休日・国民の休日を含む）を除いた3営業日前の日付が表示されます。銀行や役所の年末年始休業、会社独自の休業日は除外されないので、その分は手で読み替えてください。
  </p>
</ColumnLayout>
