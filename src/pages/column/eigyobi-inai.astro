---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import DayCountFigure from "../../components/DayCountFigure.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "営業日＝<strong>土日・祝日・その会社の休業日を除いた日</strong>。「3営業日」は週末を挟むと5日以上かかることも",
  "「◯営業日以内」は<strong>翌営業日から数える</strong>のが一般的。ただし会社により異なるので重要な期限は確認を",
  "銀行の休日は土日祝と<strong>12月31日〜1月3日</strong>、役所の休日は土日祝と<strong>12月29日〜1月3日</strong>。年末の2日分がずれる",
  "銀行振込は<strong>15時前後の締め</strong>に注意。金曜の午後に頼むと着金は翌週になることがある",
];

const faqs = [
  {
    q: "金曜日に「3営業日以内に発送」と言われました。いつまでに届きますか？",
    a: "翌営業日から数えるなら月・火・水の3日間で、水曜日までに発送されるという意味です。届く日はそこから配送日数が加わるので、木曜日以降になることもあります。「発送」と「到着」は別の期限なので、必要な日が決まっているなら到着日で確認してください。",
  },
  {
    q: "祝日は営業日に入りますか？",
    a: "一般的な会社や役所、銀行では祝日は休業日なので営業日に入りません。ただし小売店や配送業者、飲食店のように祝日も営業している業種では、その会社の定休日だけを除いて数えます。「営業日」は相手の会社の営業カレンダーを基準にした言葉だと考えてください。",
  },
  {
    q: "12月30日は銀行の営業日ですか？役所は？",
    a: "銀行は12月30日まで窓口を開けており、休みは12月31日から1月3日までです。一方、役所の休日は12月29日から1月3日までなので、12月29日と30日は銀行は営業日、役所は休みという2日間のずれがあります。年末の振込や手続きではこの違いに注意してください。",
  },
  {
    q: "「2営業日前まで」はいつのことですか？",
    a: "たとえば月曜日の予約の2営業日前は、月曜日を数えずに金曜・木曜とさかのぼって木曜日とするのが一般的ですが、金曜日と解釈する運用もあります。キャンセル料が発生する期限のように影響が大きい場合は、「◯日の何時までという理解でよいですか」と具体的に確認するのが確実です。",
  },
];

const sources = [
  REFS.ginkoHo,
  REFS.gyoseiKyujitsuHo,
  REFS.minpo,
];

const related = [
  { href: "/eigyobi/", label: "営業日計算 — 「◯営業日後」の日付と期間内の営業日数を土日祝込みで計算" },
  { href: "/shukujitsu/", label: "祝日カレンダー — 連休の並びを先まで確認" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」— 日数の数え方の基本" },
  { href: "/column/shukujitsu/", label: "コラム: 祝日のしくみ" },
  { href: "/column/cooling-off-kigen/", label: "コラム: クーリングオフの期限の数え方 — 休日でも延びない期限の例" },
];
---

<ColumnLayout
  title="「3営業日以内」はいつまで？営業日の数え方と見落としやすい休業日"
  description="営業日は土日祝を除いた日。「3営業日以内」を数えるときの起算日、銀行の営業日と15時の壁、年末年始・お盆など祝日ではない休業日の落とし穴を具体例で解説します。"
  lead="「3営業日以内に発送します」「2営業日前までにご連絡ください」— ビジネスでも買い物でも頻出する「営業日」。カレンダーの日数とどう違い、どこから数えるのかを整理します。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>営業日とは — 暦日との違い</h2>
  <p>
    営業日は、その会社や役所が<strong>業務を行っている日</strong>のことです。一般的なオフィスなら土日・祝日を除いた平日、小売店なら定休日を除いた日、というように<strong>主体によって変わる</strong>のがポイントです。カレンダー上の日数（暦日）と混同すると、「3日で届くはずが5日かかった」というずれが起きます。
  </p>
  <p>
    たとえば金曜日に「3営業日以内に発送」と案内された場合、翌営業日から数えると月・火・水の3日間で、<strong>水曜日まで</strong>が期限です。暦日ならたった3日でも、週末を挟むと実質5日になります。ゴールデンウィークや年末年始を挟めばさらに延びます。
  </p>
  <DayCountFigure
    startLabel="金曜日"
    days={5}
    mode="exclude"
    highlight={3}
    caption="営業日だけを数えるイメージ。金曜日を数えず、翌営業日の月曜日を1営業日目とすると、3営業日目は水曜日。実際のカレンダーでは間に土日が挟まるので、暦日では5日後にあたる。"
  />
  <p>
    「営業日」は法律で一律に定義された言葉ではなく、会社ごとの営業カレンダーが基準です。同じ「3営業日」でも、土曜日も営業している店舗と土日祝が休みの会社とでは行き着く日が変わります。
  </p>

  <h2>起算日はどこ？ — 「当日」を含むかどうか</h2>
  <p>
    「◯営業日以内」の数え始めは、<strong>依頼・注文の翌営業日から</strong>とするのが一般的です（当日不算入）。法律上の期間計算の原則である初日不算入（民法140条）と同じ考え方で、途中の時刻に受け付けたものを1日分と数えるのは不公平だから、というのが理由です。ただし営業時間内の早い時刻に受け付けたものは当日を1日目と数える運用もあり、<strong>統一されたルールはありません</strong>。振込期限・支払期限・キャンセル期限のように影響が大きいものは、「◯日までという理解でよいですか」と具体的な日付で確認するのが確実です。
  </p>
  <p>
    もう一つの分かれ目は<strong>受付時刻</strong>です。多くの会社は「当日◯時までの受付分は当日扱い、それ以降は翌営業日扱い」という締め時刻を設けています。金曜日の夕方に注文すると、実質的には月曜日の受付として扱われ、そこから翌営業日の火曜日を1営業日目と数えると、3営業日目は木曜日にまで延びます。「金曜日に頼んだのに翌週の木曜日」というずれは、この締め時刻と翌営業日起算が重なって起きるものです。
  </p>
  <p class="small">
    「2営業日<strong>前</strong>まで」のような逆方向の数え方にも同じ曖昧さがあります。月曜日の予約の2営業日前は、木曜日なのか金曜日なのか — こちらも具体的な日付での確認をおすすめします。
  </p>

  <h2>計算例 — 連休をまたぐとどうなるか</h2>
  <table class="milestones">
    <tr><th>受付日</th><th>間に挟まる休み</th><th>3営業日目（翌営業日起算）</th></tr>
    <tr><td>7月10日（金）</td><td>土日</td><td class="date-cell">7月15日（水）</td></tr>
    <tr><td>7月17日（金）</td><td>土日＋海の日（月）</td><td class="date-cell">7月23日（木）</td></tr>
    <tr><td>4月30日（木）</td><td>5月2日〜6日の5連休</td><td class="date-cell">5月8日（金）</td></tr>
    <tr><td>12月28日（月）・銀行の場合</td><td>12月31日〜1月3日</td><td class="date-cell">1月4日（月）</td></tr>
    <tr><td>12月28日（月）・役所の場合</td><td>12月29日〜1月3日</td><td class="date-cell">1月6日（水）</td></tr>
  </table>
  <p>
    同じ「3営業日」でも、暦日では3日から9日まで幅があることがわかります。特に注目したいのが最後の2行で、同じ12月28日に受け付けても、銀行は12月29日・30日を営業日として数えるのに対し、役所は年明けの1月4日からしか数えません。年末に急ぎの手続きをするときは、相手が銀行なのか役所なのか一般の会社なのかで、期限が2日ずれます。
  </p>

  <h2>銀行の営業日 — 15時の壁と年末年始</h2>
  <p>
    銀行の休日は銀行法第15条で定められており、<strong>土日祝と12月31日〜1月3日</strong>が休業日です。つまり12月29日と30日は銀行の営業日で、この2日間は年末の振込や窓口手続きに使えます。振込では、営業日であっても<strong>15時前後の受付締め切り</strong>を過ぎると翌営業日扱いになることがあります（金融機関・振込方法により異なります）。家賃や支払いの「◯日まで着金」を守るには、期限日当日の夕方ではなく、余裕をもった営業日の午前中までに手続きするのが安全です。
  </p>
  <p>
    金曜日の午後は特に落とし穴です。金曜15時を過ぎて他行宛てに振り込んだ場合、翌営業日扱いなら着金は月曜日、月曜日が祝日なら火曜日になります。「金曜日中に振り込んだのだから週末には着いているはず」と思っていると、相手先から「まだ入金がない」と連絡が来ることになります。
  </p>
  <p class="small">
    なお、同一行間やモアタイムシステム対応の銀行同士では24時間即時に振り込まれる場合も増えていますが、相手先口座の銀行によるため「即時のはず」を前提にしないほうが無難です。
  </p>

  <h2>役所の営業日 — 12月29日から休み</h2>
  <p>
    国の行政機関の休日は「行政機関の休日に関する法律」で、<strong>土日祝と12月29日〜1月3日</strong>と定められています。市区町村役場も条例で同じ休日を定めているのが一般的です。銀行より2日早く年末休みに入るため、住民票や印鑑証明などの手続きは12月28日までに済ませる必要があります。また、この法律には、役所への申請などの期限が休日にあたる場合はその翌日を期限とみなす規定もあります。土曜日が期限の届出は月曜日まで受け付けてもらえる、というのはこの規定によるものです。
  </p>

  <h2>見落としやすい「祝日ではない休業日」</h2>
  <ul>
    <li><strong>年末年始</strong> — 12月29日〜1月3日ごろは、祝日は元日だけですが多くの会社・役所が休業します。</li>
    <li><strong>お盆（8月13〜16日ごろ）</strong> — 祝日ではありませんが休業する会社が多い期間です。</li>
    <li><strong>会社独自の休業日</strong> — 創立記念日、夏季一斉休業、倉庫の棚卸し日など。ECサイトでは「営業日カレンダー」が掲載されていることが多いので確認を。</li>
    <li><strong>ゴールデンウィークの飛び石</strong> — 暦の上では平日でも、一斉休暇で休業していることがあります。</li>
  </ul>
  <p>
    これらは当サイトの営業日計算ツールでも自動では除外できません（土日祝のみを除外します）。相手の会社の休業日がわかっている場合は、ツールで出した日付にその日数を足して考えてください。
  </p>

  <h2>締切から逆算するときの手順</h2>
  <ol class="calc-steps">
    <li>相手の営業カレンダーを確認する。土日祝休みか、年末年始・お盆の休業があるか、受付の締め時刻は何時か。</li>
    <li>「◯営業日」が当日を含むのか翌営業日からなのかを、案内文か相手先で確認する。</li>
    <li>締切日から営業日を1日ずつさかのぼり、休みの日を飛ばして依頼すべき日を割り出す。</li>
    <li>出た日付にさらに1営業日の余裕を足し、締め時刻の前に手続きする。</li>
  </ol>
  <p>
    たとえば「25日（金）までに着金」が必要で、振込が翌営業日扱いになる可能性があるなら、木曜日の午前中に振り込むのが安全です。営業日の数え方に曖昧さが残る以上、<strong>1営業日分の余裕を最初から見込んでおく</strong>のが、実務で最も確実な方法です。
  </p>
</ColumnLayout>
