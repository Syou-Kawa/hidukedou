  },
];

const sources = [
  REFS.ginkoHo,
  REFS.gyoseiKyujitsuHo,
  REFS.shukujitsuHo,
  REFS.ntaKigen,
  REFS.jpxCalendar,
];

const related = [
  { href: "/eigyobi/", label: "営業日計算 — 「◯営業日後」の日付を土日祝を除いて計算" },
  { href: "/shukujitsu/", label: "祝日カレンダー — 2027年の祝日と連休を一覧で確認" },
  { href: "/column/eigyobi-inai/", label: "コラム: 「3営業日以内」はいつまで？営業日の数え方と見落としやすい休業日" },
  { href: "/column/shukujitsu/", label: "コラム: 祝日はどうやって決まる？振替休日と国民の休日のしくみ" },
  { href: "/column/cooling-off-kigen/", label: "コラム: クーリングオフの期限の数え方 — 8日目が日曜日でも延びない？" },
];
---

<ColumnLayout
  title="年末年始の営業日はいつまで？2026-27年の銀行・役所カレンダー"
  description="2026年末〜2027年始の役所・銀行・証券取引所の休みを日付ごとに一覧。仕事納めは12月28日、銀行は12月30日まで、再開は1月4日。年内着金の振込期限、年末年始にかかる申請・納税期限の扱いも解説します。"
  lead="年末年始は祝日が元日しかないのに、役所も銀行も数日間閉まります。「いつまで振り込めるか」「期限が1月2日なら延びるのか」を、2026年末から2027年始の実際の曜日に当てはめて整理します。"
  published="2026-10-31"
  updated="2026-10-31"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>2026年末〜2027年始の並び — 祝日は元日だけ</h2>
  <p>
    まず暦の並びを確認します。2026年12月28日は月曜日、2027年1月4日も月曜日です。つまり年末の最終週は<strong>月曜日が1日だけ平日としてあって、火曜日から年末年始の休みに入る</strong>並びで、年明けも月曜日からすぐ通常どおりに戻ります。祝日法上の祝日は1月1日（金）のみで、12月29日〜31日と1月2日〜3日は祝日ではありません。土日祝だけを除く数え方では、年末年始の休みは<strong>1月1日（金）〜3日（日）の3連休</strong>にしかならない、というのが起点です。
  </p>
  <p>
    ところが実際には、役所・銀行・証券取引所・多くの企業がそれぞれ別の根拠で休みます。その違いを日付ごとに並べたのが次の表です。
  </p>

  <h2>日付別カレンダー — 役所・銀行・証券取引所はいつ休み？</h2>
  <table class="milestones">
    <tr><th>日付</th><th>祝日法</th><th>役所（官公庁）</th><th>銀行の窓口</th><th>証券取引所</th><th>一般企業の目安</th></tr>
    <tr><td class="date-cell">12月26日（土）</td><td>土曜</td><td>休</td><td>休</td><td>休</td><td>休</td></tr>
    <tr><td class="date-cell">12月27日（日）</td><td>日曜</td><td>休</td><td>休</td><td>休</td><td>休</td></tr>
    <tr class="is-main"><td class="date-cell">12月28日（月）</td><td>平日</td><td><strong>仕事納め</strong>（開庁）</td><td>営業</td><td>取引あり</td><td>出勤（仕事納めが多い）</td></tr>
    <tr><td class="date-cell">12月29日（火）</td><td>平日</td><td>休（法定）</td><td>営業</td><td>取引あり</td><td>休業が多い</td></tr>
    <tr class="is-main"><td class="date-cell">12月30日（水）</td><td>平日</td><td>休（法定）</td><td><strong>年内最終営業日</strong></td><td><strong>大納会</strong>（年内最終）</td><td>休業が多い</td></tr>
    <tr><td class="date-cell">12月31日（木）</td><td>平日</td><td>休（法定）</td><td>休（法定）</td><td>休</td><td>休</td></tr>
    <tr><td class="date-cell">1月1日（金）</td><td><strong>元日（祝日）</strong></td><td>休</td><td>休</td><td>休</td><td>休</td></tr>
    <tr><td class="date-cell">1月2日（土）</td><td>土曜</td><td>休（法定）</td><td>休（法定）</td><td>休</td><td>休</td></tr>
    <tr><td class="date-cell">1月3日（日）</td><td>日曜</td><td>休（法定）</td><td>休（法定）</td><td>休</td><td>休</td></tr>
    <tr class="is-main"><td class="date-cell">1月4日（月）</td><td>平日</td><td><strong>仕事始め</strong>（開庁）</td><td>営業再開</td><td><strong>大発会</strong></td><td>仕事始めが多い</td></tr>
  </table>
  <p>
    役所の休日は「行政機関の休日に関する法律」で<strong>12月29日〜1月3日</strong>、銀行の休日は銀行法と同法施行令で<strong>12月31日〜1月3日</strong>と決まっています。証券取引所（日本取引所グループ）の休業日も銀行と同じ12月31日〜1月3日で、年内最終取引日の12月30日が大納会、年明け最初の1月4日が大発会です。一般企業は法律上の決まりがなく、官公庁に合わせて12月29日〜1月3日を休業にする会社が多数派です。
  </p>
  <p>
    連休の長さで見ると、役所と多くの企業は<strong>12月29日（火）〜1月3日（日）の6連休</strong>、銀行は<strong>12月31日（木）〜1月3日（日）の4連休</strong>です。前年の2025〜26年は12月27日（土）から1月4日（日）まで役所が9連休でしたから、2026〜27年は比較的短い年末年始といえます。これは12月28日と1月4日がどちらも月曜日に当たり、前後の土日と休みがつながらないためです。
  </p>

  <h2>年内に着金させたい振込は、いつまでにすればよいか</h2>
  <p>
    家賃や取引先への支払いで「12月中に入金してほしい」と言われている場合、鍵になるのは<strong>銀行の年内最終営業日（12月30日）と受付締め時刻</strong>の2つです。他行宛ての振込は、営業日の15時前後（金融機関により異なります）までの受付分が当日扱い、それ以降は翌営業日扱いになるのが従来の原則です。年末年始に当てはめると次のようになります。
  </p>
  <table class="milestones">
    <tr><th>振込の手続き日時</th><th>他行宛ての着金の目安</th><th>備考</th></tr>
    <tr><td>12月28日（月）締め時刻前</td><td class="date-cell">12月28日（月）</td><td>当日扱い</td></tr>
    <tr><td>12月29日（火）締め時刻前</td><td class="date-cell">12月29日（火）</td><td>当日扱い。銀行は営業日</td></tr>
    <tr class="is-main"><td>12月30日（水）締め時刻前</td><td class="date-cell">12月30日（水）</td><td><strong>年内着金の実質的な締め切り</strong></td></tr>
    <tr><td>12月30日（水）締め時刻後</td><td class="date-cell">1月4日（月）</td><td>翌営業日扱い。年をまたぐ</td></tr>
    <tr><td>12月31日（木）〜1月3日（日）</td><td class="date-cell">1月4日（月）</td><td>休業日の受付は翌営業日の予約扱い</td></tr>
    <tr><td>1月4日（月）締め時刻前</td><td class="date-cell">1月4日（月）</td><td>通常どおり</td></tr>
  </table>
  <p>
    近年は全銀システムの24時間即時振込に対応した銀行同士であれば、休業日や締め時刻後でも即時に着金します。ただし振込先の銀行が対応しているかは送る側からは分かりにくく、「即時のはず」を前提にして年明けまで着金しなかった、というトラブルが起こりがちです。相手先の対応状況を確認できない場合は、<strong>12月30日（水）の午前中</strong>までに手続きしておけば、どちらのケースでも年内に着金します。
  </p>
  <p class="small">
    「月末まで」の支払期限は、12月31日が銀行休業日なので、実務上は12月30日が最終日になります。期限日を起点に<a href="/eigyobi/">営業日計算</a>で「1営業日前」を求める方法もありますが、12月31日は祝日法上の平日なのでツールでは営業日として数えられます。銀行の休業日分（12月31日）を1日引いて読み替えてください。
  </p>

  <h2>期限が年末年始にかかったらどうなる？ — 制度ごとの違い</h2>
  <p>
    「期限の日が休みなら翌日に延びる」と一括りにされがちですが、延びるかどうかは<strong>制度ごとに根拠が違います</strong>。2026〜27年の日付で整理します。
  </p>
  <table class="milestones">
    <tr><th>期限の種類</th><th>12月29日〜1月3日に当たった場合</th><th>根拠</th></tr>
    <tr><td>役所への申請・届出の期限</td><td class="date-cell">1月4日（月）に延びる</td><td>行政機関の休日に関する法律。期限が休日に当たるときは休日の翌日が期限</td></tr>
    <tr><td>国税の申告・納付の期限</td><td class="date-cell">1月4日（月）に延びる</td><td>国税通則法第10条第2項。土日祝のほか12月29日〜1月3日も休日として扱う</td></tr>
    <tr><td>契約上の支払期限など（民法の期間）</td><td class="date-cell">契約の定めによる</td><td>民法第142条は「その日に取引をしない慣習がある場合」に翌日満了。年末年始の扱いは契約書・相手先で確認</td></tr>
    <tr><td>クーリングオフの期限</td><td class="date-cell"><strong>延びない</strong></td><td>書面を発信した日が基準（発信主義）。休日でも期限は動かない</td></tr>
  </table>
  <p>
    たとえば12月31日（木）が期限の国税の納付は、12月31日・1月1日・2日・3日がいずれも休日扱いなので、1月4日（月）が期限になります。役所への届出も同じく1月4日です。逆にクーリングオフは、書面の受領日を1日目として8日目が1月2日なら、1月2日中に通知を発信する必要があります。年末年始は郵便局の窓口も休みの局が多いので、簡易書留などを使う場合は12月中に出しておくのが安全です（数え方は<a href="/column/cooling-off-kigen/">クーリングオフの期限の数え方</a>をご覧ください）。
  </p>

  <h2>「3営業日後」が年末年始をまたぐとどうなる？</h2>
  <p>
    営業日で約束された納期や入金は、相手が誰かで行き着く日が変わります。12月28日（月）を起算日に「3営業日後」を求めると次のとおりです。
  </p>
  <table class="milestones">
    <tr><th>数え方</th><th>1営業日目</th><th>2営業日目</th><th>3営業日目</th></tr>
    <tr><td>土日祝のみ除く（<a href="/eigyobi/">営業日計算ツール</a>）</td><td class="date-cell">12月29日（火）</td><td class="date-cell">12月30日（水）</td><td class="date-cell">12月31日（木）</td></tr>
    <tr><td>銀行（12月31日〜1月3日休業）</td><td class="date-cell">12月29日（火）</td><td class="date-cell">12月30日（水）</td><td class="date-cell">1月4日（月）</td></tr>
    <tr><td>役所（12月29日〜1月3日休業）</td><td class="date-cell">1月4日（月）</td><td class="date-cell">1月5日（火）</td><td class="date-cell">1月6日（水）</td></tr>
    <tr><td>12月29日〜1月3日休業の企業</td><td class="date-cell">1月4日（月）</td><td class="date-cell">1月5日（火）</td><td class="date-cell">1月6日（水）</td></tr>
  </table>
  <p>
    同じ「3営業日後」でも、12月31日から1月6日まで1週間近い幅があります。通販の「3営業日以内に発送」が年末にかかる場合は、その店の営業日カレンダーで12月29日以降が休業になっていないかを確認してください。営業日の数え方そのもの（当日を含めるか、翌営業日から数えるか）は<a href="/column/eigyobi-inai/">「3営業日以内」はいつまで？</a>で解説しています。
  </p>

  <h2>年末年始の予定を日付に落とすチェックリスト</h2>
  <ol class="calc-steps">
    <li><strong>12月28日（月）まで</strong>: 役所の窓口手続き（住民票・印鑑証明・各種届出）。年内に必要な書類はこの日までに。</li>
    <li><strong>12月30日（水）の締め時刻まで</strong>: 年内に着金させたい振込。家賃・支払い・寄付（年内の領収日付が必要なもの）はここが実質の締め切り。</li>
    <li><strong>12月30日（水）</strong>: 証券取引所の年内最終取引日（大納会）。年内の受渡しを前提にした取引は、受渡日が年明けになる点に注意。</li>
    <li><strong>1月4日（月）</strong>: 役所・銀行・取引所が一斉に再開。年末年始にかかった申請期限・納税期限はこの日が期限。</li>
    <li><strong>クーリングオフなど延びない期限</strong>: 年末年始に関係なく元の期限どおり。郵便の窓口休業を見込んで早めに発信。</li>
  </ol>
  <p>
    年末年始は「祝日は1日しかないのに、実際の休みは6日ある」という、暦と実務のずれが最も大きい時期です。土日祝だけを除く<a href="/eigyobi/">営業日計算</a>の結果に、相手先の休業日（銀行なら12月31日、役所なら12月29日〜30日）を足して読み替えることを習慣にしておくと、年明けに「まだ届いていない」「期限を過ぎていた」という行き違いを防げます。
  </p>
</ColumnLayout>
