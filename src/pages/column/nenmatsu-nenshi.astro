---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "2026〜27年の年末年始、祝日は<strong>1月1日だけ</strong>。12月29日〜31日・1月2日〜3日は祝日ではないが、役所・銀行は法律で休み",
  "<strong>役所</strong>は12月28日（月）が仕事納め、<strong>銀行</strong>は12月30日（水）まで営業。どちらも<strong>1月4日（月）</strong>から再開",
  "年内に着金させたい振込は<strong>12月30日（水）の受付締め（15時前後）まで</strong>。それ以降は1月4日扱いになることがある",
  "役所の申請期限・国税の納期限が12月29日〜1月3日にかかると<strong>1月4日に延びる</strong>。クーリングオフの期限は延びない",
];

const faqs = [
