---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "六曜は旧暦の月日から<strong>機械的に決まる</strong>単純な循環。占いの結果ではない",
  "計算式は「<strong>旧暦の月＋日を6で割った余り</strong>」。旧暦の月替わりで並びが飛ぶ",
  "<strong>仏教とは無関係</strong>。「友引の葬儀」を避けるのは火葬場の休業日という実務的な事情",
  "法要や自分だけの予定では気にしなくてよい。結婚式だけは親世代に一言確認を",
];

const faqs = [
  {
    q: "六曜は誰が決めているのですか？",
    a: "誰も決めていません。六曜は旧暦の月と日から機械的に導かれるもので、法律や公的機関による定めはありません。旧暦そのものも1873年（明治6年）の改暦で公的な地位を失っており、現在はカレンダー会社などが天文データをもとにそれぞれ計算しています。",
  },
  {
    q: "友引に葬儀をしてはいけないのですか？",
    a: "禁止されているわけではありません。「友を引く」という語呂から避ける風習があり、それに合わせて友引を休業日にしている火葬場が多い、という実務上の事情が主な理由です。火葬場が開いていれば友引の葬儀も可能で、宗教上の問題もありません。地域や葬儀社によって扱いが違うので、確認するのが確実です。",
  },
  {
    q: "大安の中でも時間帯によって吉凶がありますか？",
    a: "一般的には、大安は一日を通して吉、仏滅は一日を通して凶とされ、時間帯の区別はありません。時間帯で吉凶が分かれるとされるのは先勝（午前が吉）、先負（午後が吉）、赤口（正午前後だけ吉）、友引（昼だけ凶）の4つです。いずれも慣習上の目安であり、根拠のある区分ではありません。",
  },
  {
    q: "カレンダーによって六曜が違うことがあるのはなぜですか？",
    a: "六曜のもとになる旧暦の計算方法が完全には統一されていないためです。旧暦の月の境目は新月の時刻で決まり、閏月の入れ方にも解釈の余地があります。多くの日は一致しますが、旧暦の月替わりの前後などでまれに食い違いが生じます。どちらが正しいというものではありません。",
  },
];

const sources = [REFS.naoKoyomi];

const related = [
  { href: "/rokuyo/", label: "六曜カレンダー — 今日の六曜と次の大安がすぐわかる" },
  { href: "/shijukunichi/", label: "四十九日・法要日の計算 — 法要の日取りは六曜より参列しやすさで" },
  { href: "/kinenbi/", label: "記念日カウンター — 入籍日・結婚式の日取り決めのお供に" },
  { href: "/column/ichiryumanbai/", label: "コラム: 一粒万倍日・天赦日とは？六曜との違い" },
  { href: "/column/nyuseki/", label: "コラム: 入籍日はどう決める？" },
];
---

<ColumnLayout
  title="六曜とは？大安・仏滅・友引の意味と、気にしなくてよい場面"
  description="カレンダーに載っている大安・仏滅・友引・先勝・先負・赤口の意味と決まり方（旧暦の月＋日を6で割る）を解説。時間帯による吉凶、結婚式や葬儀でなぜ気にされるのか、仏教と無関係であること、カレンダーごとに表記が違う理由まで、六曜との上手な付き合い方をまとめました。"
  lead="「大安だから安心」「仏滅は避けたい」——カレンダーの隅に書かれた六曜は、日取り選びで今も根強く意識されます。その意味と由来、決まり方の計算式、そして本当に気にすべき場面はどこなのかを整理します。"
  published="2026-07-05"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>六曜の6つの意味と時間帯</h2>
  <table class="milestones">
    <tr><th>六曜</th><th>読み</th><th>一般にいわれる意味</th><th>時間帯</th></tr>
    <tr><td>先勝</td><td>せんしょう・さきがち</td><td>先んずれば勝つ。急ぎごとや訴訟によいとされる</td><td>午前が吉、午後は凶</td></tr>
    <tr><td>友引</td><td>ともびき</td><td>勝負がつかない日。「友を引く」の連想から葬儀を避ける風習がある</td><td>朝晩は吉、昼（11〜13時ごろ）は凶</td></tr>
    <tr><td>先負</td><td>せんぶ・さきまけ</td><td>先んずれば負け。急がず静かに過ごすのがよいとされる</td><td>午前は凶、午後が吉</td></tr>
    <tr><td>仏滅</td><td>ぶつめつ</td><td>万事に凶とされる日。慶事を避ける傾向がある</td><td>終日凶</td></tr>
    <tr><td>大安</td><td>たいあん</td><td>万事に吉とされる日。結婚式・納車・引越しで人気</td><td>終日吉</td></tr>
    <tr><td>赤口</td><td>しゃっこう・しゃっく</td><td>「赤」の連想から火や刃物に注意といわれる</td><td>正午前後（11〜13時ごろ）のみ吉</td></tr>
  </table>
  <p class="small">
    時間帯の区分は慣習上の目安で、書物やカレンダーによって多少異なります。「午前・午後」は正午を境にするのが一般的です。
  </p>

  <h2>六曜はどうやって決まる？ — 旧暦の月＋日を6で割る</h2>
  <p>
    六曜は占いの結果ではなく、<strong>旧暦（太陰太陽暦）の月と日から機械的に決まります</strong>。旧暦1月1日は先勝、2月1日は友引、3月1日は先負、4月1日は仏滅、5月1日は大安、6月1日は赤口と各月の1日の六曜が決まっており、あとは先勝→友引→先負→仏滅→大安→赤口の順に毎日繰り返すだけです。7月1日は再び先勝に戻り、12月1日は赤口です。
  </p>
  <p>
    これを計算式にすると、<strong>旧暦の月と日を足して6で割った余り</strong>で決まります。余りが0なら大安、1なら赤口、2なら先勝、3なら友引、4なら先負、5なら仏滅です。
  </p>
  <ol class="calc-steps">
    <li>調べたい日の旧暦の月日を確認する（例: 旧暦3月15日）。</li>
    <li>月と日を足す（3＋15＝18）。</li>
    <li>6で割った余りを求める（18÷6＝3 余り0）。</li>
    <li>余りを六曜に当てはめる（余り0＝大安）。</li>
  </ol>
  <p>
    たとえば旧暦1月1日は1＋1＝2で先勝、旧暦8月15日（中秋の名月）は8＋15＝23、余り5で仏滅です。旧暦の月内では毎日ひとつずつ進むだけなので、月が変わらない限り六曜は6日周期で規則正しく巡ります。ところが旧暦の月は29日か30日で終わり、翌月1日には月ごとに決まった六曜へ「リセット」されます。このため現在のカレンダーの上では、月の途中で突然並びが飛んだように見えます。不規則に見えるのは新暦の日付で眺めているからで、中身は単純な循環です。
  </p>
  <p>
    なお、旧暦には約3年に一度「閏月」が入り、同じ月が2回続くことがあります。閏月の六曜は、一般的には元の月と同じ数で計算します（閏3月なら3月として扱う）。
  </p>

  <h2>由来 — 意外に新しい暦注</h2>
  <p>
    起源は中国の時刻占いにあるとされ、日本には鎌倉〜室町時代ごろに伝わったといわれています。当初は現在と違う名前のものが含まれ、意味も何度も変わったとされています。現在の6つの名前と順序に落ち着き、庶民の暦に広く載るようになったのは江戸時代末期ごろといわれ、明治の改暦で暦注が公式の暦から外された後も、民間の暦に残って現在まで続いています。「古来の伝統」というよりは、比較的新しい民間の習慣です。
  </p>

  <h2>仏教とは関係がありません</h2>
  <p>
    「仏滅」「友引」という字面から仏教の教えと思われがちですが、<strong>六曜と仏教には本来何の関係もありません</strong>。「仏滅」はもともと「物滅」と書かれていた時期があり、後から仏の字が当てられたものです。「友引」も元は「共引」で、勝負がつかず引き分けという意味でした。仏教の側でも、日の吉凶を選ぶこと自体を戒める宗派が多くあります。
  </p>
  <p>
    それでも「友引の葬儀」が避けられるのは、「友を引く」という語呂の連想に加え、<strong>友引を休業日とする火葬場が多い</strong>という実務的な事情によるものです。逆にいえば、四十九日などの法要は火葬場を使わないため、友引でも仏滅でも差し支えないとされるのが一般的です。お通夜については、友引の翌日に葬儀が集中しやすいという事情から、日程調整に影響することがあります。
  </p>

  <h2>カレンダーによって六曜が違う理由</h2>
  <p>
    同じ日なのに、手帳とカレンダーで六曜が食い違っている、ということがまれに起こります。原因は六曜の計算式ではなく、<strong>もとになる旧暦の側</strong>にあります。旧暦は1873年（明治6年）の改暦で公的な暦ではなくなり、現在は国が「正式な旧暦」を定めているわけではありません。旧暦の月の境目は新月（朔）の瞬間で決まり、閏月をどこに置くかは二十四節気の「中気」との関係で決まりますが、新月の時刻が日付の境目に近い場合や、置閏の規則が例外的な形になる年（2033年の旧暦がその例としてよく知られています）には、計算する人によって旧暦の日付が1日、あるいは1か月ずれることがあります。旧暦がずれれば六曜もずれる、というわけです。
  </p>
  <p>
    また、六曜を載せないカレンダーも増えています。迷信を公的な印刷物に載せることを避ける自治体や、宗教的中立の観点から掲載をやめた企業があるためです。「載っていない」ことに深い意味はありません。
  </p>

  <h2>気にすべきかどうかの現実的な目安</h2>
  <ul>
    <li><strong>自分だけの予定</strong>（記念日のお祝い、納車、引越しなど）— 気にする必要はありません。気になるなら大安を選べば気分よく過ごせる、という程度のものです。</li>
    <li><strong>結婚式・入籍</strong> — 本人たちが気にしなくても、親世代が気にする場合があります。両家に一言確認しておくと後々スムーズです。なお仏滅は式場が空いていて料金が割安なことも多く、あえて選ぶ人もいます。</li>
    <li><strong>葬儀</strong> — 友引は火葬場の休業日と重なることが多いため、日程がずれるのは実務上の理由です。</li>
    <li><strong>法要（四十九日・一周忌など）</strong> — 六曜を気にする必要はないとされるのが一般的です。参列者の集まりやすさを優先しましょう。</li>
    <li><strong>契約・手続き・仕事の締切</strong> — 六曜が法律や取引に影響することはありません。期限は期限です。</li>
  </ul>
  <p>
    結局のところ、六曜は「気にする人がいるかどうか」で扱いが決まるものです。相手のいる行事だけ確認し、それ以外は都合のよい日を選ぶ、というのが現実的な付き合い方です。当サイトの<a href="/rokuyo/">六曜カレンダー</a>では、日付を選ぶだけで六曜と次の大安を確認できます。
  </p>
</ColumnLayout>
