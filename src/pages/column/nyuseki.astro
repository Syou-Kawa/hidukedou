---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "入籍日＝<strong>婚姻届が受理された日</strong>。夜間・休日の提出でも不備がなければその日付になる",
  "大安・一粒万倍日・天赦日は人気だが、<strong>縁起は義務ではない</strong>。仏滅の入籍も何ら問題ない",
  "狙った日付があるなら、<strong>事前に役所で記入内容のチェック</strong>を受けておくのがいちばん確実",
  "長く使う記念日なので「<strong>ふたりが覚えやすいこと</strong>」がいちばん実用的",
];

const faqs = [
  {
    q: "日曜日や祝日に婚姻届を出しても、その日が入籍日になりますか？",
    a: "なります。役所の閉庁日でも夜間・休日窓口で届を預かってもらえ、翌開庁日に審査されます。記載に不備がなければ、預けた日にさかのぼって受理され、その日が婚姻の成立日（入籍日）になります。ただし不備があって受理できない場合は、修正して再提出した日が入籍日になるので注意が必要です。",
  },
  {
    q: "仏滅の日に入籍すると何か問題がありますか？",
    a: "法律上も手続き上も、六曜によって婚姻届の扱いが変わることは一切ありません。六曜は暦注のひとつで、宗教の教義とも関係がありません。気にするかどうかは本人と家族の気持ちの問題なので、両家に六曜を気にする方がいるかどうかだけ、先に確認しておくと安心です。",
  },
  {
    q: "婚姻届に必要なものを教えてください。",
    a: "婚姻届（成年の証人2名の署名入り）と、窓口に来る人の本人確認書類（運転免許証やマイナンバーカードなど）が基本です。戸籍謄本は2024年3月から原則不要になりました。外国籍の方との婚姻など個別の事情がある場合は、必要書類が変わるので事前に役所へ確認してください。",
  },
];

const sources = [REFS.kosekiHo, REFS.naoKoyomi];

const related = [
  { href: "/rokuyo/", label: "六曜カレンダー — 候補日の六曜と次の大安をすぐ確認" },
  { href: "/kinenbi/", label: "記念日カウンター — 入籍日から100日目・1周年の日付を一覧表示" },
  { href: "/shukujitsu/", label: "祝日カレンダー — 祝日に入籍したい場合の候補日探しに" },
  { href: "/column/ichiryumanbai/", label: "コラム: 一粒万倍日・天赦日とは？吉日のしくみをくわしく解説" },
  { href: "/column/rokuyo/", label: "コラム: 六曜とは？大安・仏滅・友引の意味" },
];
---

<ColumnLayout
  title="入籍日はどう決める？大安・一粒万倍日と、六曜より大事なこと"
  description="婚姻届はいつ出しても受理された日が入籍日。大安や一粒万倍日の選び方、仏滅を気にすべきか、夜間・休日に提出した場合の扱い、不備があったときの入籍日、必要書類まで、入籍日の決め方を実務目線で整理します。"
  lead="婚姻届は24時間365日、いつでも提出できます。つまり入籍日は自分たちで自由に選べる記念日です。では、どう選ぶのがよいのでしょうか。暦の吉日の話と、それ以上に大切な「狙った日にきちんと受理してもらう」ための実務を整理します。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>入籍日は「受理された日」</h2>
  <p>
    日本の婚姻は、戸籍法の定めにしたがって<strong>婚姻届を届け出ることによって成立</strong>します（届出婚主義）。結婚式を挙げただけ、指輪を交換しただけでは法律上の夫婦にはならず、逆に式を挙げなくても届が受理されれば夫婦です。そして婚姻の成立日は、<strong>婚姻届が受理された日＝届出の日</strong>です。これがいわゆる「入籍日」です。
  </p>
  <p>
    役所の開庁時間外でも、夜間・休日窓口（守衛室や宿直室など）で届を預かってもらえます。この場合、後日開庁時に担当者が審査し、<strong>書類に不備がなければ預けた日にさかのぼって受理</strong>されます。「大安の日曜日に出したい」「祝日に出したい」といった希望も、この仕組みで実現できます。年末年始やゴールデンウィークのような長期閉庁期間に預けた場合も同じで、審査は連休明けになりますが、受理されれば届出日は預けた日です。
  </p>

  <h2>不備があったときの入籍日はどうなるか</h2>
  <p>
    時間外に預けた届は、その場では中身を審査してもらえません。翌開庁日の審査で不備が見つかった場合の扱いは、不備の程度によって分かれます。
  </p>
  <table class="milestones">
    <tr><th>不備の程度</th><th>典型例</th><th>入籍日への影響</th></tr>
    <tr><td>軽微な誤り</td><td>住所の書き方、続柄の記載、記入漏れなど</td><td class="date-cell">電話などで確認し、その場で補正できれば<strong>届出日はそのまま</strong></td></tr>
    <tr><td>受理できない不備</td><td>証人欄が空欄、証人が未成年、届出人の署名がない、本籍地の記載が確認できない</td><td class="date-cell">届は返却され、<strong>再提出した日が入籍日</strong>になる</td></tr>
    <tr><td>要件を満たさない</td><td>婚姻年齢に達していない、重婚にあたるなど</td><td class="date-cell">受理されない</td></tr>
  </table>
  <p>
    多くの役所では、軽微な誤りなら電話連絡のうえで担当者が補正する、あるいは届出人に来庁して訂正してもらうという運用がされており、この場合は最初に預けた日が届出日として扱われます。ただし、連絡がつかないまま日数が過ぎると受理が遅れる可能性があるので、時間外に提出したあとは<strong>役所からの電話に出られるようにしておく</strong>ことが大切です。日中つながる電話番号を届書の欄外や付箋に書いておく、という一手間が効きます。
  </p>
  <p>
    もっとも確実なのは、提出したい日より前の開庁日に窓口で<strong>記入内容の事前チェック</strong>を受けておくことです。多くの役所で「提出は後日、内容の確認だけ先に」という相談に応じてくれます。チェック済みの届を当日預ければ、不備で日付がずれる心配はほぼなくなります。
  </p>

  <h2>入籍日がずれる原因になりやすい不備</h2>
  <p>
    希望日に受理されず<strong>再提出した日が入籍日になる</strong>典型は、証人2名（成年）の署名欄が埋まっていない、届出人の署名がない、新しい本籍地の記載が確認できない、といった届書そのものの不備です。なお、本籍地以外の役所に出す場合の戸籍謄本の添付は、戸籍法の改正により2024年3月から原則不要になったため、以前ほど差し戻しの原因にはなりません。婚姻できる年齢は2022年4月から男女とも18歳です。
  </p>

  <h2>縁起のよい日の選び方</h2>
  <p>ここからは日付選びの話です。入籍日で人気があるのは、次のような暦の吉日です。</p>
  <table class="milestones">
    <tr><th>吉日</th><th>意味</th><th>頻度の目安</th></tr>
    <tr><td>大安</td><td>六曜で「万事に吉」とされる日</td><td class="date-cell">約6日に1回</td></tr>
    <tr><td>一粒万倍日</td><td>始めたことが万倍に実るとされる日</td><td class="date-cell">月に4〜6回</td></tr>
    <tr><td>天赦日</td><td>暦の上で最上の吉日とされる日</td><td class="date-cell">年に5〜6回</td></tr>
    <tr><td>友引</td><td>「幸せのお裾分け」と解釈され慶事では吉とされる</td><td class="date-cell">約6日に1回</td></tr>
  </table>
  <p>
    「大安×一粒万倍日」「天赦日×一粒万倍日」のように吉日が重なる日は特に人気で、婚姻届の提出が集中して窓口が混み合うこともあります。逆に、こうした日はレストランや式場の予約も取りにくくなるので、お祝いの食事とセットで計画するなら早めの手配をおすすめします。
  </p>
  <p>
    六曜は旧暦の月と日から機械的に決まり、一粒万倍日は二十四節気で区切った月と日の干支の組み合わせで決まります。どちらも「その日の暦」を見ないと分からないので、候補日が決まったら<a href="/rokuyo/">六曜カレンダー</a>などで実際の日付を確認してください。旧暦や二十四節気の基準は国立天文台の暦計算室が公開しています。
  </p>

  <h2>仏滅は避けるべき？</h2>
  <p>
    六曜はもともと中国由来の暦注で、仏教や神道の教義とは関係がありません。科学的な根拠もなく、<strong>役所の手続き上はどの日に出しても効力にいっさい差はありません</strong>。戸籍法にも民法にも、六曜に触れた条文は存在しません。実際、「ふたりの記念日を優先して仏滅に入籍した」という夫婦はめずらしくありませんし、仏滅を「いったん物事が滅んで新しく始まる日」と前向きに解釈する考え方もあります。
  </p>
  <p>
    気になるのは本人たちよりも親世代であることが多いので、両家に六曜を気にする人がいるかどうかだけ、先に確認しておくと後々スムーズです。どうしても大安にこだわる家族がいるなら、「入籍は記念日に、挙式や顔合わせは大安に」と分けるのもひとつの落としどころです。
  </p>

  <h2>いちばん実用的なのは「覚えやすさ」</h2>
  <p>
    入籍日は結婚記念日として何十年も使う日付です。実用面では、縁起よりも<strong>忘れにくさ</strong>で選ぶのが合理的です。よく選ばれるのは次のようなパターンです。
  </p>
  <ul>
    <li><strong>語呂のよい日</strong> — 11月22日（いい夫婦）、1月23日（ワンツースリー）、2月2日・7月7日・11月11日などのぞろ目、3月9日（サンキュー）など</li>
    <li><strong>ふたりに縁のある日</strong> — 付き合った記念日、どちらかの誕生日、出会った日、プロポーズの日</li>
    <li><strong>祝日</strong> — 毎年必ず休みになるので、記念日を一緒に過ごしやすい。ただし祝日は開庁していないので、時間外窓口に預ける形になる</li>
  </ul>
  <p>
    「付き合った記念日と同じ日にすれば記念日がひとつで済む」という声も、「別の日にしてお祝いを2回にしたい」という声もあります。ここは完全に好みの問題です。
  </p>

  <h2>入籍日が決まったら</h2>
  <p>
    日付が決まったら、<a href="/kinenbi/">記念日カウンター</a>で100日目や1周年の日付を確認しておくと、最初の記念日を忘れずに祝えます。銀婚式・金婚式のような遠い周年も、同じ入籍日から暦の上で同じ月日をたどれば求められます。
  </p>
</ColumnLayout>
