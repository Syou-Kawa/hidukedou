---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "法律上、年齢は<strong>誕生日の前日が終わる瞬間</strong>に1つ増える（出生日から起算する初日算入のため）",
  "4月1日生まれは<strong>3月31日に満6歳</strong>になるので、ひとつ上の学年（早生まれ）に入る",
  "早生まれ＝<strong>1月1日〜4月1日生まれ</strong>。学年は「4月2日〜翌年4月1日生まれ」で区切られる",
  "同じしくみで、2月29日生まれも<strong>毎年2月28日</strong>に確実に年を取る",
];

const faqs = [
  {
    q: "早生まれとは、何月何日から何月何日生まれの人のことですか？",
    a: "1月1日から4月1日までに生まれた人を早生まれと呼びます。同じ学年の大半（前年の4月2日〜12月31日生まれ）より暦の年が1つ後なのに同じ学年になるため、「早く生まれた」扱いになるという意味です。4月1日生まれが早生まれに含まれるのは、法律上3月31日に年を取るからです。",
  },
  {
    q: "4月1日生まれの子は、なぜ4月2日生まれの子と学年が違うのですか？",
    a: "年齢計算ニ関スル法律により、年齢は誕生日の前日が終わる瞬間に加算されます。4月1日生まれは3月31日に満6歳に達し、学校教育法17条の「満6歳に達した日の翌日以後における最初の学年の初め」が直後の4月1日になります。4月2日生まれは4月1日に満6歳になるので、翌日以後最初の4月1日は翌年になり、1学年下になります。",
  },
  {
    q: "2月29日生まれは、平年にはいつ年を取りますか？",
    a: "年齢は誕生日の前日である2月28日が終わる瞬間に加算されるので、うるう年でも平年でも毎年2月28日の終わりに1歳増えます。「4年に1回しか年を取らない」ということは法律上ありません。お祝いの誕生日を2月28日にするか3月1日にするかは自由です。",
  },
  {
    q: "早生まれは損だと聞きますが、法律上の不利はありますか？",
    a: "法律上の不利はありません。同じ学年で最大1年近い月齢差があるため、幼少期は体格や発達の差が目立つことがあると言われますが、これは成長とともに縮まります。手当や制度の年齢要件は生年月日で判定されるので、学年が上であることで受給期間が変わるものもありますが、有利・不利は制度によります。",
  },
];

const sources = [REFS.nenreiHo, REFS.gakkoKyoikuHo];

const related = [
  { href: "/nyugaku/", label: "入学・卒業年の計算（学歴早見表） — 早生まれの学年ずれも自動で反映" },
  { href: "/column/uruudoshi/", label: "コラム: うるう年のしくみ — 2月29日生まれの誕生日と年齢" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」— 日数の数え方の基本" },
  { href: "/column/wareki-seireki/", label: "コラム: 和暦・西暦の変換 — 生年から入学年を出すときに" },
];
---

<ColumnLayout
  title="4月1日生まれはなぜ早生まれ？法律の「誕生日前日に年を取る」しくみ"
  description="早生まれの境目が「4月1日と4月2日の間」にあるのは、法律上は誕生日の前日が終わる瞬間に年を取るから。年齢計算ニ関スル法律と学校教育法17条のしくみ、早生まれの定義、学年と年齢の関係表、2月29日生まれの扱いをわかりやすく解説します。"
  lead="学年の区切りは4月なのに、早生まれの境目は「4月1日生まれまで」。1日ずれているように見えるこの区切りには、年齢の数え方に関する法律のルールがかかわっています。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>年齢は「誕生日の前日」に増える</h2>
  <p>
    年齢の数え方は「年齢計算ニ関スル法律」という明治時代の法律で定められており、その第1項で<strong>年齢は出生の日から起算する</strong>とされています。つまり生まれた日を1日目と数える<strong>初日算入</strong>方式です。法律の期間計算は民法140条の原則では初日を数えませんが、年齢についてはこの法律が特別に「出生の日から」と定めているわけです。
  </p>
  <p>
    そして同法は、期間の計算について民法の規定を準用しています。民法143条には、週・月・年で定めた期間は、最後の週・月・年において<strong>起算日に応当する日の前日</strong>に満了する、と定められています。「満1年」は、起算日である出生日の応当日（翌年の同じ月日）の前日が終わる瞬間、すなわち午後12時に満了します。
  </p>
  <p>
    このため、法律上は<strong>誕生日の前日が終わった瞬間に1歳年を取る</strong>ことになります。4月2日生まれの人は4月1日の終わりに、4月1日生まれの人は<strong>3月31日の終わりに</strong>年齢が増えるわけです。「誕生日の前日の午後12時」と「誕生日の午前0時」は時刻としては同じ瞬間ですが、法律上は「前日に属する」とされるところがポイントです。
  </p>
  <table class="milestones">
    <tr><th>生年月日</th><th>満6歳に達する日（法律上）</th><th>感覚上の6歳の誕生日</th></tr>
    <tr><td>2020年3月31日</td><td class="date-cell">2026年3月30日</td><td class="date-cell">2026年3月31日</td></tr>
    <tr><td>2020年4月1日</td><td class="date-cell">2026年3月31日</td><td class="date-cell">2026年4月1日</td></tr>
    <tr><td>2020年4月2日</td><td class="date-cell">2026年4月1日</td><td class="date-cell">2026年4月2日</td></tr>
  </table>

  <h2>学年の区切りとつながると「早生まれ」になる</h2>
  <p>
    学校教育法17条は、保護者に「子が<strong>満6歳に達した日の翌日以後</strong>における最初の学年の初め」から小学校に就学させる義務を定めています。学年の初めは4月1日です。ここに先ほどのルールを当てはめると:
  </p>
  <ul>
    <li><strong>4月1日生まれ</strong> — 3月31日に満6歳に達する → その翌日以後最初の4月1日は<strong>直後の4月1日</strong> → 上の学年へ</li>
    <li><strong>4月2日生まれ</strong> — 4月1日に満6歳に達する → 翌日以後最初の4月1日は<strong>翌年の4月1日</strong> → 下の学年へ</li>
  </ul>
  <p>
    上の表の3人で言えば、2020年3月31日生まれと4月1日生まれは2026年4月に入学し、4月2日生まれは2027年4月に入学します。こうして学年は「<strong>4月2日生まれ〜翌年4月1日生まれ</strong>」で区切られます。
  </p>
  <p>
    条文が「満6歳に達した日<strong>の翌日</strong>以後」となっているのは、この年齢のしくみを前提にした書き方です。もし単に「満6歳に達した日以後」であれば、4月2日生まれ（4月1日に満6歳）も直後の4月1日から就学することになり、区切りが1日ずれます。法律の文言と年齢計算のルールがかみ合って、いまの学年の境目ができています。
  </p>

  <h2>早生まれの定義 — 1月1日から4月1日まで</h2>
  <p>
    <strong>早生まれ</strong>とは、一般に<strong>1月1日〜4月1日生まれ</strong>の人を指します。同じ学年の大半（前年の4月2日〜12月31日生まれ）より暦の上では1年遅く生まれているのに、学年上は同じ、つまり「その年に生まれた人の中では早く学校に上がる」ことからこう呼ばれます。反対に4月2日〜12月31日生まれを「遅生まれ」と呼ぶこともあります。
  </p>
  <p>
    たとえば2026年度に小学1年生になるのは、2019年4月2日〜2020年4月1日生まれの子どもです。2020年生まれの子どものうち、1月1日〜4月1日生まれだけが「2019年生まれの学年」に入ります。
  </p>

  <h2>学年と年齢の関係表</h2>
  <p>
    学年の途中で年齢が変わるため、「小学1年生は何歳？」という問いには「6歳または7歳」という答えになります。4月1日時点では全員が同じ年齢で、学年の途中で誕生日を迎えた人から1つ上の年齢になります。早生まれの人は年明けまで誕生日が来ないので、学年の大半を下の年齢で過ごします。
  </p>
  <table class="milestones">
    <tr><th>学年</th><th>4月1日時点の年齢</th><th>年度内に迎える年齢</th><th>2026年度の生年月日の範囲</th></tr>
    <tr><td>小学1年</td><td class="date-cell">6歳</td><td class="date-cell">7歳</td><td>2019年4月2日〜2020年4月1日</td></tr>
    <tr><td>小学6年</td><td class="date-cell">11歳</td><td class="date-cell">12歳</td><td>2014年4月2日〜2015年4月1日</td></tr>
    <tr><td>中学1年</td><td class="date-cell">12歳</td><td class="date-cell">13歳</td><td>2013年4月2日〜2014年4月1日</td></tr>
    <tr><td>中学3年</td><td class="date-cell">14歳</td><td class="date-cell">15歳</td><td>2011年4月2日〜2012年4月1日</td></tr>
    <tr><td>高校1年</td><td class="date-cell">15歳</td><td class="date-cell">16歳</td><td>2010年4月2日〜2011年4月1日</td></tr>
    <tr><td>高校3年</td><td class="date-cell">17歳</td><td class="date-cell">18歳</td><td>2008年4月2日〜2009年4月1日</td></tr>
  </table>
  <p class="small">
    「4月1日時点の年齢」は、4月1日生まれの人も含めて全員が同じです（4月1日生まれは3月31日にその年齢に達しています）。浪人・留年・飛び級などがない場合の目安です。
  </p>
  <p>
    自分の学年を生年月日から求めるには、次の手順で考えます。
  </p>
  <ol class="calc-steps">
    <li>生年月日が1月1日〜4月1日なら、「生まれた年−1」を基準年にする。4月2日〜12月31日なら、生まれた年をそのまま基準年にする。</li>
    <li>基準年＋7年の4月が小学校入学。たとえば2020年3月生まれなら基準年は2019年、入学は2026年4月。</li>
    <li>中学入学は基準年＋13年、高校入学は基準年＋16年、高校卒業は基準年＋19年の3月。</li>
  </ol>
  <p>
    履歴書の学歴欄を書くときは、この計算を毎回するより<a href="/nyugaku/">入学・卒業年の計算</a>で一覧を出すほうが確実です。
  </p>

  <h2>2月29日生まれの誕生日はどうなる？</h2>
  <p>
    「誕生日の前日に年を取る」ルールは、うるう年の2月29日生まれの人にも合理的に働きます。平年には2月29日がありませんが、年齢が増えるのは<strong>前日の2月28日が終わる瞬間</strong>なので、平年でもうるう年でも毎年確実に、同じタイミングで年を取ります。「4年に1回しか年を取らない」ということは法律上ありません。民法143条にも、応当する日がないときは月末に満了する旨の定めがあり、平年の2月については2月28日が満了日になります。
  </p>
  <p class="small">
    お祝いをする「誕生日」をいつにするかは自由ですが、運転免許の更新など公的な手続きでは、平年の場合2月28日を誕生日とみなす扱いが定められているものもあります。
  </p>

  <h2>身近な場面での影響</h2>
  <ul>
    <li><strong>学年の計算</strong> — 履歴書の入学・卒業年は、早生まれかどうかで1年ずれます。同じ「2020年生まれ」でも、3月生まれと5月生まれでは入学年が違います。</li>
    <li><strong>選挙権</strong> — 投票日の翌日が18歳の誕生日の人は、投票日当日の終わりに「満18歳に達する」ため投票できます。選挙のたびに「投票日の翌日生まれまで有権者」という説明がされるのはこのためです。</li>
    <li><strong>年金・手当</strong> — 「◯歳に達した日」を基準にする制度では、誕生日当日ではなく前日が基準になります。1日生まれの人は、前月末日に年齢に達するため、月単位で区切る制度では1か月早く扱いが変わることがあります。</li>
  </ul>
  <p>
    いずれも「誕生日の前日に年を取る」という一つのルールから派生しています。日付にまつわる境目で迷ったら、まず「法律上はいつ満◯歳に達するのか」を前日基準で考えてみてください。
  </p>
</ColumnLayout>
