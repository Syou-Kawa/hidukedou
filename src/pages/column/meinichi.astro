const faqs = [
  {
    q: "三回忌はなぜ亡くなって2年後なのですか？",
    a: "回忌は亡くなった日を1回目の忌日と数える「数え」の方式だからです。亡くなった当日が一回忌、満1年の祥月命日が2回目の忌日（一周忌）、満2年の祥月命日が3回目の忌日（三回忌）にあたります。三回忌以降は「回忌の数から1を引いた年数」が経過した年の祥月命日と覚えると間違えません。",
  },
