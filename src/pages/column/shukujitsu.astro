---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "祝日は<strong>祝日法</strong>で決まる。固定日・ハッピーマンデー・天文計算の3タイプ",
  "振替休日は「必ず翌月曜」<strong>ではない</strong>（その後の祝日でない最も近い日）",
  "春分の日・秋分の日は<strong>前年2月の官報公示</strong>で正式に確定する",
  "振替休日・国民の休日は「祝日」ではなく<strong>「休日」</strong>。会社を休みにする義務は法律にはない",
];

const faqs = [
  {
    q: "祝日が土曜日と重なったら振替休日はありますか？",
    a: "ありません。祝日法の振替休日は「祝日が日曜日に当たるとき」だけを対象にしているため、土曜日と重なった祝日はそのまま消えてしまいます。週休二日制の人にとっては休みが1日減る年になります。",
  },
  {
    q: "来年の春分の日はもう決まっていますか？",
    a: "春分の日と秋分の日は、国立天文台が前年の2月に官報で公示する「暦要項」で正式に決まります。それより先の年については天文計算による予測値で、ほぼ確実ではあるものの法律上は未確定です。カレンダーや手帳の日付は、この予測に基づいて印刷されています。",
  },
  {
    q: "年末年始やお盆は祝日ですか？",
    a: "どちらも祝日ではありません。12月29日から1月3日は「行政機関の休日に関する法律」で役所が閉まる日と定められており、銀行も同様に12月31日から1月3日を休業日としています。お盆については法律上の休日ではなく、企業ごとの夏季休暇です。営業日を数えるときは、この違いを意識してください。",
  },
];

const sources = [
  REFS.shukujitsuHo,
  REFS.caoShukujitsu,
  REFS.naoKoyomi,
];

const related = [
  { href: "/shukujitsu/", label: "祝日カレンダー — 次の祝日・年間の祝日一覧と連休早見表" },
  { href: "/eigyobi/", label: "営業日計算 — ◯営業日後はいつ？" },
  { href: "/column/eigyobi-inai/", label: "コラム: 「◯営業日以内」の数え方" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」日数の数え方の基本" },
];
---

<ColumnLayout
  title="祝日はどうやって決まる？振替休日と国民の休日のしくみ"
  description="国民の祝日は「国民の祝日に関する法律」で決まっています。春分の日・秋分の日が毎年変わる理由、振替休日のルール、祝日にはさまれた平日が休みになる「国民の休日」のしくみ、年によって連休が長くなったり短くなったりする理由を解説します。"
  lead="営業日の計算に欠かせない「祝日」。その日付がどう決まっているのかを知っておくと、カレンダーの見え方が少し変わります。「振替休日は翌月曜日」「春分の日は3月20日」といった思い込みが、期限計算のずれにつながることもあります。"
  published="2026-07-05"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>祝日は法律で決まっている</h2>
  <p>
    国民の祝日は「国民の祝日に関する法律」（祝日法）で定められています。この法律の第2条に祝日の名前と日付が一覧で書かれており、現在は年間16日です。日付の決まり方で分けると、次の3タイプになります。
  </p>
  <table class="milestones">
    <tr><th>タイプ</th><th>決まり方</th><th>該当する祝日</th></tr>
    <tr><td>固定日</td><td class="date-cell">毎年同じ月日</td><td>元日（1月1日）、建国記念の日（2月11日）、天皇誕生日（2月23日）、昭和の日（4月29日）、憲法記念日（5月3日）、みどりの日（5月4日）、こどもの日（5月5日）、山の日（8月11日）、文化の日（11月3日）、勤労感謝の日（11月23日）</td></tr>
    <tr><td>ハッピーマンデー</td><td class="date-cell">「第◯月曜日」</td><td>成人の日（1月第2月曜日）、海の日（7月第3月曜日）、敬老の日（9月第3月曜日）、スポーツの日（10月第2月曜日）</td></tr>
    <tr><td>天文計算</td><td class="date-cell">「春分日」「秋分日」</td><td>春分の日（3月20日か21日ごろ）、秋分の日（9月22日か23日ごろ）</td></tr>
  </table>
  <p>
    細かい点ですが、建国記念の日だけは法律の条文に「2月11日」と直接書かれておらず、「政令で定める日」とされています。実際には政令で2月11日と定められているので、実務上は固定日と同じです。また、祝日の日付は法改正で変わることがあります。近年では2016年に山の日が新設され、2020年に体育の日がスポーツの日に改称されました。東京オリンピックが行われた2020年と2021年には、海の日・スポーツの日・山の日が特例で移動しています。
  </p>

  <h2>ハッピーマンデーで祝日が動く理由</h2>
  <p>
    成人の日はもともと1月15日、海の日は7月20日、敬老の日は9月15日、体育の日は10月10日と、いずれも固定日でした。これを「第◯月曜日」に改めたのが、2000年（成人の日・体育の日）と2003年（海の日・敬老の日）に施行されたハッピーマンデー制度です。土日と合わせて3連休を作り、余暇を取りやすくするのがねらいでした。
  </p>
  <p>
    ハッピーマンデーの祝日は必ず月曜日なので、日曜日と重なることがなく、振替休日が発生しません。一方で日付は年ごとに最大6日動きます。たとえば成人の日は1月8日から14日の範囲で移動するため、「毎年1月15日」のつもりで期限を数えると、営業日の計算がずれることがあります。「第2月曜日」は「その月の2回目の月曜日」であって「第2週の月曜日」ではない点にも注意してください。
  </p>

  <h2>春分の日・秋分の日は前年に確定する</h2>
  <p>
    春分の日と秋分の日は、祝日法に「春分日」「秋分日」とだけ書かれていて、具体的な日付はありません。太陽が春分点・秋分点を通過する日は天文学的に決まるもので、年によって1日前後します。正式な日付は、国立天文台が計算した「暦要項」として<strong>前年の2月に官報で公示</strong>されて初めて確定します。つまり、再来年以降の春分・秋分は「ほぼ確実な予測」ではあっても、法律上はまだ確定していない、という扱いです。
  </p>
  <p>
    太陽が春分点を通る時刻は毎年約6時間ずつ遅れ、うるう年で1日戻る、という動きを繰り返します。当面の間、春分の日は3月20日か21日、秋分の日は9月22日か23日のどちらかです。「春分の日は3月21日」と決め打ちしてカレンダーに書き込むと、年によっては1日ずれます。
  </p>

  <h2>振替休日のルール — 「翌月曜日」とは限らない</h2>
  <p>
    祝日が日曜日と重なった場合、<strong>その日より後の、祝日でない最も近い日</strong>が休日になります（祝日法第3条第2項）。これが振替休日です。多くの場合は翌月曜日ですが、ゴールデンウィークのように祝日が連続していると、月曜も火曜も祝日で埋まっていて振替が水曜日まで飛ぶことがあります。
  </p>
  <ol class="calc-steps">
    <li>日曜日に当たった祝日を見つける（土曜日は対象外）。</li>
    <li>その翌日（月曜日）が祝日でなければ、そこが振替休日。</li>
    <li>翌日も祝日なら、さらに次の日へ。祝日でない日に当たるまで繰り出す。</li>
  </ol>
  <p>
    具体例を挙げます。2026年は5月3日の憲法記念日が日曜日です。翌4日はみどりの日、5日はこどもの日でどちらも祝日なので、振替休日は<strong>5月6日（水曜日）</strong>になります。結果として5月2日（土）から6日（水）までの5連休です。一方、2027年は5月3日が月曜日なので振替休日はなく、5月1日（土）から5日（水）までの5連休になります。
  </p>

  <h2>祝日にはさまれた平日は「国民の休日」</h2>
  <p>
    前日と翌日の両方が祝日である平日は、自動的に休日になります（祝日法第3条第3項）。これが「国民の休日」です。もともとは1985年に、憲法記念日（5月3日）とこどもの日（5月5日）にはさまれた5月4日を休日にするために作られた規定でした。2007年に5月4日そのものがみどりの日になってからは、この規定が働く場面はほぼ1つに限られます。敬老の日（9月第3月曜日）と秋分の日が1日おきに並ぶ年です。
  </p>
  <p>
    たとえば2026年は、9月21日（月）が敬老の日、23日（水）が秋分の日で、間の22日（火）が国民の休日になります。土曜日から数えて9月19日から23日までの5連休、いわゆるシルバーウィークです。2015年にも同じ並びがありました。敬老の日は9月15日から21日の範囲でしか動かず、秋分の日は22日か23日なので、敬老の日が21日、秋分の日が23日にならない限りこの並びは成立しません。数年に一度しか現れないレアな休日です。
  </p>

  <h2>「祝日」と「休日」は別のもの</h2>
  <p>
    ここまで振替休日・国民の休日と書いてきたとおり、この2つは<strong>「祝日」ではなく「休日」</strong>です。祝日法は、祝日そのものを休日とする（第3条第1項）ほかに、振替休日と国民の休日を「休日」として追加している、という構造になっています。
  </p>
  <p>
    もうひとつ大切なのは、祝日法はあくまで国の休日を定めた法律であって、民間企業に休業を義務づけるものではないという点です。労働基準法が求める休日は週1日以上（または4週を通じて4日以上）で、祝日をどう扱うかは各社の就業規則次第です。小売業やサービス業では祝日が営業日であることも珍しくありません。
  </p>

  <h2>年によって連休の長さが変わる理由</h2>
  <p>
    同じ祝日でも、曜日の並びで連休の長さは大きく変わります。固定日の祝日の曜日は毎年1つ（間にうるう年の2月29日をはさむと2つ）後ろにずれていき、土曜日に当たった年は振替もなく「消える」ため、その年は祝日が実質1日少なくなります。逆に日曜日に当たれば振替休日で月曜日が休みになり、土日月の3連休です。たとえば2026年は、建国記念の日（2月11日）が水曜日で飛び石になる一方、勤労感謝の日（11月23日）は月曜日で3連休です。年ごとの並びは当サイトの<a href="/shukujitsu/">祝日カレンダー</a>の連休早見表で確認できます。
  </p>

  <h2>営業日計算への影響</h2>
  <p>
    振替休日も国民の休日も、営業日の計算では祝日と同じく休業日として扱うのが一般的です。当サイトの<a href="/eigyobi/">営業日計算</a>は、内閣府が公表する祝日データ（振替休日・国民の休日を含む）に基づいて計算しています。祝日は法改正で変わることがあるため、データは毎年更新しています。ただし、年末年始や会社独自の休暇は含まれていないので、取引先の営業日を数えるときは相手のカレンダーも合わせて確認してください。
  </p>
</ColumnLayout>
