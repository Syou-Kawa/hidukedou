---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import DayCountFigure from "../../components/DayCountFigure.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "「7日後」と「7日目」は<strong>1日ずれる</strong>",
  "法律の原則は<strong>初日不算入</strong>（翌日から数える。民法140条）",
  "ただしクーリングオフ・年齢・法要・記念日は<strong>初日算入</strong>の例外",
  "迷ったら「起点の日を1日目と数えるのか？」を最初に確認する",
];

const faqs = [
  {
    q: "「◯日以内」と書かれていたら、初日は含めますか？",
    a: "法律や契約の期間は、原則として初日を数えず翌日から起算します（初日不算入）。ただし「受領日を含め◯日以内」のように明記されていればそちらが優先されますし、クーリングオフのように法律側で初日を含めると決められているものもあります。案内文の記載を確認し、なければ相手先に数え方を確認してください。",
  },
  {
    q: "午前0時ちょうどから始まる期間はどうなりますか？",
    a: "民法140条ただし書きにより、期間が午前0時から始まるときは初日を数えます。たとえば「4月1日から10日間」と定めた場合は4月1日が1日目です。実務では「翌日から」と書いてある案内が多いので、まずは記載を確認してください。",
  },
  {
    q: "期限の日が土日祝だったら延びますか？",
    a: "期間の末日が日曜日・祝日などの休日で、その日に取引をしない慣習がある場合には翌日に満了します（民法142条）。ただしクーリングオフのように「書面を発信すればよい」期限は、休日でも延びません。制度ごとの扱いを確認するのが安全です。",
  },
];

const sources = [
  REFS.minpo,
  REFS.tokushoHo,
  REFS.nenreiHo,
];

const related = [
  { href: "/cooling-off/", label: "クーリングオフ期限の計算 — 受領日を1日目として期限日を表示" },
  { href: "/shijukunichi/", label: "四十九日・法要日の計算 — 命日を1日目として法要日を一覧" },
  { href: "/kinenbi/", label: "記念日カウンター — はじまりの日を1日目として◯日目を計算" },
  { href: "/eigyobi/", label: "営業日計算 — 当日を数えずに◯営業日後を計算" },
  { href: "/column/hayaumare/", label: "コラム: 4月1日生まれはなぜ早生まれ？「誕生日前日に年を取る」しくみ" },
];
---

<ColumnLayout
  title="「初日を含める・含めない」— 日数の数え方の基本"
  description="「7日後」と「7日目」はなぜ1日ずれる？初日算入・初日不算入という日数の数え方の基本を、民法の期間計算のルールと、クーリングオフ・四十九日・記念日など身近な例で解説します。"
  lead="日付の計算で間違いが起きる原因は、ほとんどの場合たったひとつ。「最初の日を数えるかどうか」です。この記事では、その考え方の基本と、場面ごとの使い分けを整理します。"
  published="2026-07-05"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>「7日後」と「7日目」は違う日</h2>
  <p>
    7月1日を基準に考えてみます。「7日<strong>後</strong>」は、翌日から1日・2日…と数えて7月8日です。一方「7日<strong>目</strong>」は、7月1日そのものを1日目と数えるので7月7日になります。
  </p>
  <DayCountFigure
    startLabel="7月1日"
    days={7}
    mode="both"
    caption="同じ「7」でも、起点の日を1日目と数えるかどうかで、行き着く日付が1日ずれる。上段が「7日目」（7月7日）、下段が「7日後」（7月8日）。"
  />
  <p>
    前者のように最初の日を数えない方式を<strong>初日不算入</strong>、後者のように数える方式を<strong>初日算入</strong>と呼びます。たった1日の差ですが、期限や法要の日取りではこの1日が決定的に効いてきます。契約の解除期限を1日過ぎてしまう、法要の案内状の日付が親族の認識とずれる、といったトラブルの多くは、この数え方の食い違いから生まれます。
  </p>

  <h2>原則は「初日不算入」— 民法140条</h2>
  <p>
    日本の法律では、日・週・月・年で期間を定めた場合、<strong>初日は数えず翌日から起算する</strong>のが原則です。これは民法第140条に定められており、民法だけでなく他の法律や契約の期間計算にも広く準用される、いわば日数計算の「共通ルール」です。「契約から30日以内」「通知を受けた日から2週間以内」のような期間は、特に断りがなければこの方式で数えます。
  </p>
  <p>
    なぜ初日を数えないのでしょうか。契約や通知は、たいてい1日のどこか途中の時刻に行われます。たとえば午後5時に受け取った通知について、その日を丸1日分として数えてしまうと、実際には7時間しかない日を「1日」とカウントすることになり、期間が短くなってしまいます。そこで、時刻の途中から始まる日は数えず、翌日の午前0時から丸1日ずつ数える、というのが初日不算入の考え方です。公平さのためのルールと言えます。
  </p>
  <p>
    この原則には例外もあります。期間が午前0時ちょうどから始まる場合（「4月1日から10日間」のように日付そのものを起点とする場合）は、その日は丸1日あるので初日から数えます（140条ただし書き）。また、期間の末日が日曜日・祝日その他の休日にあたり、その日に取引をしない慣習がある場合は、期間は翌日に満了します（142条）。なお、役所への申請期限が土日にかかると翌開庁日まで延びるのは、民法ではなく「行政機関の休日に関する法律」に同様の定めがあるためです。
  </p>

  <h2>初日を数える例外はたくさんある</h2>
  <p>
    一方で、暮らしの中には<strong>起点の日を1日目と数える</strong>ものが数多くあります。法律で明示的に決められているものと、慣習として定着しているものがあります。
  </p>
  <table class="milestones">
    <tr><th>場面</th><th>数え方</th><th>計算式</th></tr>
    <tr><td>クーリングオフ</td><td class="date-cell">初日算入</td><td>法定書面の受領日を1日目として8日間（20日間の取引も）。期限日＝受領日＋7日</td></tr>
    <tr><td>年齢</td><td class="date-cell">初日算入</td><td>出生日から起算。誕生日の前日が終わる瞬間に1歳加算</td></tr>
    <tr><td>四十九日などの法要</td><td class="date-cell">初日算入</td><td>命日を1日目として数える。四十九日＝命日＋48日</td></tr>
    <tr><td>生後◯日目の行事</td><td class="date-cell">初日算入</td><td>誕生日を1日目。お食い初め（100日目）＝誕生日＋99日</td></tr>
    <tr><td>記念日の「◯日目」</td><td class="date-cell">初日算入</td><td>はじまりの日を1日目。100日目＝開始日＋99日</td></tr>
    <tr><td>「◯日以内」の期限（原則）</td><td class="date-cell">初日不算入</td><td>翌日から数える。30日以内＝起点日＋30日が末日</td></tr>
    <tr><td>「◯営業日後」</td><td class="date-cell">当日不算入が一般的</td><td>翌営業日を1営業日目と数えることが多い（企業により異なる）</td></tr>
  </table>
  <p>
    クーリングオフは特定商取引法の条文で「書面を受領した日から起算して8日」と定められており、法律側が初日算入を明示している例です。年齢は「年齢計算ニ関スル法律」で出生日から起算すると決められています。法要や記念日は法律ではなく慣習ですが、いずれも「その日を1日目とする」のが一般的な理解です。
  </p>

  <h2>「◯日後」「◯日目」「◯日以内」を言葉で見分ける</h2>
  <p>
    日本語の表現には、数え方のヒントが含まれています。「<strong>◯日目</strong>」は序数（1番目・2番目…）なので、起点を1日目と数えるのが自然です。「<strong>◯日後</strong>」は経過した日数なので、起点当日は0日、翌日が1日後になります。「<strong>◯日以内</strong>」「<strong>◯日間</strong>」は期間の長さを表す表現で、法律の原則どおり初日不算入で数えることが多い一方、クーリングオフのように例外もあります。
  </p>
  <p>
    もう一つの見分け方は、案内文の書きぶりです。「受領日を含め8日以内」「本日を含めて」とあれば初日算入、「翌日から起算して」「到着日の翌日から」とあれば初日不算入です。この一言があるかないかで期限が1日変わるので、書面を受け取ったら最初にここを探す習慣をつけると安心です。
  </p>

  <h2>よくある間違いの例</h2>
  <ul>
    <li><strong>クーリングオフの期限を「受領日＋8日」と計算する</strong> — 正しくは受領日＋7日が8日目（期限日）。1日遅れると権利を失う可能性があります。</li>
    <li><strong>四十九日を「命日＋49日」と計算する</strong> — 正しくは命日＋48日。案内状の日付がお寺の認識と1日ずれる原因になります。</li>
    <li><strong>「付き合って100日」を開始日＋100日とする</strong> — 開始日＋100日は101日目。100日目は開始日＋99日です。</li>
    <li><strong>「3営業日後」に当日を含めて数える</strong> — 一般には翌営業日から数えるので、金曜の3営業日後は水曜（月・火・水）です。</li>
  </ul>

  <h2>迷ったときのチェックポイント</h2>
  <ol class="calc-steps">
    <li>案内文・契約書に「含め」「翌日から」などの記載がないか探す。あればそれに従う。</li>
    <li>記載がなければ、制度ごとの一般的な数え方（上の表）に当てはめる。</li>
    <li>期限に関わる重要な場面なら、相手先や窓口に「初日を含めるのか」を直接確認する。</li>
    <li>末日が土日祝にかかる場合、延びる制度（民法142条）か延びない制度（クーリングオフなど）かを確認する。</li>
  </ol>
  <p>
    当サイトの各ツールは、それぞれの場面の一般的な数え方（クーリングオフ・法要・記念日は初日算入、営業日は当日不算入など）をあらかじめ組み込み、<strong>どちらの数え方で計算したかを結果に明記</strong>しています。数え方に迷ったら、まずツールで目安を出し、上のチェックポイントで確認するという使い方がおすすめです。
  </p>
</ColumnLayout>
