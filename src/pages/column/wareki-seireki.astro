---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "変換は引き算で覚える：<strong>令和＝西暦−2018／平成＝西暦−1988／昭和＝西暦−1925</strong>",
  "2019年は<strong>4月30日までが平成31年、5月1日からが令和元年</strong>。「元年」は「1年」と書かず「元年」と書くのが正式",
  "改元の年は<strong>両方の元号が存在する</strong>。1989年は1月7日まで昭和64年、1月8日から平成元年",
  "履歴書は西暦・和暦どちらでもよいが、<strong>学歴・職歴・生年月日まで含めて全体で統一</strong>する",
];

const faqs = [
  {
    q: "平成31年と令和元年は同じ年ですか？",
    a: "同じ2019年です。4月30日までの日付は平成31年、5月1日以降の日付は令和元年と書きます。たとえば2019年3月の卒業は「平成31年3月」、2019年4月の入社は「平成31年4月」、2019年10月の転職は「令和元年10月」です。同じ年に2つの元号が混在するのは間違いではありません。",
  },
  {
    q: "「令和1年」と書いてはいけませんか？",
    a: "元号の最初の年は「元年」と書くのが正式な表記で、役所の書類や履歴書では「令和元年」を使うのが一般的です。ただしシステムの都合で「令和1年」「R1」と表示されることもあり、意味は同じなので読み替えて差し支えありません。自分で手書きする場面では「元年」を使うのが無難です。",
  },
  {
    q: "履歴書は西暦と和暦のどちらで書くべきですか？",
    a: "どちらでも構いません。応募先から指定があればそれに従い、指定がなければ書きやすいほうで統一します。外資系企業や海外向けの書類では西暦、官公庁向けの書類では和暦が使われる傾向がありますが、最も重要なのは1枚の書類の中で混在させないことです。",
  },
  {
    q: "昭和生まれの人の年齢を西暦から計算するには？",
    a: "まず昭和の年に1925を足して西暦の生まれ年に直し、今年の西暦から引きます。たとえば昭和55年生まれなら1980年生まれで、2026年には46歳（誕生日前なら45歳）です。和暦のまま計算しようとすると改元をまたぐ分がずれやすいので、いったん西暦に直すのが確実です。",
  },
];

const sources = [REFS.gengoHo];

const related = [
  { href: "/nyugaku/", label: "入学・卒業年の計算（学歴早見表） — 生年月日から西暦・和暦併記で一覧表示" },
  { href: "/column/hayaumare/", label: "コラム: 4月1日生まれはなぜ早生まれ？ — 学年の区切りのしくみ" },
  { href: "/column/uruudoshi/", label: "コラム: うるう年のしくみ" },
  { href: "/column/shukujitsu/", label: "コラム: 祝日のしくみ" },
];
---

<ColumnLayout
  title="令和・平成・昭和と西暦の変換 — 履歴書で間違えないための早見と覚え方"
  description="令和は西暦−2018、平成は−1988、昭和は−1925。すぐ使える変換の覚え方と、改元の年（平成31年＝令和元年）の書き方、履歴書で西暦・和暦を使うときの注意点をまとめました。"
  lead="履歴書や役所の書類で必ず出てくる和暦と西暦の変換。元号ごとの「引き算の数」を覚えてしまえば、その場で暗算できます。改元をまたぐ年の書き方も含めて整理します。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>変換式 — 「引き算の数」を覚える</h2>
  <table class="milestones">
    <tr><th>元号</th><th>期間</th><th>変換式</th></tr>
    <tr><td>令和</td><td>2019年5月1日〜</td><td class="date-cell">西暦 − 2018 ＝ 令和◯年</td></tr>
    <tr><td>平成</td><td>1989年1月8日〜2019年4月30日</td><td class="date-cell">西暦 − 1988 ＝ 平成◯年</td></tr>
    <tr><td>昭和</td><td>1926年12月25日〜1989年1月7日</td><td class="date-cell">西暦 − 1925 ＝ 昭和◯年</td></tr>
    <tr><td>大正</td><td>1912年7月30日〜1926年12月25日</td><td class="date-cell">西暦 − 1911 ＝ 大正◯年</td></tr>
    <tr><td>明治</td><td>1868年〜1912年7月30日</td><td class="date-cell">西暦 − 1867 ＝ 明治◯年</td></tr>
  </table>
  <p>
    たとえば2026年は、2026 − 2018 ＝ <strong>令和8年</strong>。平成9年生まれなら、9 ＋ 1988 ＝ <strong>1997年</strong>生まれです。覚え方としては、令和の「2018」は「令和はニーレイイチハチ」、平成の「1988」は「ハチハチ」、昭和の「1925」は「イチキューニーゴ」と、数字の並びで丸暗記してしまうのが早道です。
  </p>
  <p>
    「引き算の数」がなぜその値になるかというと、<strong>元年の西暦から1を引いた数</strong>だからです。令和元年は2019年なので2019 − 1 ＝ 2018、平成元年は1989年なので1988、昭和元年は1926年なので1925。「元年の前の年」を覚えておけば、式を忘れても導き出せます。
  </p>

  <h2>下2桁だけで暗算する方法</h2>
  <p>
    西暦の下2桁だけを使う方法もあります。<strong>昭和は下2桁から25を引く</strong>（1980年 → 80 − 25 ＝ 昭和55年）、<strong>令和は下2桁から18を引く</strong>（2026年 → 26 − 18 ＝ 令和8年）。平成は少し工夫が必要で、1900年代は下2桁から88を引き（1995年 → 95 − 88 ＝ 平成7年）、2000年代は<strong>下2桁に12を足します</strong>（2010年 → 10 ＋ 12 ＝ 平成22年）。「平成は12を足す」と覚えておくと、2000年代生まれの人の生年を扱うときに便利です。
  </p>
  <p>
    逆方向（和暦 → 西暦）は足し算です。昭和◯年 ＋ 25 が西暦の下2桁（昭和40年 → 65 → 1965年）、令和◯年 ＋ 18 が下2桁（令和5年 → 23 → 2023年）、平成◯年 − 12 が下2桁（平成20年 → 08 → 2008年、平成10年なら − 12 ＝ −2 → 98 → 1998年）。平成だけは1900年代と2000年代をまたぐので、結果がマイナスになったら100を足す、と考えてください。
  </p>

  <h2>早見表 — 主な年の対応</h2>
  <table class="milestones">
    <tr><th>西暦</th><th>和暦</th><th>備考</th></tr>
    <tr><td>1926年</td><td class="date-cell">大正15年／昭和元年</td><td>12月25日から昭和</td></tr>
    <tr><td>1964年</td><td class="date-cell">昭和39年</td><td>東京オリンピック</td></tr>
    <tr><td>1980年</td><td class="date-cell">昭和55年</td><td></td></tr>
    <tr><td>1989年</td><td class="date-cell">昭和64年／平成元年</td><td>1月8日から平成</td></tr>
    <tr><td>2000年</td><td class="date-cell">平成12年</td><td>「平成は＋12」の目印</td></tr>
    <tr><td>2010年</td><td class="date-cell">平成22年</td><td></td></tr>
    <tr><td>2019年</td><td class="date-cell">平成31年／令和元年</td><td>5月1日から令和</td></tr>
    <tr><td>2026年</td><td class="date-cell">令和8年</td><td></td></tr>
    <tr><td>2030年</td><td class="date-cell">令和12年</td><td></td></tr>
  </table>

  <h2>改元の年の書き方</h2>
  <p>
    注意が必要なのは改元をまたぐ年です。<strong>2019年は4月30日までが「平成31年」、5月1日からが「令和元年」</strong>で、同じ年に2つの元号が存在します。同様に<strong>1989年は1月7日までが「昭和64年」、1月8日からが「平成元年」</strong>です。書類に書くときは、その日付が改元の前か後かで元号を使い分けます。
  </p>
  <p>
    昭和64年はわずか7日間、昭和元年（1926年12月25日〜31日）も1週間しかありません。この期間に生まれた人は非常に少ないため、「昭和64年生まれ」と見ると入力ミスを疑われることがありますが、正しい表記です。逆に「平成元年1月5日」のような、その元号が始まる前の日付は存在しません。改元日より前の日付に新しい元号を当ててしまうのは、履歴書や届出書でよくある誤りです。
  </p>
  <p>
    また、元号の最初の年は「令和1年」ではなく<strong>「令和元年」</strong>と書くのが正式な表記です（読みは「がんねん」）。役所の書類でも履歴書でも、元年表記を使いましょう。
  </p>
  <p class="small">
    元号は元号法（1979年制定）に基づいて政令で定められ、皇位の継承があった場合に限って改められます（一世一元）。令和への改元は、この法律のもとで初めて、退位に伴ってあらかじめ改元日が公表された例です。
  </p>

  <h2>履歴書での使い方 — どちらでもよいが「統一」が絶対</h2>
  <p>
    履歴書の日付は、西暦・和暦の<strong>どちらを使っても構いません</strong>。ただし、生年月日・学歴・職歴・免許取得日・提出日まで、<strong>1枚の書類の中ですべて統一する</strong>のがマナーです。「生年月日は昭和、学歴は西暦」のような混在は読み手の負担になり、細部への注意が足りない印象を与えます。
  </p>
  <p>
    間違えやすいのが入学・卒業年の計算です。生まれ年から指折り数えると、<strong>早生まれ（1月1日〜4月1日生まれ）の1年のずれ</strong>や、浪人・留年・休学の加算を落としがちです。当サイトの学歴早見ツールなら、生年月日を入れるだけで西暦・和暦併記の一覧が出るので、書き写すだけで済みます。
  </p>
  <ol class="calc-steps">
    <li>提出先の指定（西暦か和暦か）を確認する。指定がなければ、職務経歴書など他の書類と同じ方式にそろえる。</li>
    <li>生年月日を基準にして、入学・卒業・入社・退社の年をいったんすべて西暦で並べる。</li>
    <li>和暦で書く場合は、並べた西暦を変換式で一括して和暦に直す。2019年の前後は月まで見て平成・令和を判定する。</li>
    <li>書き終えたら、元号の混在・「1年」表記・改元日前の日付に新元号を使っていないかを見直す。</li>
  </ol>

  <h2>ちょっと便利な豆知識</h2>
  <ul>
    <li><strong>昭和と平成の変換</strong> — 昭和◯年 − 63 ＝ 平成◯年（例：昭和60年 ＝ 1985年 ＝ 平成でいえば−3年…とやるより西暦経由が確実です）</li>
    <li><strong>免許証・マイナンバーカード</strong> — 運転免許証の有効期限は2019年ごろから西暦と和暦の併記になりました。公的書類でも西暦併記が進んでいます。</li>
    <li><strong>「S」「H」「R」</strong> — 書類の生年月日欄の記号は昭和(S)・平成(H)・令和(R)の頭文字です。明治(M)・大正(T)も同じ要領です。</li>
    <li><strong>明治45年・大正15年</strong> — 明治は45年7月30日に大正へ、大正は15年12月25日に昭和へ改元されました。古い戸籍や年表で「明治45年」「大正15年」を見かけたら、それぞれ1912年・1926年です。</li>
  </ul>
</ColumnLayout>
