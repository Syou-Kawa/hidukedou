---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";
import DayCountFigure from "../../components/DayCountFigure.astro";

const keyPoints = [
  "生後日数は<strong>誕生日を1日目</strong>として数える（お食い初めの100日目＝誕生日＋99日）",
  "母子手帳の「生後◯日」（日齢）は誕生日を0日と数えるので、行事の「◯日目」と<strong>1日ずれる</strong>",
  "行事の日付は目安。<strong>赤ちゃんと母親の体調・天候・家族の都合を優先</strong>してずらすのが現代の常識",
  "大安などの六曜は気にしなくてよい。混雑を避けたいならむしろ<strong>大安の週末を外す</strong>のも手",
];

const faqs = [
  {
    q: "お食い初めの100日目は、誕生日に100を足せばよいですか？",
    a: "誕生日に足すのは99日です。誕生日そのものを1日目と数えるので、100日目は誕生日＋99日になります。たとえば7月1日生まれなら10月8日です。＋100日にすると101日目になってしまうので、暗算せずにツールやカレンダーで確認するのが確実です。",
  },
  {
    q: "母子手帳の「生後30日」と、お宮参りの「31日目」は同じ日ですか？",
    a: "同じ日です。母子手帳や健診で使う日齢は誕生日を0日と数えるため、日齢30日は行事の数え方でいう31日目にあたります。どちらの数え方で書かれているかを確認すれば、1日のずれに戸惑わずに済みます。",
  },
  {
    q: "100日目ちょうどに行えないときは、前と後のどちらにずらすべきですか？",
    a: "決まりはありません。100日目を過ぎてから行う地域もあり、110日目・120日目に行う「食い延ばし」という風習もあるので、後ろにずらすことに問題はありません。家族が集まりやすい直近の週末や、写真スタジオの予約が取れる日を優先して決めてください。",
  },
  {
    q: "お宮参りとお食い初めを同じ日にやってもよいですか？",
    a: "問題ありません。生後1か月ごろの外出を避けて、お宮参りを100日ごろまで延ばし、同じ日にお食い初めと記念撮影をまとめる家庭は増えています。神社の祈祷、写真、食事の3つを1日に詰め込むと赤ちゃんの負担が大きいので、時間に余裕をもった計画にするのがおすすめです。",
  },
];

const sources = [REFS.boshiHokenHo];

const related = [
  { href: "/seigo/", label: "生後日数・お祝い日の計算 — 誕生日を入れるとお七夜〜初誕生まで一覧表示" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」— 日数の数え方の基本" },
  { href: "/column/rokuyo/", label: "コラム: 六曜とは？大安・仏滅・友引の意味と、気にしなくてよい場面" },
  { href: "/rokuyo/", label: "六曜カレンダー — どうしても気になるときの確認用に" },
  { href: "/kinenbi/", label: "記念日カウンター — 誕生日から100日目・1000日目を計算" },
];
---

<ColumnLayout
  title="お宮参り・お食い初めはいつ？生後日数の数え方と行事カレンダー"
  description="お七夜は生後7日目、お宮参りは生後1か月ごろ、お食い初め（百日祝い）は生後100日目。誕生日を1日目と数える生後日数の数え方と、赤ちゃんの行事の日程の考え方をまとめました。"
  lead="赤ちゃんの行事は「生後◯日目」で決まるものがほとんど。この「◯日目」は誕生日を1日目として数えます。行事ごとの日程と、日取りの現実的な決め方を整理します。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>生後日数の数え方 — 誕生日が「1日目」</h2>
  <p>
    伝統行事の「生後◯日目」は、<strong>生まれた日を1日目</strong>として数えます。したがって日付の計算では「誕生日＋（◯−1）日」です。たとえば7月1日生まれの赤ちゃんのお食い初め（100日目）は、7月1日＋99日＝10月8日になります。
  </p>
  <DayCountFigure
    startLabel="誕生日"
    days={7}
    mode="include"
    caption="誕生日を1日目と数えるので、お七夜の7日目は誕生日＋6日。同じ要領で、100日目＝誕生日＋99日になる。"
  />
  <p>
    なぜ誕生日を1日目と数えるのでしょうか。年齢の数え方に「数え年」があるように、日本の伝統的な数え方では、生まれた時点で「1」から始まります。生まれた日をすでに「この世で過ごした1日目」と考えるためで、四十九日などの法要で命日を1日目と数えるのと同じ発想です。法律上の期間計算（初日不算入）とは逆なので、契約の期限などに慣れている人ほど間違えやすいところです。
  </p>
  <p class="small">
    なお、母子手帳や健診で使う「生後◯日」（日齢）は誕生日を0日と数える方式で、行事の数え方と1日ずれます。母子保健法でも「出生後28日を経過しない乳児」を新生児と定義しており、行政や医療の場面はこの0日起点が基本です。混同しやすいので注意してください。
  </p>

  <h2>「日齢」と「◯日目」の対応</h2>
  <table class="milestones">
    <tr><th>日付</th><th>日齢（母子手帳）</th><th>行事の数え方</th></tr>
    <tr><td>誕生日当日</td><td class="date-cell">生後0日</td><td class="date-cell">1日目</td></tr>
    <tr><td>誕生日の翌日</td><td class="date-cell">生後1日</td><td class="date-cell">2日目</td></tr>
    <tr><td>誕生日＋6日</td><td class="date-cell">生後6日</td><td class="date-cell">7日目（お七夜）</td></tr>
    <tr><td>誕生日＋30日</td><td class="date-cell">生後30日</td><td class="date-cell">31日目（お宮参り）</td></tr>
    <tr><td>誕生日＋99日</td><td class="date-cell">生後99日</td><td class="date-cell">100日目（お食い初め）</td></tr>
  </table>
  <p>
    日齢は医療の場で使われる「生後何日経過したか」の数え方で、母子手帳やアプリの表示は日齢であることが多く、行事の「◯日目」より常に1小さい数になります。「アプリでは生後99日と出ているが、今日が100日目でいいのか」という迷いは、この表を見れば解決します。
  </p>

  <h2>赤ちゃんの行事カレンダー</h2>
  <table class="milestones">
    <tr><th>行事</th><th>時期</th><th>内容</th></tr>
    <tr><td>お七夜（命名式）</td><td class="date-cell">生後7日目</td><td>名前を披露し、命名書を飾る</td></tr>
    <tr><td>お宮参り</td><td class="date-cell">生後1か月ごろ</td><td>氏神様に誕生を報告。一般には男児31日目・女児32日目（地域や家により32〜33日目とする場合も）</td></tr>
    <tr><td>お食い初め（百日祝い）</td><td class="date-cell">生後100日目</td><td>「一生食べ物に困らないように」と祝い膳を食べさせる真似をする。110日目・120日目に行う地域も</td></tr>
    <tr><td>ハーフバースデー</td><td class="date-cell">生後6か月</td><td>近年定着した記念日。写真撮影が定番</td></tr>
    <tr><td>初節句</td><td class="date-cell">最初の3月3日／5月5日</td><td>生後まもない場合は翌年に回すことも多い</td></tr>
    <tr><td>初誕生（一升餅）</td><td class="date-cell">満1歳</td><td>一升餅を背負わせる・選び取りなど</td></tr>
  </table>

  <h2>それぞれの行事の由来</h2>
  <p>
    <strong>お七夜</strong>は、医療が未発達だった時代に生後7日を無事に迎えることが一つの節目とされ、この日に名前をつけて家族や地域に披露した習わしに由来します。命名書を飾るのはその名残で、現在は退院と重なる時期でもあるため、家族だけで簡単に済ませる家庭が多くなっています。
  </p>
  <p>
    <strong>お宮参り</strong>は、土地の守り神である氏神様に赤ちゃんの誕生を報告し、健やかな成長を祈る行事です。男児と女児で日にちが少し違うとされますが、その理由については諸説あり、日数そのものも地域によって異なります。「1か月前後」という目安として捉え、日数の違いにこだわる必要はありません。
  </p>
  <p>
    <strong>お食い初め</strong>は「一生食べ物に困らないように」と願い、赤ちゃんに祝い膳を食べさせる真似をする行事で、平安時代から続くとされます。やがて歯が生え始める時期に備えて、「丈夫な歯が生えるように」と願う意味も含まれています。祝い膳には歯固めの石を添えるのが一般的で、これは「石のように丈夫な歯が生えるように」という願いです。地域によっては110日目・120日目に行い、「食い延ばし」と呼んで長寿を願う風習もあります。
  </p>

  <h2>100日目の計算例</h2>
  <table class="milestones">
    <tr><th>誕生日（2026年）</th><th>7日目（お七夜）</th><th>31日目（お宮参り）</th><th>100日目（お食い初め）</th><th>120日目</th></tr>
    <tr><td>1月15日</td><td class="date-cell">1月21日</td><td class="date-cell">2月14日</td><td class="date-cell">4月24日</td><td class="date-cell">5月14日</td></tr>
    <tr><td>2月20日</td><td class="date-cell">2月26日</td><td class="date-cell">3月22日</td><td class="date-cell">5月30日</td><td class="date-cell">6月19日</td></tr>
    <tr><td>7月1日</td><td class="date-cell">7月7日</td><td class="date-cell">7月31日</td><td class="date-cell">10月8日</td><td class="date-cell">10月28日</td></tr>
    <tr><td>8月13日</td><td class="date-cell">8月19日</td><td class="date-cell">9月12日</td><td class="date-cell">11月20日</td><td class="date-cell">12月10日</td></tr>
    <tr><td>12月31日</td><td class="date-cell">1月6日</td><td class="date-cell">1月30日</td><td class="date-cell">翌年4月9日</td><td class="date-cell">翌年4月29日</td></tr>
  </table>
  <p>
    100日目は誕生日のおよそ3か月と1週間後にあたりますが、間に挟まる月の日数（31日・30日・28日）によって、同じ「100日目」でも月内の日付が数日動きます。2月をまたぐ場合はうるう年かどうかでも1日変わります。暗算で「3か月後の同じころ」と見当をつけるのは構いませんが、案内状や予約の日付を確定するときは、必ずカレンダーかツールで確認してください。
  </p>

  <h2>日付ぴったりでなくていい</h2>
  <p>
    これらの日程はあくまで伝統上の目安です。生後1か月前後の外出は赤ちゃんにも産後の母親にも負担が大きいため、現在は<strong>体調・天候・家族の集まりやすさを優先して前後にずらす</strong>のが一般的です。真夏や真冬のお宮参りを気候のよい時期まで延ばしたり、お宮参りとお食い初めをまとめて生後100日ごろに行ったりする家庭も増えています。
  </p>
  <p>
    六曜（大安・仏滅）も気にする必要はありません。神社の祈祷は仏滅の日でも普通に受けられます。むしろ大安の週末は写真スタジオや祈祷が混み合うので、混雑を避けたい場合は意識的に外すという選択もあります。
  </p>
  <p>
    ずらすときの考え方としては、「◯日目」の日付をまず計算し、その<strong>前後2〜3週間の中で条件のよい日を選ぶ</strong>のが現実的です。祖父母が遠方から来るなら連休、写真を重視するなら平日の午前中（スタジオが空いていて赤ちゃんの機嫌もよい時間帯）、というように、優先したい条件を1つ決めると日取りが決まりやすくなります。後ろ倒しのほうが赤ちゃんの首もすわって外出しやすく、遅れることを気にする必要はありません。
  </p>

  <h2>写真・祈祷の予約の実務</h2>
  <ol class="calc-steps">
    <li>誕生日から各行事の「◯日目」の日付を計算し、候補の週末を2〜3つ挙げる。</li>
    <li>お宮参りの祈祷は、神社によって予約制・当日受付のどちらもある。初穂料の目安、駐車場、授乳室の有無も合わせて確認する。</li>
    <li>写真スタジオは、七五三シーズン（9〜11月）や大安の週末は早めに埋まる。1か月前をめどに予約する。</li>
    <li>お食い初めの祝い膳は、料亭・仕出し・宅配セットなど。鯛の焼き物は前日までに注文が必要なことが多い。</li>
    <li>当日は赤ちゃんの授乳・昼寝の時間を軸に組み、祈祷→写真→食事のように移動が少ない順番にする。</li>
  </ol>
  <p>
    赤ちゃんの体調は直前まで読めないので、予約はキャンセル・変更の条件を確認したうえで入れておくと安心です。
  </p>

  <h2>数え間違いやすいポイント</h2>
  <ul>
    <li><strong>100日目＝誕生日＋99日</strong>。「＋100日」だと101日目になってしまいます。</li>
    <li>月をまたぐ計算は暗算で間違えやすい（31日の月・30日の月・2月が混ざるため）。ツールでの確認がおすすめです。</li>
    <li>「生後1か月」は暦の上の翌月同日（7月15日生まれなら8月15日）で考えるのが一般的です。1月31日生まれのように翌月に同じ日がない場合は、2月末日を「1か月」と考えます。</li>
    <li>母子手帳の日齢と行事の「◯日目」は1日ずれます。家族間で「今日で何日目か」の認識が食い違うときは、どちらの数え方で話しているかを確認しましょう。</li>
  </ul>
</ColumnLayout>
