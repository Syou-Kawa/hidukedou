---
import ColumnLayout from "../../layouts/ColumnLayout.astro";
import { REFS } from "../../lib/site.js";

const keyPoints = [
  "一粒万倍日・天赦日は「選日・暦注下段」と呼ばれる暦注で、<strong>六曜とは別系統</strong>",
  "一粒万倍日は<strong>二十四節気で区切った月＋日の十二支</strong>、天赦日は<strong>季節＋日の干支</strong>で決まる",
  "一粒万倍日は<strong>月に4〜6回</strong>、天赦日は<strong>年に5〜6回</strong>しかない",
  "どちらも機械的に決まる。科学的根拠はなく「験担ぎ」として楽しむもの",
];

const faqs = [
  {
    q: "一粒万倍日と大安はどちらを優先すればよいですか？",
    a: "決まった優先順位はありません。六曜と選日は別々の系統の暦注で、どちらが上という考え方自体が存在しないためです。一般的には天赦日が最上の吉日とされ、次いで一粒万倍日と大安が並び称されることが多いようですが、これも慣習上の話です。実際には、両方が重なる日を選ぶか、都合のよい方を選べば十分です。",
  },
  {
    q: "一粒万倍日に避けたほうがよいことはありますか？",
    a: "「万倍になる」という意味から、借金やローンの契約、人から物を借りることは「苦労も万倍になる」として避けるとされています。ただし、住宅ローンの契約日を一粒万倍日からずらさなければならないという実務上の理由はありません。あくまで気持ちの問題として、気になる場合だけ意識すれば十分です。",
  },
  {
    q: "一粒万倍日はカレンダーによって日が違うことがありますか？",
    a: "ほとんどの日は一致しますが、二十四節気の「節入り」の時刻が日付の境目に近い場合、節月の切り替わりを前後どちらの日にするかで判断が分かれ、その前後の数日だけ食い違うことがあります。六曜のような旧暦の計算ずれとは原因が異なりますが、どちらが正しいという性質のものではありません。",
  },
  {
    q: "不成就日と一粒万倍日が重なったらどうなりますか？",
    a: "「吉が打ち消される」とする解釈が多いようですが、統一されたルールはありません。不成就日は旧暦の月日で決まる凶日で、一粒万倍日は節月と十二支で決まる吉日なので、重なること自体は珍しくありません。気にするなら別の日を選び、気にしないなら予定を優先する、という程度の扱いで十分です。",
  },
];

const sources = [REFS.naoKoyomi];

const related = [
  { href: "/rokuyo/", label: "六曜カレンダー — 日付を選ぶと六曜がすぐわかります" },
  { href: "/column/rokuyo/", label: "コラム: 六曜とは？大安・仏滅・友引の意味" },
  { href: "/column/nyuseki/", label: "コラム: 入籍日はどう決める？ — 吉日の実際の使い方" },
  { href: "/kinenbi/", label: "記念日カウンター — 入籍日・開業日からの◯日目・◯周年を計算" },
];
---

<ColumnLayout
  title="一粒万倍日・天赦日とは？六曜との違いと、日の決まり方"
  description="一粒万倍日は月に4〜6回、天赦日は年に5〜6回。それぞれの意味と日の決まり方（二十四節気と干支）、六曜（大安・仏滅）との違い、吉日が重なる「最強日」や不成就日と重なったときの考え方をわかりやすく解説します。"
  lead="カレンダーで「大安」と並んでよく見かける「一粒万倍日」「天赦日」。六曜の仲間のように見えますが、実はまったく別の系統の暦注です。それぞれのしくみと決まり方、重なったときの考え方を整理します。"
  published="2026-07-15"
  updated="2026-09-06"
  keyPoints={keyPoints}
  faqs={faqs}
  sources={sources}
  related={related}
>
  <h2>一粒万倍日 — 始めたことが万倍に実る日</h2>
  <p>
    一粒万倍日（いちりゅうまんばいび）は、「一粒の籾（もみ）をまけば万倍に実って返ってくる」という意味の吉日です。<strong>何かを始めるのに向く日</strong>とされ、開業・開店、財布の新調・使い始め、宝くじの購入、入籍などに人気があります。
  </p>
  <p>
    一方で「万倍になる」のはよいことだけではない、という解釈から、<strong>借金やローンの契約、人から物を借りること</strong>は「苦労が万倍になる」として避ける習わしがあるとされています。
  </p>

  <h2>一粒万倍日の決まり方 — 節月と日の十二支</h2>
  <p>
    一粒万倍日は、暦の「節月（せつげつ）」ごとに定められた<strong>日の十二支</strong>で決まります。節月とは、旧暦の月ではなく、二十四節気のうち「節」にあたる立春・啓蟄・清明・立夏…で区切った月のことです。たとえば立春から啓蟄の前日までが正月（1月）、啓蟄から清明の前日までが2月、という具合です。そして日には甲子・乙丑…と60日周期で干支が割り当てられているため、各節月について「この十二支の日」と決めておけば、機械的に日が定まります。
  </p>
  <table class="milestones">
    <tr><th>節月</th><th>期間（おおよそ）</th><th>一粒万倍日となる日の十二支</th></tr>
    <tr><td>1月</td><td class="date-cell">立春〜啓蟄の前日</td><td>丑・午</td></tr>
    <tr><td>2月</td><td class="date-cell">啓蟄〜清明の前日</td><td>酉・寅</td></tr>
    <tr><td>3月</td><td class="date-cell">清明〜立夏の前日</td><td>子・卯</td></tr>
    <tr><td>4月</td><td class="date-cell">立夏〜芒種の前日</td><td>卯・辰</td></tr>
    <tr><td>5月</td><td class="date-cell">芒種〜小暑の前日</td><td>巳・午</td></tr>
    <tr><td>6月</td><td class="date-cell">小暑〜立秋の前日</td><td>酉・午</td></tr>
    <tr><td>7月</td><td class="date-cell">立秋〜白露の前日</td><td>子・未</td></tr>
    <tr><td>8月</td><td class="date-cell">白露〜寒露の前日</td><td>卯・申</td></tr>
    <tr><td>9月</td><td class="date-cell">寒露〜立冬の前日</td><td>酉・午</td></tr>
    <tr><td>10月</td><td class="date-cell">立冬〜大雪の前日</td><td>酉・戌</td></tr>
    <tr><td>11月</td><td class="date-cell">大雪〜小寒の前日</td><td>亥・子</td></tr>
    <tr><td>12月</td><td class="date-cell">小寒〜立春の前日</td><td>卯・子</td></tr>
  </table>
  <p>
    各節月に十二支が2つずつ割り当てられ、それぞれ12日に一度巡ってくるので、およそ30日の節月の中に<strong>4〜6回</strong>の一粒万倍日があります。吉日のなかでは「出会いやすい」日で、月に数回あるため、特定の予定に合わせやすいのが特徴です。なお、節月の境目は二十四節気の「節入り」で決まり、新暦の月の1日とは一致しません。「今月は丑と午の日」と思っていても、節入りをまたぐと対象の十二支が切り替わる点には注意が必要です。
  </p>

  <h2>天赦日 — 暦の上で最上の吉日</h2>
  <p>
    天赦日（てんしゃにち・てんしゃび）は「天がすべての罪を赦（ゆる）す日」とされ、<strong>暦注のなかで最上の吉日</strong>と位置づけられています。何を始めてもよい日とされ、結婚・開業・引っ越しなど大きな節目に選ばれます。
  </p>
  <p>
    決まり方は、季節と<strong>日の干支（十干＋十二支）</strong>の組み合わせです。季節は立春・立夏・立秋・立冬で区切ります。
  </p>
  <table class="milestones">
    <tr><th>季節</th><th>期間</th><th>天赦日となる日の干支</th></tr>
    <tr><td>春</td><td class="date-cell">立春〜立夏の前日</td><td>戊寅（つちのえとら）</td></tr>
    <tr><td>夏</td><td class="date-cell">立夏〜立秋の前日</td><td>甲午（きのえうま）</td></tr>
    <tr><td>秋</td><td class="date-cell">立秋〜立冬の前日</td><td>戊申（つちのえさる）</td></tr>
    <tr><td>冬</td><td class="date-cell">立冬〜立春の前日</td><td>甲子（きのえね）</td></tr>
  </table>
  <p>
    干支は60日で一巡するため、約90日の季節の中に該当する干支の日は1回か2回しかありません。年間では<strong>5〜6回</strong>程度で、希少さが「最上の吉日」といわれる理由のひとつです。一粒万倍日が十二支（12日周期）で決まるのに対し、天赦日は十干と十二支の組み合わせ（60日周期）で決まる、という周期の違いが回数の差を生んでいます。
  </p>

  <h2>六曜との関係 — 別系統なので普通に重なる</h2>
  <p>
    大安・仏滅などの<strong>六曜</strong>は、旧暦の月と日から決まる6日周期の暦注です。一粒万倍日・天赦日は二十四節気と干支に基づく別系統なので、同じ日に<strong>「大安×一粒万倍日」「天赦日×一粒万倍日」</strong>のような重なりが普通に起こります。こうした日は「最強開運日」などと呼ばれ、婚姻届の提出や財布の買い替えが集中します。
  </p>
  <table class="milestones">
    <tr><th>暦注</th><th>決まり方</th><th>周期・頻度</th><th>系統</th></tr>
    <tr><td>六曜（大安など）</td><td>旧暦の月＋日を6で割る</td><td>6日周期。大安は月に5回前後</td><td>旧暦ベース</td></tr>
    <tr><td>一粒万倍日</td><td>節月ごとの日の十二支</td><td>月に4〜6回</td><td>二十四節気＋十二支</td></tr>
    <tr><td>天赦日</td><td>季節ごとの日の干支</td><td>年に5〜6回</td><td>二十四節気＋六十干支</td></tr>
    <tr><td>不成就日</td><td>旧暦の月ごとに定められた日</td><td>8日周期</td><td>旧暦ベース</td></tr>
  </table>

  <h2>不成就日 — 吉日と重なりやすい凶日</h2>
  <p>
    一粒万倍日が仏滅や不成就日と重なることもあります。不成就日（ふじょうじゅび）は「何事も成就しない」とされる凶日で、旧暦の月ごとに決まった日（たとえば旧暦1月と7月は3日・11日・19日・27日）が8日おきに巡ってきます。旧暦ベースなので六曜と同じ系統で、一粒万倍日とは無関係に配置されるため、重なる日は年に何度もあります。
  </p>
  <p>
    重なったときの扱いは、「吉が半減する」「凶が勝つ」「不成就日は無視してよい」など解釈が流派によってさまざまで、統一されたルールはありません。もともと科学的根拠のない験担ぎですから、<strong>重なりの解釈に悩むより、自分の都合のよい日を選ぶ</strong>くらいの付き合い方が健全です。
  </p>

  <h2>場面別 — どの吉日を見ればよいか</h2>
  <ul>
    <li><strong>入籍・開業など「日付が残る」節目</strong> — 天赦日か一粒万倍日、できれば大安との重なりを候補にすると、後で説明しやすい日付になります。ただし役所の開庁日や式場の空き状況が優先です。</li>
    <li><strong>財布の新調・使い始め</strong> — 一粒万倍日が定番です。月に数回あるので、買った日ではなく「使い始める日」を合わせる人が多いようです。</li>
    <li><strong>ローン契約・借り入れ</strong> — 一粒万倍日は避けるとされる場面です。気になるなら別の日に。気にならなければ金利や手続きの都合を優先して問題ありません。</li>
    <li><strong>法要・弔事</strong> — 一粒万倍日・天赦日は関係しません。六曜も含め、参列者の都合を優先します。</li>
  </ul>

  <h2>暦注とのほどよい付き合い方</h2>
  <p>
    六曜も選日も、日付の吉凶に根拠があるわけではありません。ただ、「せっかくなら縁起のよい日に」という気持ちは行動のきっかけになりますし、記念日に物語を添えてくれます。予定に無理のない範囲で験担ぎとして楽しむ — それが暦注とのいちばんよい付き合い方です。二十四節気の日付は年によって1日前後するため、正確な節入りは国立天文台の暦要項などで確認できます。
  </p>
</ColumnLayout>
