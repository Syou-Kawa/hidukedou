---
import ToolLayout from "../layouts/ToolLayout.astro";
import { REFS } from "../lib/site.js";

const sources = [REFS.gakkoKyoikuHo, REFS.nenreiHo, REFS.gengoHo];

const faqs = [
  {
    q: "なぜ4月1日生まれは1学年上（早生まれ）になるのですか？",
    a: "法律上、年齢は誕生日の前日が終わる瞬間（前日の24時）に1つ加わります（年齢計算に関する法律）。4月1日生まれの人は3月31日に満6歳となるため、学校教育法の「満6歳に達した日の翌日以後における最初の学年」がその年の4月になり、4月2日生まれの人より1年早く入学します。学年の区切りが「4月1日生まれまで」と「4月2日生まれから」になるのはこのためです。",
  },
  {
    q: "早生まれとは何月何日生まれの人を指しますか？",
    a: "1月1日から4月1日までに生まれた人を指します。同じ年に生まれた4月2日以降の人より1学年上になる（＝早く入学する）ことから「早生まれ」と呼ばれます。本ツールは早生まれを自動判定して学年を計算します。",
  },
  {
    q: "履歴書の学歴は西暦と和暦のどちらで書くべきですか？",
    a: "どちらでも構いませんが、履歴書全体（生年月日・学歴・職歴・資格）で表記を統一するのがマナーです。西暦と和暦が混在しないよう注意してください。本ツールは両方を併記しているので、どちらの形式でもそのまま転記できます。",
  },
  {
    q: "浪人・留年・休学した場合はどう読み替えますか？",
    a: "本ツールの結果は浪人・留年なしでストレートに進学した場合の年です。浪人した場合は大学入学以降にその年数を、留年・休学した場合は該当校の卒業以降にその年数を足してください。",
  },
  {
    q: "大学院は履歴書にどう書きますか？「卒業」と「修了」の違いは？",
    a: "大学院は「卒業」ではなく<strong>「修了」</strong>と書きます（例:「◯◯大学大学院 ◯◯研究科 ◯◯専攻 修士課程 修了」）。修士課程（博士前期課程）は標準2年、博士課程（博士後期課程）は標準3年です。本ツールは大学卒業後にストレートで進学した場合の入学・修了年を表示しています。",
  },
  {
    q: "6年制の学部（医学部・歯学部・薬学部・獣医学部）の卒業年は？",
    a: "医・歯・薬（薬剤師養成課程）・獣医の各学部は6年制のため、卒業は4年制より2年遅い年になります。本ツールでは「大学（6年制）」の行にその年を表示しています。なお6年制学部の卒業者は修士課程を経ずに博士課程（4年制）へ進学できるなど、大学院の制度が一部異なります。",
  },
  {
    q: "幼稚園の入園年は何を基準にしていますか？",
    a: "3年保育（年少・年中・年長）の場合の入園年を表示しています。2年保育の場合は表示の1年後、保育園の場合は入園時期がさまざまなので、卒園年（小学校入学の直前の3月）だけを参考にしてください。",
  },
  {
    q: "2月29日（うるう年）生まれの学年はどうなりますか？",
    a: "2月29日生まれは早生まれ（1月1日〜4月1日）に含まれるので、同じ年の4月2日以降生まれの人より1学年上になります。年齢は法律上、毎年2月28日が終わる瞬間に1つ加わるため、誕生日がない年でも学年や入学時期に影響はありません。詳しくは<a href='/column/uruudoshi/'>うるう年のコラム</a>で解説しています。",
  },
];

const keyPoints = [
  "学年の区切りは<strong>4月2日生まれ〜翌年4月1日生まれ</strong>",
  "1月1日〜4月1日生まれ（早生まれ）は、同じ年生まれの人より<strong>1学年上</strong>",
  "履歴書では西暦・和暦の表記を<strong>書類全体で統一</strong>する",
];

const related = [
  { href: "/seigo/", label: "生後日数・お祝い日の計算 — 赤ちゃんの月齢とお祝い行事" },
  { href: "/kinenbi/", label: "記念日カウンター — 100日目・◯周年などの節目を計算" },
  { href: "/column/hayaumare/", label: "コラム: 4月1日生まれはなぜ早生まれ？学年の区切りのしくみ" },
  { href: "/column/wareki-seireki/", label: "コラム: 令和・平成・昭和と西暦の変換 — 履歴書で間違えないために" },
];
---

<ToolLayout
  title="入学・卒業年の計算（学歴早見表） — 生年月日から自動計算"
  description="生年月日を入力するだけで、小学校・中学校・高校・高専・大学・大学院の入学年・卒業年（修了年）を西暦・和暦で一覧表示。履歴書の学歴欄の記入に便利。早生まれ（4月1日生まれまで）も自動判定します。"
  h1="入学・卒業年の計算（学歴早見表）"
  lead="生年月日を入力すると、小学校から大学・大学院までの入学・卒業年（大学院は修了年）を西暦と和暦で一覧表示します。履歴書の学歴欄の記入にそのまま使えます。"
  keyPoints={keyPoints}
  faqs={faqs}
  related={related}
  published="2026-07-05"
  updated="2026-09-06"
  sources={sources}
>
  <div class="calc" slot="calc">
    <div class="row">
      <div>
        <label for="birth-date">生年月日</label>
        <input type="date" id="birth-date" />
      </div>
      <button type="button" class="btn" id="calc-btn">計算する</button>
    </div>
    <div id="result" aria-live="polite"></div>
  </div>

  <Fragment slot="explain">
    <h2>使い方</h2>
    <ol class="calc-steps">
      <li>「生年月日」を入力して「計算する」を押します。</li>
      <li>小学校の入学年月が大きく表示され、早生まれの判定と現在の学年が添えられます。</li>
      <li>下の表の入学・卒業（修了）年月を西暦・和暦のどちらかで履歴書に転記します。浪人・留年などがあれば該当の行以降に年数を足します。</li>
    </ol>

    <h2>学年の区切りは「4月2日生まれ〜翌年4月1日生まれ」</h2>
    <p>
      日本の学年は、<strong>4月2日生まれからその翌年の4月1日生まれまで</strong>が同じ学年になります。小学校には「満6歳になった日の後の、最初の4月」に入学するため、
    </p>
    <ul>
      <li><strong>4月2日〜12月31日生まれ</strong> — 生まれた年の <strong>7年後</strong>の4月に小学校入学</li>
      <li><strong>1月1日〜4月1日生まれ（早生まれ）</strong> — 生まれた年の <strong>6年後</strong>の4月に小学校入学</li>
    </ul>
    <p>
      となります。区切りが「3月31日」ではなく「4月1日」なのは、法律上、年齢が<strong>誕生日の前日</strong>に加わるためです（詳しくは下記のFAQ参照）。本ツールはこの区切りを自動判定するので、早生まれの方もそのまま入力するだけで正しい学年が計算できます。
    </p>

    <h2>早生まれの理屈 — 2つの法律の組み合わせ</h2>
    <p>
      学年の区切りは2つの法律から導けます。<strong>学校教育法第17条</strong>は、子が「満6歳に達した日の翌日以後における最初の学年の初め」（4月1日）から就学させる義務を定め、<strong>年齢計算ニ関スル法律</strong>は、年齢が誕生日の前日が終わる瞬間に1つ加わると定めています。
    </p>
    <p>
      4月1日生まれは満6歳に達するのが<strong>3月31日</strong>、その翌日は4月1日でちょうど学年の初めに当たるため「その4月」に入学します。4月2日生まれは満6歳に達するのが4月1日、翌日の4月2日は学年が始まった後なので「次の4月」まで待ちます。誕生日が1日違うだけで入学が1年ずれるのはこのためです。
    </p>

    <h2>計算例 — 4月1日生まれと4月2日生まれの比較</h2>
    <p>生まれた日が1日違うだけで、すべての入学・卒業年が1年ずれます。</p>
    <table class="milestones">
      <tr><th>学校</th><th>2000年4月1日生まれ（早生まれ）</th><th>2000年4月2日生まれ</th></tr>
      <tr class="is-main"><td>小学校 入学</td><td class="date-cell">2006年（平成18年）4月</td><td class="date-cell">2007年（平成19年）4月</td></tr>
      <tr><td>大学（4年制）入学</td><td class="date-cell">2018年（平成30年）4月</td><td class="date-cell">2019年（平成31年）4月</td></tr>
      <tr><td>大学（4年制）卒業</td><td class="date-cell">2022年（令和4年）3月</td><td class="date-cell">2023年（令和5年）3月</td></tr>
    </table>
    <p>
      2000年4月2日生まれの大学入学「2019年4月」は、和暦では<strong>平成31年4月</strong>です。令和は2019年5月1日からなので、この年の4月入学を「令和元年4月」と書くのは誤りです。本ツールは月単位で元号を判定しているので、表示のとおりに転記すれば問題ありません。
    </p>

    <h2>計算例 — 平成と令和の境目に生まれた場合</h2>
    <table class="milestones">
      <tr><th>生年月日</th><th>和暦</th><th>早生まれ</th><th>小学校 入学</th></tr>
      <tr><td>2019年4月1日</td><td class="date-cell">平成31年</td><td>早生まれ</td><td class="date-cell">2025年（令和7年）4月</td></tr>
      <tr><td>2019年4月30日</td><td class="date-cell">平成31年</td><td>—</td><td class="date-cell">2026年（令和8年）4月</td></tr>
      <tr><td>2019年5月1日</td><td class="date-cell">令和元年</td><td>—</td><td class="date-cell">2026年（令和8年）4月</td></tr>
    </table>
    <p>
      2019年4月30日生まれ（平成31年）と5月1日生まれ（令和元年）は、生年の元号が違っても<strong>同じ学年</strong>です。逆に、4月1日生まれと4月30日生まれは同じ平成31年生まれでも学年が1つ違います。学年を分けるのは「4月1日と4月2日の境」であって、元号の切り替わりではありません（<a href="/column/wareki-seireki/">令和・平成・昭和と西暦の変換のコラム</a>）。
    </p>

    <h2>履歴書の学歴欄での使い方</h2>
    <p>
      履歴書の学歴欄は「いつ・どの学校に入学／卒業したか」を年月で書きます。本ツールの結果は西暦と和暦を併記しているので、履歴書の表記に合わせてどちらでも転記できます。書き方のポイントは次のとおりです。
    </p>
    <ul>
      <li>学歴は一般に<strong>中学校卒業</strong>または<strong>高校入学</strong>から書き始めます。</li>
      <li>学校名は「高校」と略さず「◯◯高等学校」と正式名称で書きます。</li>
      <li>西暦・和暦は履歴書全体（生年月日・学歴・職歴・資格）で統一します。</li>
      <li>大学は学部・学科まで書き、「同上」「〃」で省略せず毎回学校名を書くのが一般的です。</li>
    </ul>
    <p>浪人・留年・中退がある場合の一般的な書き方は次のとおりです（応募先に指定の書式があればそちらに従ってください）。</p>
    <table class="milestones">
      <tr><th>状況</th><th>一般的な書き方</th><th>本ツールの結果の読み替え</th></tr>
      <tr><td>浪人</td><td>特に書かない。卒業と入学の間が空くだけ</td><td>大学入学以降の年に浪人年数を足す</td></tr>
      <tr><td>留年</td><td>特に書かない。在籍年数が長くなるだけ</td><td>該当校の卒業以降の年に留年年数を足す</td></tr>
      <tr><td>休学</td><td>卒業年は休学の年数分遅れる。理由を簡潔に添えることもある</td><td>該当校の卒業以降の年に休学年数を足す</td></tr>
      <tr><td>中退</td><td>「◯◯大学 ◯◯学部 中途退学」と書く（「中退」と略さない）</td><td>卒業年の代わりに退学した年月を書く</td></tr>
    </table>
    <p>
      数え間違いで多いのは、高校3年間を「2016年4月入学・2018年3月卒業」のように<strong>1年短く書いてしまう</strong>ケースです。正しくは2019年3月卒業で、卒業年と次の入学年は暦年では同じ年になります。本ツールの表を転記すれば、自分で足し引きする必要はありません。
    </p>

    <h2>こんなときはどうする？</h2>
    <ul>
      <li><strong>海外の学校に通っていた</strong>: 9月入学など本ツールの前提（4月・3月）と異なるので、実際の年月を書いてください。</li>
      <li><strong>和暦の「元年」</strong>: 元号の最初の年は「1年」ではなく<strong>「元年」</strong>と書きます（令和元年＝2019年）。本ツールもそのように表示しています。</li>
    </ul>

    <h2>計算の前提</h2>
    <ul>
      <li>入学は<strong>4月</strong>、卒業は<strong>3月</strong>としています（一般的な日本の学校の場合）。</li>
      <li>浪人・留年・休学のない<strong>ストレート進学</strong>の場合の年です。該当がある場合はその年数を足してください。</li>
      <li>大学は4年制のほか、<strong>6年制（医・歯・薬・獣医など）</strong>、短大・専門学校（2年制）、<strong>高専（5年制）</strong>の卒業年も表示します。</li>
      <li><strong>大学院</strong>は修士課程（2年）・博士課程（3年）を、大学（4年制）卒業後にストレートで進学した場合の年で表示します。履歴書では大学院は「卒業」ではなく<strong>「修了」</strong>と書きます。</li>
    </ul>
  </Fragment>
</ToolLayout>

<script>
  import { parseYmd, toYmd, toWareki, isHayaumare, schoolMilestones } from "../lib/dateCore.js";
  import { shareButtonHTML, bindShareButtons, getParam, setParams } from "../lib/ui.js";

  const $ = (id) => document.getElementById(id);
  const result = $("result");

  // 表のセル用: 「2007年4月」＋和暦の添え字
  function ymCell(year, month) {
    const w = toWareki(new Date(year, month - 1, 1));
    return `${year}年${month}月${w ? `<span class="sub">${w}</span>` : ""}`;
  }

  // 見出し用: 「2007年（平成19年）4月」
  function ymText(year, month) {
    const w = toWareki(new Date(year, month - 1, 1));
    return `${year}年${w ? `（${w}）` : ""}${month}月`;
  }

  // 今日が属する年度（4月始まり）
  function currentSchoolYear(today) {
    return today.getMonth() >= 3 ? today.getFullYear() : today.getFullYear() - 1;
  }

  // 現在の学年の説明文と、強調表示する行の key
  function currentStatus(entranceYear, today) {
    const n = currentSchoolYear(today) - entranceYear; // 小学校入学年度からの経過年数
    if (n < -3) return { text: "現在は未就学（幼稚園入園前）です。", key: null };
    if (n < 0) return { text: `現在は幼稚園の${["年少", "年中", "年長"][n + 3]}にあたる年度です。`, key: "kindergarten" };
    if (n < 6) return { text: `現在は小学${n + 1}年生の年度です。`, key: "elementary" };
    if (n < 9) return { text: `現在は中学${n - 5}年生の年度です。`, key: "junior" };
    if (n < 12) return { text: `現在は高校${n - 8}年生の年度です。`, key: "high" };
    if (n < 16) return { text: `現在は大学${n - 11}年生（4年制・現役の場合）の年度です。`, key: "university" };
    return { text: null, key: null };
  }

  function run() {
    const v = $("birth-date").value;
    if (!v) return;
    const birth = parseYmd(v);
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const rows = schoolMilestones(birth);
    const entranceYear = rows.find((r) => r.key === "elementary").enter;
    const status = currentStatus(entranceYear, today);
    const hayaumare = isHayaumare(birth);

    const tableRows = rows
      .map(
        (r) => `<tr${r.key === status.key ? ' class="is-main"' : ""}>
          <td>${r.label}</td>
          <td class="date-cell">${ymCell(r.enter, 4)}</td>
          <td class="date-cell">${ymCell(r.graduate, 3)}</td>
        </tr>`
      )
      .join("");

    result.innerHTML = `
      <div class="result-big">小学校入学は ${ymText(entranceYear, 4)}</div>
      <p class="result-caption">${hayaumare ? "早生まれ（1月1日〜4月1日生まれ）なので、同年生まれの4月2日以降の人より1学年上です。" : "4月2日以降の生まれなので、翌年以降の早生まれの人と同じ学年です。"}${status.text ? "<br>" + status.text : ""}</p>
      <table class="milestones">
        <thead><tr><th>学校</th><th>入学</th><th>卒業・修了</th></tr></thead>
        <tbody>${tableRows}</tbody>
      </table>
      <p class="result-note">浪人・留年なしのストレート進学の場合です。幼稚園は3年保育、入学は4月・卒業は3月として計算しています。大学院は大学（4年制）卒業後にストレートで進学した場合の年で、履歴書では「卒業」ではなく「修了」と書きます。</p>
      ${shareButtonHTML()}`;
    bindShareButtons(result);
    setParams({ d: toYmd(birth) });
  }

  $("calc-btn").addEventListener("click", run);
  const p = getParam("d");
  if (p) {
    $("birth-date").value = p;
    run();
  }
</script>
