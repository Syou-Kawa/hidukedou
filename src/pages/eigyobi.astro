---
import ToolLayout from "../layouts/ToolLayout.astro";
import { REFS } from "../lib/site.js";

const sources = [REFS.caoShukujitsu, REFS.ginkoHo, REFS.gyoseiKyujitsuHo];

const faqs = [
  {
    q: "「3営業日後」とはいつのことですか？",
    a: "一般的には、起算日の翌日から数えて3番目の営業日を指します。たとえば金曜日の3営業日後は、月・火・水と数えて水曜日です（当日の金曜日は数えません）。ただし企業によっては当日を1日目と数える場合もあるため、期限に関わるときは相手先に確認するのが確実です。",
  },
  {
    q: "土曜日は営業日に含まれますか？",
    a: "本ツールでは土曜・日曜・国民の祝日（振替休日・国民の休日を含む）を営業日から除いています。これは官公庁や銀行、多くの企業の一般的な扱いです。土曜営業の店舗・企業とやり取りする場合は、その会社のカレンダーに読み替えてください。",
  },
  {
    q: "銀行の営業日と同じですか？",
    a: "ほぼ同じです。銀行の窓口営業日も土日祝を除いた平日です。ただし12月31日〜1月3日は銀行休業日なので、年末年始をまたぐ振込などはその分の日数も見込んでください（本ツールは祝日法上の祝日のみを除外しています）。",
  },
  {
    q: "会社独自の休業日（夏季休暇・創立記念日など）は反映されますか？",
    a: "反映されません。本ツールは土日と国民の祝日のみを除外する一般的な営業日計算です。相手先の会社カレンダーに独自の休業日がある場合は、その日数を加味してください。",
  },
  {
    q: "お盆休みは営業日に含まれますか？",
    a: "お盆（8月13日〜16日頃）は国民の祝日ではないため、暦の上では営業日です。本ツールでも営業日として数えます。ただし山の日（8月11日）は祝日として除外されます。実際にはお盆期間を休業とする企業が多いので、8月中旬をまたぐ期日はゆとりを持って見積もってください。",
  },
  {
    q: "「翌営業日」と「1営業日後」は同じ意味ですか？",
    a: "基本的に同じで、起算日の次に来る営業日を指します。金曜日の翌営業日は月曜日（月曜が祝日なら火曜日）です。「即日・当日中」と言われた場合のみ、その日のうちという意味になります。",
  },
  {
    q: "役所の「開庁日」と営業日は同じですか？",
    a: "ほぼ同じですが、年末年始が違います。国の行政機関は法律で12月29日から1月3日までが休日と定められており、多くの自治体も同じ扱いです。銀行の休業（12月31日〜1月3日）より2日長いので、年末に役所へ提出する書類は特に余裕を見てください。",
  },
];

const keyPoints = [
  "営業日＝<strong>土日・祝日を除いた平日</strong>（振替休日・国民の休日も除く）",
  "「3営業日後」は当日を数えず、<strong>翌営業日を1日目</strong>として数えるのが一般的",
  "12月31日〜1月3日は（元日を除き）祝日ではないが<strong>銀行は休業</strong>。年末年始は要注意",
];

const related = [
  { href: "/shukujitsu/", label: "祝日カレンダー — 次の祝日はいつ？年間の祝日一覧・連休早見表" },
  { href: "/cooling-off/", label: "クーリングオフ期限計算 — 契約書面の受領日から期限日を計算" },
  { href: "/column/eigyobi-inai/", label: "コラム: 「3営業日以内」はいつまで？営業日の数え方と落とし穴" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」日数の数え方の基本" },
  { href: "/column/shukujitsu/", label: "コラム: 祝日はどうやって決まる？振替休日と国民の休日" },
];
---

<ToolLayout
  title="営業日計算 — ◯営業日後はいつ？土日祝を除いて自動計算"
  description="「3営業日後はいつ？」を土日・祝日（振替休日含む）を除いて自動計算。2つの日付の間の営業日数も数えられる無料ツール。営業日の数え方も丁寧に解説します。"
  h1="営業日計算"
  lead="土日と国民の祝日を除いた「◯営業日後・◯営業日前」の日付と、期間内の営業日数を計算します。"
  keyPoints={keyPoints}
  faqs={faqs}
  related={related}
  published="2026-07-05"
  updated="2026-09-06"
  sources={sources}
>
  <div class="calc" slot="calc">
    <div class="row radio-group" role="radiogroup" aria-label="計算モード">
      <label><input type="radio" name="mode" value="add" checked /> ◯営業日後・前を求める</label>
      <label><input type="radio" name="mode" value="count" /> 期間内の営業日数を数える</label>
    </div>

    <div id="pane-add">
      <div class="row">
        <div>
          <label for="base-date">起算日</label>
          <input type="date" id="base-date" />
        </div>
        <div>
          <label for="n-days">営業日数</label>
          <input type="number" id="n-days" value="3" min="1" max="365" style="width:5.5rem" />
        </div>
        <div>
          <label for="direction">方向</label>
          <select id="direction">
            <option value="1">営業日後</option>
            <option value="-1">営業日前</option>
          </select>
        </div>
        <button type="button" class="btn" id="calc-add">計算する</button>
      </div>
    </div>

    <div id="pane-count" hidden>
      <div class="row">
        <div>
          <label for="from-date">開始日</label>
          <input type="date" id="from-date" />
        </div>
        <div>
          <label for="to-date">終了日</label>
          <input type="date" id="to-date" />
        </div>
        <div>
          <label for="include-first">開始日の数え方</label>
          <select id="include-first">
            <option value="0">開始日を含めない</option>
            <option value="1">開始日を含める</option>
          </select>
        </div>
        <button type="button" class="btn" id="calc-count">計算する</button>
      </div>
    </div>

    <div id="result" aria-live="polite"></div>
  </div>

  <Fragment slot="explain">
    <h2>使い方</h2>
    <ol class="calc-steps">
      <li>計算モードを選びます。「◯営業日後はいつ？」を知りたいときは<strong>「◯営業日後・前を求める」</strong>、「この期間に営業日は何日あるか」を数えたいときは<strong>「期間内の営業日数を数える」</strong>です。</li>
      <li>起算日（依頼した日・書類が届いた日など）と営業日数、方向（後／前）を入力します。「◯営業日前」は、締切から逆算して着手日を決めるときに使います。</li>
      <li>「計算する」を押すと結果が表示されます。起算日の当日は数えず、翌営業日を1日目としています。当日を1日目と数える相手先の場合は、営業日数を1つ減らして入力してください。</li>
      <li>営業日数を数えるモードでは「開始日を含める／含めない」を切り替えられます。「◯日から◯日まで何営業日あるか」を数えるなら「含める」、「◯日から数えて何営業日後か」なら「含めない」が対応します。</li>
    </ol>
    <h2>営業日の数え方</h2>
    <p>
      営業日とは、会社や役所が業務を行っている日のことで、一般には<strong>土曜・日曜・国民の祝日を除いた平日</strong>を指します。本ツールもこの一般的な定義で計算しています（祝日には振替休日・国民の休日を含みます）。
    </p>
    <p>
      注意したいのは<strong>当日を数えるかどうか</strong>です。ビジネスの慣行では「3営業日後」「3営業日以内」というとき、依頼した当日は数えず、<strong>翌営業日を1日目</strong>として数えるのが一般的です。金曜日に「3営業日後にお送りします」と言われたら、月曜（1）・火曜（2）・水曜（3）で水曜日が目安になります。
    </p>
    <p>
      ただしこれはあくまで慣行で、法律で統一されているわけではありません。締切や支払期限など重要な日付は、相手先がどちらの数え方をしているか確認するのが確実です。
    </p>
    <h2>早見表 — 3営業日後はいつ？（祝日がない週の場合）</h2>
    <table class="milestones">
      <tr><th>起算日</th><th>3営業日後</th><th>数え方</th></tr>
      <tr><td>月曜日</td><td class="date-cell">木曜日</td><td>火・水・木</td></tr>
      <tr><td>火曜日</td><td class="date-cell">金曜日</td><td>水・木・金</td></tr>
      <tr><td>水曜日</td><td class="date-cell">翌週月曜日</td><td>木・金・(土日を飛ばして)月</td></tr>
      <tr><td>木曜日</td><td class="date-cell">翌週火曜日</td><td>金・月・火</td></tr>
      <tr><td>金曜日</td><td class="date-cell">翌週水曜日</td><td>月・火・水</td></tr>
    </table>
    <p class="small">週の後半に依頼すると土日を挟むため、暦の上では5日かかることになります。間に祝日があればさらに1日ずつ後ろへずれます。</p>
    <h2>計算例 — 実際の日付で確認する</h2>
    <p>2026年の暦で、祝日や連休を挟む場合を含めて確認してみましょう。いずれも「当日は数えず、翌営業日を1日目」とする本ツールの数え方です。</p>
    <table class="milestones">
      <tr><th>起算日</th><th>求めたい日</th><th>数え方</th><th>結果</th></tr>
      <tr><td>2026年7月10日（金）</td><td>3営業日後</td><td>13日（月）・14日（火）・15日（水）</td><td class="date-cell">7月15日（水）</td></tr>
      <tr><td>2026年7月16日（木）</td><td>3営業日後</td><td>17日（金）・<span class="sub">20日（月）は海の日で除外</span>・21日（火）・22日（水）</td><td class="date-cell">7月22日（水）</td></tr>
      <tr><td>2026年9月18日（金）</td><td>3営業日後</td><td>21日（月）敬老の日・22日（火）国民の休日・23日（水）秋分の日を除外。24日（木）・25日（金）・28日（月）</td><td class="date-cell">9月28日（月）</td></tr>
      <tr><td>2026年4月28日（火）</td><td>5営業日後</td><td>29日は昭和の日、5月3〜6日は連休。30日・5月1日・7日・8日・11日</td><td class="date-cell">5月11日（月）</td></tr>
      <tr><td>2026年12月28日（月）</td><td>3営業日後</td><td>29日（火）・30日（水）・31日（木）。祝日ではないので暦上は営業日</td><td class="date-cell">12月31日（木）<span class="sub">※銀行・役所は休業</span></td></tr>
    </table>
    <p>
      9月の例では、金曜日の「3営業日後」が10日先の月曜日になっています。2026年9月は敬老の日と秋分の日に挟まれた22日が「国民の休日」となるため、19日（土）から23日（水）まで5連休になるからです。連休の前後に依頼をするときは、暦の日数と営業日数の差が大きく開くことを意識しておくと安心です。
    </p>
    <p>
      最後の年末の例は、祝日法だけで判断すると12月31日が営業日になりますが、銀行や役所は休みです。次の節で説明するように、<strong>相手が誰か</strong>によって「営業日」の範囲が変わる典型例です。
    </p>
    <h2>銀行・役所・一般企業で「営業日」はどう違う？</h2>
    <p>
      「土日祝が休み」という点は共通ですが、年末年始の扱いは根拠が異なります。
    </p>
    <table class="milestones">
      <tr><th>区分</th><th>休みの日</th><th>根拠・備考</th></tr>
      <tr><td>本ツール（一般的な営業日）</td><td class="date-cell">土日・国民の祝日</td><td>内閣府が公表する「国民の祝日」に基づく。振替休日・国民の休日を含む</td></tr>
      <tr><td>銀行の窓口</td><td class="date-cell">土日・祝日＋<strong>12月31日〜1月3日</strong></td><td>銀行法第15条と同法施行令で定められた休日。12月29日・30日は営業日</td></tr>
      <tr><td>国の行政機関（役所）</td><td class="date-cell">土日・祝日＋<strong>12月29日〜1月3日</strong></td><td>行政機関の休日に関する法律。多くの地方自治体も条例で同じ扱い</td></tr>
      <tr><td>一般企業</td><td class="date-cell">会社カレンダーによる</td><td>年末年始・お盆・創立記念日などの独自休業日がある。土曜営業の企業も</td></tr>
    </table>
    <p>
      たとえば2026年12月28日（月）を起算日にすると、「3営業日後」は本ツールでは12月31日ですが、銀行なら1月4日（月）、役所なら1月6日（水）になります。同じ「3営業日」でも1週間近く差が出るわけです。年末年始の振込・納付・申請は、相手先がどのカレンダーで動いているかを先に確認してください。
    </p>
    <h2>営業日計算が必要になる主な場面</h2>
    <ul>
      <li><strong>銀行振込</strong> — 他行宛の振込やシステム処理の関係で「◯営業日後の入金」と案内されることがあります。</li>
      <li><strong>通販・物流</strong> — 「3営業日以内に発送」という表記は、土日祝を除いて数えます。</li>
      <li><strong>証券・投資信託</strong> — 株式の受渡日（約定日から2営業日後）や投資信託の解約代金の支払日は営業日基準です。</li>
      <li><strong>行政手続き・入札</strong> — 書類の提出期限や公告期間が営業日（開庁日）で定められることがあります。</li>
    </ul>
    <h2>大型連休をまたぐときの注意</h2>
    <p>
      ゴールデンウィーク（4月末〜5月上旬）や年末年始は、営業日が飛び飛びになり、体感より大幅に日数がかかります。たとえば祝日の並びによっては「5営業日後」が暦の上で10日以上先になることもあります。
    </p>
    <p>
      また、<strong>12月31日〜1月3日は祝日ではありませんが銀行は休業</strong>です（銀行法施行令による）。年末年始の振込・支払いは、祝日計算だけでは足りない点に注意してください。
    </p>
    <h2>こんなときはどうする？ — 場面別の判断</h2>
    <ul>
      <li><strong>「3営業日以内にご連絡します」と言われた</strong> — 一般的には翌営業日を1日目として3日目まで、つまり金曜日に言われたら翌週水曜日までが目安です。ただし当日を1日目に数える会社もあるため、水曜日を過ぎても連絡がなければ問い合わせるくらいの受け止め方でよいでしょう。</li>
      <li><strong>金曜日の15時以降に振込をした</strong> — 銀行の営業日の区切りは日付だけでなく<strong>時刻</strong>にも左右されます。他行宛の振込は当日扱いの受付時刻を過ぎると翌営業日扱いになることがあり、その場合は月曜日の処理になります。営業日計算と受付時刻の両方を確認してください。</li>
      <li><strong>提出期限が「◯月◯日（必着）」で、その日が土曜日</strong> — 必着の期限は営業日ではなく暦日で書かれているのが普通です。相手が土曜日に受け取れない場合、実質的には前日の金曜日が最終日になります。営業日計算で「1営業日前」を求めると確認できます。</li>
      <li><strong>お盆の時期に発送を待っている</strong> — 8月13〜16日頃は祝日ではないため、暦の上では営業日として数えられます。しかし休業する企業が多く、案内された営業日数どおりに届かないことがあります。8月11日（山の日）の前後は特に余裕を持ってください。</li>
      <li><strong>期限から逆算して着手日を決めたい</strong> — 方向を「営業日前」にして計算します。たとえば10営業日の作業を月末納期に間に合わせたいなら、納期を起算日に「10営業日前」を求めると、遅くとも着手すべき日が分かります。</li>
      <li><strong>2028年以降の日付を計算したい</strong> — 本ツールの祝日データは2025〜2027年分のため、それより先は祝日を除外できません。結果に注記が表示された場合は、土日のみ除外した参考値としてお使いください。</li>
    </ul>
    <h2>なぜ「当日を数えない」のか</h2>
    <p>
      民法では期間を日単位で定めたとき、原則として初日を算入しません（初日不算入の原則）。これは、起算日が一日の途中から始まることが多く、その日を丸1日として数えると期間が実質的に短くなってしまうためです。ビジネスの「◯営業日後」も、この考え方と同じで、依頼を受けた日は作業時間が丸一日ないものとして翌営業日から数えるのが自然だからと考えられます。ただし営業日の数え方を直接定めた法律はなく、あくまで慣行です。契約書や約款に「当日を含む」などの記載があればそちらが優先します。詳しくは<a href="/column/eigyobi-inai/">コラム「3営業日以内はいつまで？」</a>と<a href="/column/shonichi/">コラム「初日を含める・含めない」</a>をご覧ください。
    </p>
    <h2>祝日データについて</h2>
    <p>
      本ツールは内閣府が公表している「国民の祝日」の情報（2025年〜2027年分）に基づいて計算しています。それより先の日付では祝日を考慮できないため、結果に注記を表示します。祝日の仕組み（振替休日・国民の休日）について詳しくは<a href="/column/shukujitsu/">コラム「祝日はどうやって決まる？」</a>をご覧ください。
    </p>
  </Fragment>
</ToolLayout>

<script>
  import { parseYmd, addBusinessDays, countBusinessDays, formatJa, toYmd, inHolidayRange } from "../lib/dateCore.js";
  import { himekuriHTML, shareButtonHTML, bindShareButtons, getParam, setParams, todayYmd } from "../lib/ui.js";

  const $ = (id) => document.getElementById(id);
  const result = $("result");

  // モード切替
  const panes = { add: $("pane-add"), count: $("pane-count") };
  document.querySelectorAll('input[name="mode"]').forEach((r) =>
    r.addEventListener("change", () => {
      const mode = document.querySelector('input[name="mode"]:checked').value;
      panes.add.hidden = mode !== "add";
      panes.count.hidden = mode !== "count";
      result.innerHTML = "";
    })
  );

  function rangeNote(...dates) {
    return dates.every((d) => inHolidayRange(d))
      ? ""
      : `<p class="result-note">※ 祝日データの範囲（2025〜2027年）外の日付を含むため、範囲外の祝日は考慮されていません。</p>`;
  }

  function runAdd() {
    const base = parseYmd($("base-date").value);
    const n = Number($("n-days").value) * Number($("direction").value);
    if (!$("base-date").value || !Number.isFinite(n) || n === 0) return;
    const dest = addBusinessDays(base, n);
    result.innerHTML = `
      <p class="result-caption">${formatJa(base)} の ${Math.abs(n)}営業日${n > 0 ? "後" : "前"}は</p>
      ${himekuriHTML(dest)}
      ${shareButtonHTML()}
      ${rangeNote(base, dest)}
      <p class="result-note">起算日の当日は数えず、翌営業日を1日目としています。</p>`;
    bindShareButtons(result);
    setParams({ mode: "add", d: toYmd(base), n: $("n-days").value, dir: $("direction").value });
  }

  function runCount() {
    if (!$("from-date").value || !$("to-date").value) return;
    const from = parseYmd($("from-date").value);
    const to = parseYmd($("to-date").value);
    if (to < from) {
      result.innerHTML = `<p class="result-note">終了日は開始日以降の日付を選んでください。</p>`;
      return;
    }
    const inc = $("include-first").value === "1";
    const days = countBusinessDays(from, to, inc);
    result.innerHTML = `
      <div class="result-big">${days}営業日</div>
      <p class="result-caption">${formatJa(from)} 〜 ${formatJa(to)}（開始日を${inc ? "含める" : "含めない"}）</p>
      ${shareButtonHTML()}
      ${rangeNote(from, to)}`;
    bindShareButtons(result);
    setParams({ mode: "count", from: toYmd(from), to: toYmd(to), inc: inc ? "1" : "0" });
  }

  $("calc-add").addEventListener("click", runAdd);
  $("calc-count").addEventListener("click", runCount);

  // 初期値: 今日（URLパラメータがあれば復元して自動計算）
  $("base-date").value = getParam("d") || todayYmd();
  $("from-date").value = getParam("from") || todayYmd();
  $("to-date").value = getParam("to") || todayYmd();
  if (getParam("mode") === "count") {
    document.querySelector('input[name="mode"][value="count"]').checked = true;
    panes.add.hidden = true;
    panes.count.hidden = false;
    if ($("include-first")) $("include-first").value = getParam("inc") === "1" ? "1" : "0";
    if (getParam("from") && getParam("to")) runCount();
  } else {
    if (getParam("n")) $("n-days").value = getParam("n");
    if (getParam("dir")) $("direction").value = getParam("dir");
    if (getParam("d")) runAdd();
  }
</script>
