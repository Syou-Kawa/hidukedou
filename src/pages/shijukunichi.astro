---
import ToolLayout from "../layouts/ToolLayout.astro";
import DayCountFigure from "../components/DayCountFigure.astro";

const sources = [];

const faqs = [
  {
    q: "四十九日はいつですか？数え方を教えてください。",
    a: "亡くなった日（命日）を1日目として数えて49日目が四十九日です。日付の計算では「命日に48日を足した日」になります。たとえば7月1日が命日なら、四十九日は8月18日です。",
  },
  {
    q: "四十九日が平日の場合はどうすればよいですか？",
    a: "参列者が集まりやすいよう、四十九日当日より前の土曜日や日曜日に繰り上げて法要を営むのが一般的です。法要は当日より遅らせない（繰り下げない）のがならわしとされています。本ツールでは繰り上げ候補となる直前の土日も表示します。",
  },
  {
    q: "関西では数え方が違うと聞きました。",
    a: "関西の一部地域には、亡くなった前日から数える（逮夜＝たいやを基準にする）風習があり、その場合は法要の日取りが1日早くなります。地域やお寺のならわしによって異なるため、菩提寺や葬儀社に確認するのが確実です。",
  },
  {
    q: "友引や仏滅など六曜は気にしたほうがよいですか？",
    a: "六曜はもともと仏教とは関係がなく、法要の日取りで六曜を避ける必要はないとされるのが一般的です。「友引に葬儀を避ける」風習は火葬場の休業日と重なることが多いため残っていますが、四十九日などの法要には当てはまりません。",
  },
  {
    q: "一周忌や三回忌はいつですか？",
    a: "一周忌は亡くなった翌年の祥月命日（同じ月日）、三回忌は満2年目の祥月命日です。回忌は「数え」で数えるため、三回忌＝2年後、七回忌＝6年後のように、回忌の数から1を引いた年数後になります。",
  },
  {
    q: "納骨は四十九日にするものですか？",
    a: "決まりはありませんが、四十九日法要に合わせて納骨する家庭が多いです。お墓の準備が間に合わない場合は、百箇日や一周忌、お彼岸などに行っても問題ありません。納骨には埋葬許可証が必要なので、当日までに手元にあるか確認しておきましょう。",
  },
  {
    q: "香典返しはいつ送りますか？",
    a: "伝統的には忌明け（四十九日）後の1か月以内を目安に、挨拶状を添えて送ります。最近は通夜・葬儀の当日にお返しする「当日返し」も増えていますが、高額の香典をいただいた方には忌明け後に改めて差額分をお返しするのが丁寧とされています。",
  },
  {
    q: "四十九日が三月（みつき）にまたがるとよくないと聞きました。",
    a: "「四十九日が3か月にわたる（始終苦が身につく）」として避ける地域や家庭がありますが、語呂合わせに由来する俗信で、仏教の教義上の根拠はないとされています。気になる場合は五七日（三十五日）で忌明けとする方法もあります。月の後半が命日だと必ず3か月にまたがるため、あまり気にしすぎないのが一般的です。",
  },
];

const keyPoints = [
  "四十九日は<strong>命日を1日目</strong>として数えて49日目（日付の計算では命日＋48日）",
  "当日が平日なら<strong>直前の土日に繰り上げる</strong>のが一般的（後ろには延ばさない）",
  "友引・仏滅などの六曜は、法要の日取りでは気にしなくてよい",
];

const related = [
  { href: "/column/meinichi/", label: "コラム: 祥月命日と月命日の違い — 回忌の数え方" },
  { href: "/column/kodengaeshi/", label: "コラム: 香典返しはいつ送る？忌明けの数え方と当日返し" },
  { href: "/column/rokuyo/", label: "コラム: 六曜とは？法要の日取りと六曜の関係" },
  { href: "/column/shonichi/", label: "コラム: 「初日を含める・含めない」日数の数え方の基本" },
  { href: "/eigyobi/", label: "営業日計算 — 諸手続きの期日確認に" },
];
---

<ToolLayout
  title="四十九日はいつ？計算ツール — 命日から法要の日程を自動計算"
  description="命日を入力するだけで、初七日・四十九日・百箇日・一周忌・三回忌などの法要日を一覧表示。四十九日が平日の場合の繰り上げ候補（直前の土日）も表示します。数え方の解説つき。"
  h1="四十九日・法要日の計算"
  lead="命日（亡くなった日）を入力すると、初七日から三十三回忌までの法要の日付を一覧で計算します。"
  keyPoints={keyPoints}
  faqs={faqs}
  related={related}
  published="2026-07-05"
  updated="2026-09-06"
  sources={sources}
>
  <div class="calc" slot="calc">
    <div class="row">
      <div>
        <label for="death-date">命日（亡くなった日）</label>
        <input type="date" id="death-date" />
      </div>
      <button type="button" class="btn" id="calc-btn">計算する</button>
    </div>
    <div id="result" aria-live="polite"></div>
  </div>

  <Fragment slot="explain">
    <h2>使い方</h2>
    <ol class="calc-steps">
      <li><strong>命日（亡くなった日）</strong>を入力します。死亡診断書や死亡届に記載された死亡日です。深夜に亡くなった場合は、日付が変わる前か後かで命日が1日変わるので、書類の日付で確認してください。</li>
      <li>「計算する」を押すと、四十九日（忌明け）の日付が大きく表示され、その下に初七日から三十三回忌までの一覧が並びます。</li>
      <li>四十九日が平日の場合は、繰り上げ候補となる<strong>直前の土曜日・日曜日</strong>が表示されます。この日付を目安に、菩提寺や会場の空きを確認します。</li>
      <li>共有ボタンで結果の URL をコピーし、親族と日程を相談するときに送ることができます。</li>
    </ol>
    <h2>四十九日の数え方</h2>
    <p>
      四十九日（しじゅうくにち）は、<strong>命日を1日目として数えて49日目</strong>に営む法要です。仏教では、故人は七日ごとに閻魔大王らの審判を受け、49日目に来世の行き先が定まるとされ、この日をもって忌明け（きあけ）となります。「満中陰（まんちゅういん）」とも呼ばれます。
    </p>
    <p>
      命日を1日目と数えるため、日付の計算上は「命日＋48日」となります。「49日を足す」と1日ずれてしまうので注意してください。初七日（7日目）も同様に「命日＋6日」です。
    </p>
    <DayCountFigure
      startLabel="命日"
      days={7}
      mode="include"
      highlight={7}
      caption="法要の日数は命日を1日目として数えます。7日目の初七日は「命日＋6日」、49日目の四十九日は「命日＋48日」です。"
    />
    <h2>実際の日取りの決め方</h2>
    <p>
      四十九日当日が平日の場合は、参列者が集まりやすい<strong>直前の土日に繰り上げる</strong>のが一般的です。忌明け前に済ませる意味から、当日より後に延ばすことは避けるならわしです。本ツールの結果にも繰り上げ候補の土日を表示しています。
    </p>
    <p>
      なお、地域の風習（関西の一部の逮夜基準など）やお寺の考え方で日取りが変わることがあります。最終的な日程は菩提寺・僧侶・葬儀社と相談して決めてください。
    </p>
    <h2>計算例 — 命日から四十九日を求める</h2>
    <table class="milestones">
      <tr><th>命日</th><th>四十九日（命日＋48日）</th></tr>
      <tr><td>1月10日</td><td class="date-cell">2月27日</td></tr>
      <tr><td>3月1日</td><td class="date-cell">4月18日</td></tr>
      <tr><td>7月1日</td><td class="date-cell">8月18日</td></tr>
      <tr><td>12月15日</td><td class="date-cell">翌年2月1日</td></tr>
    </table>
    <p class="small">月末近くが命日の場合や年をまたぐ場合は暗算で間違えやすいので、本ツールでの確認をおすすめします。</p>
    <p>曜日まで含めて、2026年の暦で日取りを決める流れを見てみましょう。</p>
    <table class="milestones">
      <tr><th>命日</th><th>初七日（7日目）</th><th>四十九日（49日目）</th><th>日取りの考え方</th></tr>
      <tr><td>2026年7月8日（水）</td><td class="date-cell">7月14日（火）</td><td class="date-cell">8月25日（火）</td><td>平日なので、直前の8月22日（土）・23日（日）に繰り上げるのが一般的</td></tr>
      <tr><td>2026年1月31日（土）</td><td class="date-cell">2月6日（金）</td><td class="date-cell">3月20日（金・春分の日）</td><td>祝日なので当日でも集まりやすい。お彼岸の中日と重なるためお寺が多忙な点に注意</td></tr>
      <tr><td>2026年11月20日（金）</td><td class="date-cell">11月26日（木）</td><td class="date-cell">2027年1月7日（木）</td><td>年をまたぐ。繰り上げると1月2日（土）・3日（日）で正月三が日に重なるため、さらに前の12月26日（土）・27日（日）を検討</td></tr>
    </table>
    <p>
      3つ目の例のように、繰り上げた土日が正月やお盆、お寺の行事と重なることがあります。その場合はもう1週前の週末に繰り上げるか、平日でも当日に営むかを、菩提寺と相談して決めます。年末年始は僧侶の予定も埋まりやすいので、早めの連絡が必要です。
    </p>
    <h2>七日ごとの法要にはそれぞれ名前があります</h2>
    <p>四十九日までの間、七日ごとの節目にはそれぞれ呼び名があります。</p>
    <table class="milestones">
      <tr><th>法要</th><th>読み</th><th>日数</th></tr>
      <tr><td>初七日</td><td>しょなのか</td><td class="date-cell">7日目</td></tr>
      <tr><td>二七日</td><td>ふたなのか</td><td class="date-cell">14日目</td></tr>
      <tr><td>三七日</td><td>みなのか</td><td class="date-cell">21日目</td></tr>
      <tr><td>四七日</td><td>よなのか</td><td class="date-cell">28日目</td></tr>
      <tr><td>五七日</td><td>いつなのか<span class="sub">三十五日とも</span></td><td class="date-cell">35日目</td></tr>
      <tr><td>六七日</td><td>むなのか</td><td class="date-cell">42日目</td></tr>
      <tr class="is-main"><td>七七日（四十九日）</td><td>なななのか</td><td class="date-cell">49日目</td></tr>
    </table>
    <p>
      現在は<strong>初七日を葬儀当日に繰り上げて営む</strong>（式中初七日・繰り上げ初七日）ことが多く、二七日から六七日は省略または自宅での供養にとどめる家庭が増えています。地域や宗派により、五七日（三十五日）を忌明けとする場合もあります。
    </p>
    <h2>繰り上げの考え方 — 前倒しはよく、後ろ倒しは避けるとされる理由</h2>
    <p>
      四十九日を当日より前に営むことを「繰り上げ」といいます。仏教の考え方では、故人は七日ごとの審判を経て四十九日目に行き先が定まるとされるため、<strong>忌明けの日より前に供養を済ませておく</strong>ことに意味があると考えられてきました。反対に、当日より後に延ばすと「故人を待たせる」ことになるとして避けるのが一般的なならわしです。
    </p>
    <p>
      ただし、これは教義上の厳格な決まりというより慣習であり、僧侶の都合や遠方の親族の事情でやむを得ず後ろ倒しになるケースもあります。その場合でも「四十九日当日は家族で手を合わせ、法要は翌週末に営む」という形にすれば失礼には当たらないとする考え方が一般的です。日程よりも、きちんと供養の場を設けることが大切とされています。
    </p>
    <h2>四十九日法要の一般的な流れ</h2>
    <p>
      当日の流れは会場や宗派によって異なりますが、おおむね次のように進みます。所要時間は法要が30分〜1時間、会食を含めると2〜3時間程度が目安です。
    </p>
    <ol class="calc-steps">
      <li><strong>施主の挨拶・読経</strong> — 参列者が着席したら施主が短く挨拶し、僧侶の読経が始まります。</li>
      <li><strong>焼香</strong> — 施主、遺族、親族、一般の参列者の順に焼香します。</li>
      <li><strong>法話</strong> — 僧侶から四十九日の意味や故人を偲ぶ話があります。</li>
      <li><strong>納骨・お墓参り</strong> — 納骨を同日に行う場合は、法要のあと墓地へ移動して納骨式を営みます。</li>
      <li><strong>お斎（おとき）</strong> — 会食の席で僧侶や参列者をもてなします。僧侶が辞退される場合は「御膳料」を包むのが一般的です。</li>
      <li><strong>引き出物の手渡し・閉会</strong> — 参列者へのお礼として引き出物を渡し、施主の挨拶で終わります。</li>
    </ol>
    <h2>宗派・地域による違い</h2>
    <p>
      「四十九日で忌明け」という枠組みは多くの宗派で共通しますが、細かな考え方には違いがあります。たとえば浄土真宗では、亡くなるとすぐに仏になる（往生即成仏）と考えるため、四十九日は故人の行き先を祈る場ではなく、遺族が仏の教えに触れる場と位置づけられます。神式では仏式の四十九日に当たるものとして「五十日祭」を営み、キリスト教では死後一定の日に記念のミサ・記念式を行うなど、宗教が変わると数え方そのものが変わります。
    </p>
    <p>
      地域差では、FAQ でも触れた関西の一部の逮夜（前日）基準のほか、五七日（三十五日）を忌明けとする地域、四十九日が3か月にまたがるのを避けて三十五日に繰り上げる家庭などがあります。菩提寺がある場合はお寺のならわしが最優先で、無い場合は葬儀社に地域の慣例を尋ねると確実です。
    </p>
    <h2>案内状・準備のスケジュール</h2>
    <p>
      四十九日は葬儀から7週間しかなく、準備の期間は思いのほか短いものです。命日から逆算すると、おおむね次のような段取りになります。
    </p>
    <table class="milestones">
      <tr><th>時期の目安</th><th>やること</th></tr>
      <tr><td>葬儀直後〜1週間</td><td>菩提寺に連絡して法要の日取りを相談。会場（自宅・寺院・斎場）を決める</td></tr>
      <tr><td>法要の3〜4週間前</td><td>案内状を発送（往復はがきや電話でも可）。会食の店と引き出物の手配。本位牌の注文</td></tr>
      <tr><td>法要の2週間前</td><td>出欠を締め切り、会食の人数と引き出物の数を確定。納骨する場合は石材店に連絡し、埋葬許可証を確認</td></tr>
      <tr><td>法要の前日〜当日</td><td>お布施・御車代・御膳料を用意。位牌・遺影・供物・数珠を確認</td></tr>
    </table>
    <p>
      案内状は「法要の日時・場所・会食の有無・返信期限」を書き、返信期限は法要の2週間前程度に設定するのが一般的です。近親者だけで営む場合は電話連絡で済ませる家庭も多くなっています。
    </p>
    <h2>こんなときはどうする？</h2>
    <ul>
      <li><strong>命日が月末で、四十九日が3か月にまたがる</strong> — 「みつき（三月）」を避ける俗信がありますが、根拠は語呂合わせです。気になる場合は三十五日で忌明けとする選択肢もあります。</li>
      <li><strong>四十九日がお盆やお彼岸と重なる</strong> — お寺が最も忙しい時期のため、希望の日に僧侶の都合がつかないことがあります。1か月以上前に相談し、必要なら前の週末に繰り上げます。</li>
      <li><strong>遠方の親族が当日に来られない</strong> — 前の土日に繰り上げるのが一般的です。それでも難しい場合は近親者だけで営み、あとで親族が改めてお参りする形でも問題ないとされています。</li>
      <li><strong>納骨まで間に合わない</strong> — 四十九日に納骨する決まりはありません。百箇日や一周忌、お彼岸に改めて納骨式を営めます。</li>
    </ul>
    <h2>忌明けまでに・忌明け後にやること</h2>
    <ul>
      <li><strong>本位牌の準備</strong> — 葬儀で使った白木の位牌は仮のものです。四十九日法要で本位牌に魂を移すため、法要の1〜2週間前までに仏具店などで用意します（文字入れに日数がかかります）。</li>
      <li><strong>納骨</strong> — 四十九日法要と同じ日に行うことが多いですが、決まりはありません。お墓や納骨堂の準備が整ってからで構いません。</li>
      <li><strong>香典返し</strong> — 忌明け後1か月以内を目安に、挨拶状を添えて送るのが伝統的な形です。</li>
      <li><strong>神棚封じの解除</strong> — 神棚のある家では、忌明けをもって神棚に貼った白紙を外します。</li>
    </ul>
  </Fragment>
</ToolLayout>

<script>
  import { parseYmd, toYmd, formatJa, memorialServices, addDays } from "../lib/dateCore.js";
  import { himekuriHTML, milestoneTableHTML, shareButtonHTML, bindShareButtons, getParam, setParams } from "../lib/ui.js";

  const $ = (id) => document.getElementById(id);
  const result = $("result");

  function run() {
    const v = $("death-date").value;
    if (!v) return;
    const death = parseYmd(v);
    const items = memorialServices(death).map((it) => ({
      ...it,
      main: it.label.includes("四十九日"),
    }));
    const shijukunichi = items.find((it) => it.main).date;

    // 平日なら直前の土日を繰り上げ候補として表示
    let kuriage = "";
    const w = shijukunichi.getDay();
    if (w >= 1 && w <= 5) {
      const sun = addDays(shijukunichi, -w);
      const sat = addDays(sun, -1);
      kuriage = `<p class="result-note">四十九日当日は平日です。繰り上げて営む場合の直前の週末は ${formatJa(sat)}・${formatJa(sun)} です。</p>`;
    }

    result.innerHTML = `
      <p class="result-caption">四十九日（忌明け）は</p>
      ${himekuriHTML(shijukunichi)}
      ${kuriage}
      ${milestoneTableHTML(items, { firstColLabel: "法要" })}
      ${shareButtonHTML()}
      <p class="result-note">命日を1日目として計算しています。地域・宗派のならわしにより日取りが異なる場合があります。</p>`;
    bindShareButtons(result);
    setParams({ d: toYmd(death) });
  }

  $("calc-btn").addEventListener("click", run);
  const p = getParam("d");
  if (p) {
    $("death-date").value = p;
    run();
  }
</script>
