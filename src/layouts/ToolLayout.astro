---
import Base from "./Base.astro";
import ArticleMeta from "../components/ArticleMeta.astro";
import Sources from "../components/Sources.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { SITE } from "../lib/site.js";

// props:
//   title / description : メタ用
//   h1 / lead           : 見出しとリード文
//   keyPoints           : [string(HTML可)] … 冒頭の要点ボックス
//   faqs                : [{ q, a }]  … FAQ表示とFAQPage構造化データの両方に使う
//   related             : [{ href, label }]
//   published / updated : YYYY-MM-DD … 執筆者・日付の表示に使う
//   sources             : [{ label, href, note? }] … 参考資料・出典
const {
  title,
  description,
  h1,
  lead,
  keyPoints = [],
  faqs = [],
  related = [],
  published,
  updated,
  sources = [],
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const absLinks = (html) => (Astro.site ? html.replace(/href='\//g, `href='${Astro.site.origin}/`).replace(/href="\//g, `href="${Astro.site.origin}/`) : html);
const appJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  headline: title,
  description,
  url: canonical,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  inLanguage: "ja",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
  ...(published ? { datePublished: published } : {}),
  ...(updated ? { dateModified: updated } : {}),
  author: { "@type": "Person", name: SITE.author.name, url: Astro.site ? new URL(SITE.author.url, Astro.site).href : SITE.author.url },
  publisher: { "@type": "Organization", name: SITE.name },
});
const faqJsonLd =
  faqs.length > 0
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: absLinks(f.a) },
        })),
      })
    : null;
---

<Base title={title} description={description}>
  <Breadcrumb items={[{ name: h1 }]} />
  <article>
    <h1>{h1}</h1>
    <p class="lead">{lead}</p>
    <ArticleMeta published={published} updated={updated} />

    <slot name="calc" />

    {
      keyPoints.length > 0 && (
        <aside class="key-points">
          <span class="key-points-title">このページの要点</span>
          <ul>
            {keyPoints.map((k) => (
              <li set:html={k} />
            ))}
          </ul>
        </aside>
      )
    }

    <div class="explain">
      <slot name="explain" />
    </div>

    {
      faqs.length > 0 && (
        <section class="faq">
          <h2>よくある質問</h2>
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class="faq-a" set:html={f.a} />
            </details>
          ))}
        </section>
      )
    }

    <Sources sources={sources} />

    {
      related.length > 0 && (
        <nav class="related">
          <h2>関連ツール</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={r.href}>{r.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>

  <script type="application/ld+json" is:inline set:html={appJsonLd} />
  {faqJsonLd && <script type="application/ld+json" is:inline set:html={faqJsonLd} />}
</Base>
