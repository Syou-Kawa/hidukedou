---
// 参考資料・出典の一覧
// props: sources = [{ label, href, note? }]
const { sources = [], title = "参考資料・出典" } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="sources">
      <h2>{title}</h2>
      <ul>
        {sources.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
            {s.note && <span class="sources-note"> — {s.note}</span>}
          </li>
        ))}
      </ul>
      <p class="small">外部サイトの内容は各運営元の責任で提供されています。記載内容は公開日時点のものです。</p>
    </section>
  )
}
